  "group": "groups/hearth",
  "subtitle": [
    "The Ember Forge runs on Create: a mixer for Ashen Alloy, a press for Duskforged, a fan for Deepsteel, a burner for Sunforged, crafters for the Eclipse Core."
  ],
  "quests": [
    {
      "id": "h_clockwork/alloy",
      "title": "&aAshen Engineers",
      "subtitle": "Someone before the Eclipse built machines. Some of you remember how.",
