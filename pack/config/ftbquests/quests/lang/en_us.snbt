	task.1965F71091DA9D40.title: "I read an armament's tooltip (Shift)"
	task.19B100501ADA2CD7.title: "Absorb a Remnant Shard"
	task.1A2E609DFDB5E92F.title: "Any twinblade"
	task.1A53B65F5D2EE310.title: "Crimson Forest"
	task.1B9E8A3076F51053.title: "Speak to a villager"
	task.1BAA320D310FD87C.title: "Enter a desert temple"
	task.1C2793E01D4475BD.title: "Find the Void Blossom's cavern"
	task.1C51083296E09327.title: "Find a Lighthouse"
	task.1C8A39121A973D1F.title: "Find the dragon's skeleton"
	task.1D34485F6645BDC2.title: "I'll take Ilse's contracts"
	task.1D6064E3DD59FD07.title: "I'll read it when I need it"
	task.1D6D0EC93B9D58E4.title: "Buy a Crab Pot from a resident fisherman"
	task.1D9A19EDFF3A0E45.title: "I pulled a downed sellsword back to its feet"
	task.1E8FEED4461BF05C.title: "Enter the Gravebound Catacombs"
