	reward_table.5B001607D42FDE8B.title: "Treasures of the Deep"
	reward_table.5C03E4FB677AD684.title: "Calder's Satchel"
	reward_table.5D24E616E4A4D7E1.title: "The Garden Basket"
	reward_table.5EC6B87F6DA360CE.title: "Rift Salvage"
	reward_table.5F0615B2B5FBC38A.title: "The Quartermaster's Shelf"
	reward_table.656B4EB5E7614323.title: "Archive Cache"
	reward_table.68BF3E5EF6F9206A.title: "Ashborn Provisions"
