{
	chapter.00706B057024A893.chapter_subtitle: ["The Ashlands, the Wither, the Last Shore. Levels 50–70."]
	chapter.00706B057024A893.title: "&6Act IV: &fAsh and Crown"
	chapter.046A4DB1253C4718.chapter_subtitle: ["Light the first shrine. Call the first Sovereign. Levels 5–15."]
	chapter.046A4DB1253C4718.title: "&6Act I: &fEmbers"
	chapter.1614F74ADAA06D65.chapter_subtitle: ["Sellswords who survived by staying together. Gold up front."]
	chapter.1614F74ADAA06D65.title: "&eThe Ashen Company"
	chapter.19459C781145AE41.chapter_subtitle: ["Prisons, crypts, temples and forts. Somebody built them to keep things in."]
	chapter.19459C781145AE41.title: "&bThe Dungeon Trail"
	chapter.1F66B030D96EB9E2.chapter_subtitle: ["The Ashborn still has to eat. Last Light feeds itself."]
	chapter.1F66B030D96EB9E2.title: "&aHearth & Harvest"
	chapter.254E1D32E51CD0D3.chapter_subtitle: [
		"&7Optional.&r Some Ashborn remember gears. Light automation for Last Light, with Create."
	]
	chapter.254E1D32E51CD0D3.title: "&aThe Clockwork Path"
	chapter.25BC9FF73CA087DA.chapter_subtitle: ["Steel, stones, and what the Sovereigns leave behind."]
	chapter.25BC9FF73CA087DA.title: "&eThe Armory"
	chapter.3416798044C87559.chapter_subtitle: [
		"Every crowned and nameless thing under the Eclipse, and the level it expects you to be."
	]
	chapter.3416798044C87559.title: "&bBoss Compendium"
	chapter.3CFC5F2EB26BB279.chapter_subtitle: ["The red moon rises. The Remnants hunt you back. Levels 15–30."]
	chapter.3CFC5F2EB26BB279.title: "&6Act II: &fThe Hunt"
	chapter.42655E5D516196A5.chapter_subtitle: ["Under the black sun sits a crown with nothing inside. Level 70+."]
	chapter.42655E5D516196A5.title: "&6Act V: &fThe Eclipsed Realm"
	chapter.46A368D9176A5934.chapter_subtitle: ["A shrine makes a place you come back to. The rest makes it home."]
	chapter.46A368D9176A5934.title: "&aLast Light"
	chapter.4941E899663944DE.chapter_subtitle: ["Everything the dark will try, written in the margins. Press I."]
	chapter.4941E899663944DE.title: "&eThe Ashen Codex"
	chapter.4F942AE65198D849.chapter_subtitle: ["The sun remembers you. The End doesn't."]
	chapter.4F942AE65198D849.title: "&6Epilogue: &fFirst Light"
	chapter.50B167D1406FDCEA.chapter_subtitle: ["You rose from ash with nothing. Start there."]
	chapter.50B167D1406FDCEA.title: "&6Prologue: &fAshborn"
	chapter.5A0DEE3E083BE9EF.chapter_subtitle: ["Ilse the Huntmaster pays for proof. The board never empties."]
	chapter.5A0DEE3E083BE9EF.title: "&cAshen Contracts"
	chapter.618C9EA6E37794F6.chapter_subtitle: ["The world went dark. It didn't go away. Go and see what's left of it."]
	chapter.618C9EA6E37794F6.title: "&bWayfarer"
	chapter.660332D9BC141A99.chapter_subtitle: ["The Huntmaster's ledger: ranks, traits, and every kind of thing that bites."]
	chapter.660332D9BC141A99.title: "&bBestiary"
	chapter.672B340B4A3198A6.chapter_subtitle: ["Every ruin has a before. Someone has been collecting them."]
	chapter.672B340B4A3198A6.title: "&eThe Fractured Archive"
	chapter.68E793F75D53746F.chapter_subtitle: ["When the sun broke, its light had to land somewhere. Press P."]
	chapter.68E793F75D53746F.title: "&eThe Remnant Constellation"
	chapter.698ED4652531778D.chapter_subtitle: ["Drowned skies, buried cities, the Old Powers. Levels 30–50."]
	chapter.698ED4652531778D.title: "&6Act III: &fThe Deep"
	chapter_group.479956DAC7B14367.title: "&cAshen Contracts"
	chapter_group.736A8EEBE4B075CD.title: "&bThe World Under Ash"
	chapter_group.7641D8544E1E75E6.title: "&ePaths of the Ashborn"
	chapter_group.764F9A359750532B.title: "&6The Long Eclipse"
	chapter_group.7E3F2D0C845CD671.title: "&aHearth & Harvest"
	file.0000000000000001.title: "&6Remnants &7| &fThe Long Eclipse"
	quest.0057E9078F823C01.quest_desc: [
		"The sky went cold. The ground didn't. In &6Yellowstone&r the earth still steams and bubbles, as if it remembers noon."
		""
		"Warm your hands. Mind the vents."
	]
	quest.0057E9078F823C01.quest_subtitle: "Terralith. Yellowstone."
	quest.0057E9078F823C01.title: "The Warm Ground"
	quest.012027CCDC4F3D86.quest_desc: [
		"&o\"Not the Coven. The Coven pays its debts. These are the ones it threw out.\"&r"
		""
		"Kill &c5 witches&r. They drink their own potions mid-fight; hit them while the bottle's still raised."
	]
	quest.012027CCDC4F3D86.quest_subtitle: "Major bounty · 5 witches"
	quest.012027CCDC4F3D86.title: "Contract: The Coven's Castoffs"
	quest.023C18D31A2D4291.quest_desc: [
		"Fully reinforce one armament: &6+25&r for standard steel, &6+10&r for a unique one. The last step always takes a &6Sovereign&r stone, and those only come from things that wore a crown, or wanted one."
		""
		"&o\"There. Now it sings. Try not to lose it in a ditch.\"&r"
	]
	quest.023C18D31A2D4291.quest_subtitle: "Now it sings."
	quest.023C18D31A2D4291.title: "Masterwork"
	quest.0242238F2A247AFE.quest_desc: [
		"&6Morgrath, Ash Sovereign&r, of the Burning Crown. His token is &8netherite scrap&r: ancient debris, the melted bones of his kingdom's treasure, the only thing his fire couldn't destroy."
		""
		"&7Gather six Fragments and a scrap of netherite."
	]
	quest.0242238F2A247AFE.quest_subtitle: "Morgrath's token is what's left of the world's best metal."
	quest.0242238F2A247AFE.title: "The Burning Crown"
	quest.026CFFF3DA3C13B9.quest_desc: [
		"The Last Shore isn't a shore anymore. Past the Dragon's island the End breaks into &6crystal peaks&r, &6shadowlands&r and &6void barrens&r, as if something tore through it."
		""
		"Walk all three. Watch your step; the floor is optional."
	]
	quest.026CFFF3DA3C13B9.quest_subtitle: "Nullscape. The broken End."
	quest.026CFFF3DA3C13B9.title: "The Shore Stays Dark"
	quest.0342C5D96B7F756D.quest_desc: [
		"A &6spear&r keeps the dead a step and a half further away and runs them through with &6Impaling Thrust&r. The &6Militia Spear&r was handed to farmers when the walls began to fall."
		""
		"A &6halberd&r reaches nearly as far and sweeps instead: &6Spinning Reap&r. The &6Sentinel Halberd&r stood guard long after the guard fell."
	]
	quest.0342C5D96B7F756D.quest_subtitle: "Spears and halberds"
	quest.0342C5D96B7F756D.title: "Reach"
	quest.035F99AB6E2BC271.quest_desc: [
		"Drop copper and zinc ingots into a basin over a lit Blaze Burner and let the mixer turn them into &6Brass&r."
		""
		"Brass casings, electron tubes, brass hands: everything past this point needs it."
	]
	quest.035F99AB6E2BC271.quest_subtitle: "Gold's honest cousin."
	quest.035F99AB6E2BC271.title: "&aReal Alloys"
	quest.037DDC36DF427850.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Your runes have opinions now. Listen to them. A blade, a star, a prayer. Pick one before the dark picks for you.\"&r"
		""
		"The &6Remnant Constellation&r is the map the Crown's astromancers drew of every way a person can carry light. Most of its stars went dark with the sun. Yours are lighting up."
		""
		"&7&6Strength&7 and &6Dexterity&7 for steel, &bIntelligence&7 for staves, &eFaith&7 for sacred seals, &5Arcane&7 for the strange things. Open the Constellation (&eP&7), take your first ability and cast it with &eZ&7. Its &bEssence&7 refills on its own. The &ePaths of the Ashborn&7 chapters go deeper into each one."
	]
	quest.037DDC36DF427850.quest_subtitle: "Blade, sorcery or faith. Or all three, badly."
	quest.037DDC36DF427850.title: "Choose a Path"
	quest.047D48D40E43B390.quest_desc: [
		"A &6fancy bed&r takes planks, wool, a &6cushion&r and a &6sheet&r. It does what a bed does, with more dignity."
		""
		"Sleeping in a bed sets your respawn, so keep it within sight of the shrine."
	]
	quest.047D48D40E43B390.quest_subtitle: "You can't die for good. You can at least sleep well."
	quest.047D48D40E43B390.title: "A Bed Worth Waking In"
	quest.0500F324C32C43A3.quest_desc: [
		"Blind, patient and older than the Crown. It hears your footsteps and smells your fear, and its roar goes through walls."
		""
		"Sneak. Throw snowballs or arrows to send it elsewhere. If you must fight, never stand in a straight line with it when it draws breath."
	]
	quest.0500F324C32C43A3.quest_subtitle: "Old Power. An ancient city. Level 45."
	quest.0500F324C32C43A3.title: "&5The Warden"
	quest.053AA33D36140B4E.quest_desc: [
		"&7This whole path is optional. Nothing in the story needs it; Last Light just runs smoother with it."
		""
		"Mix andesite with iron or zinc nuggets into &6Andesite Alloy&r: the bones of every machine to come."
		""
		"&o\"The old world ran on wheels and water. It ran right up until it didn't.\"&r"
	]
	quest.053AA33D36140B4E.quest_subtitle: "Someone before the Eclipse built machines. Some of you remember how."
	quest.053AA33D36140B4E.title: "&aAshen Engineers"
	quest.055B513D43CFE9C9.quest_desc: [
		"Under the graveyards are the &6crypts&r: coffins, candles and acolytes who pray to things that answer."
		""
		"Don't open a coffin unless you're ready for what's inside. Wraiths don't forgive being woken."
	]
	quest.055B513D43CFE9C9.quest_subtitle: "The Graveyard. A crypt underground."
	quest.055B513D43CFE9C9.title: "Into Darkness"
	quest.05A146304EF19E9B.quest_desc: [
		"In the &6Gravefield Barrows&r, a Burial Guardian tends the graves of the Hollow Legion: the soldiers who followed the Eighth behind the sun. It carries the iron of their coffins."
		""
		"&7Kill it for &7Grave Iron&7, then forge the &6Crypt Key&7: six Grave Iron around a block of iron."
	]
	quest.05A146304EF19E9B.quest_subtitle: "It keeps the Grave Iron."
	quest.05A146304EF19E9B.title: "The Burial Guardian"
	quest.05EAAA5866A04A29.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Some of them have died more than once. Each time they come back meaner. Count the crests before you count your chances.\"&r"
		""
		"A monster that rises again rises stronger. Its crest shows how many times:"
		""
		"&7Common&r → &aVeteran&r → &9Elite&r → &5Champion&r → &cRemnant&r"
		""
		"&7Ranked monsters carry &etraits&7 (Vampiric, Blinking, Packleader…) under their name. Every ranked kill drops a &6Remnant Shard&7; crush it to absorb its &6Valor&7. A &6Hunter's Lens&7 reads a monster's threat before you commit. Take this one."
	]
	quest.05EAAA5866A04A29.quest_subtitle: "Veteran, Elite, Champion… Remnant."
	quest.05EAAA5866A04A29.title: "Know Thy Enemy"
	quest.063AD2AB6F866AE5.quest_desc: [
		"A Sigil is a Sovereign's own name, pressed into a scrap of their light. Hold it up at dusk and the name remembers who it belongs to."
		""
		"&7Craft the Dusk Rider's Sigil."
	]
	quest.063AD2AB6F866AE5.quest_subtitle: "Time, folded into a seal."
	quest.063AD2AB6F866AE5.title: "A Clock for the Dusk"
	quest.069692FDDF270544.quest_desc: [
		"Craft an &6Iron Fishing Rod&r. Aquaculture's rods take a &6hook&r, &6bait&r, a coloured line and a bobber; fit them at a &6Tackle Box&r."
		""
		"Every water keeps its own fish: rivers, oceans, jungles, swamps and frozen seas."
	]
	quest.069692FDDF270544.quest_subtitle: "Fish don't care what happened to the sun."
	quest.069692FDDF270544.title: "A Line in Dark Water"
	quest.06B2E89F7AAD0CBA.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The end of the trail. The Archivist owes me a drink. I said someone would make it.\"&r"
		""
		"In the far snows the &6Soulfire Crypt&r burns blue. The Cinder Warden keeps the last map of the dungeon trail, and the last map leads nowhere: just a drawing of the Crypt itself, and a note in an old hand. &o\"You found it. Now turn back.\"&r"
		""
		"&7Kill the Cinder Warden."
	]
	quest.06B2E89F7AAD0CBA.quest_subtitle: "Tier IV. The end of the dungeon trail."
	quest.06B2E89F7AAD0CBA.title: "The Soulfire Crypt"
	quest.0706431E96A6A53E.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The dead keep pockets. Habit, I think. Nobody tells them they can't take it with them.\"&r"
		""
		"Remnants carry what they carried when they died: coin, trinkets, letters to people long gone. The Company calls it &6spoils&r and doesn't ask whose."
		""
		"&7Monsters sometimes drop &6loot bags&7. Hold use to open one; hold &eShift&7 over a bag for its odds. Four bags of a tier combine into the next, up to &dMythic&7."
	]
	quest.0706431E96A6A53E.quest_subtitle: "The dead hoard."
	quest.0706431E96A6A53E.title: "Spoils of the Dead"
	quest.070E2217B342F75C.quest_desc: [
		"The Realm's forgotten souls carry crumbs of the light the Eighth swallowed: tiny memories of mornings, warmth, colour. Collect enough and you can see through them."
		""
		"&7Four &6Memory Shards&7, four amethyst and a spyglass make the &6Lens of Memory&7."
	]
	quest.070E2217B342F75C.quest_subtitle: "The Forgotten Souls remember for you."
	quest.070E2217B342F75C.title: "Shards of Memory"
	quest.0781526A75E94F30.quest_desc: [
		"&eChain Lightning&r, &eStatic Field&r, &eThunderclap&r, &eGale Step&r, and the ultimate, &eTempest&r."
		""
		"Keystones: &eConduit&r (every fourth ability is free and hits twice as hard) and &eWindborne&r (no fall damage and 15% more speed, for 15% of your armour)."
	]
	quest.0781526A75E94F30.quest_subtitle: "The air tastes of copper before it breaks."
	quest.0781526A75E94F30.title: "&eStormcalling"
	quest.078DDBFAFBBDF838.quest_desc: [
		"Arrange &6Mechanical Crafters&r in the shape of a recipe, point them toward each other and give them rotation. They pass the ingredients along and finish the craft on their own."
	]
	quest.078DDBFAFBBDF838.quest_subtitle: "A crafting table that does its own work."
	quest.078DDBFAFBBDF838.title: "Automated Assembly"
	quest.07EB56F3B729FC13.quest_desc: [
		"The deepest prison the Sovereigns dug, for the thing they feared most. Whatever it was, they were right to."
		""
		"&7Clear the Abyssal Halls and kill their guardian."
	]
	quest.07EB56F3B729FC13.quest_subtitle: "The deepest Labyrinth."
	quest.07EB56F3B729FC13.title: "The Abyssal Halls"
	quest.09ECC735C3E73819.quest_desc: [
		"&o\"If you feel like something is following you, something is. Turn around slowly. Then stop being slow.\"&r"
		""
		"Kill a &cNightmare Stalker&r. It finds you, not the other way round: walk the dark at night and wait for the warning."
	]
	quest.09ECC735C3E73819.quest_subtitle: "Major bounty · 1 Nightmare Stalker · after Sylvara"
	quest.09ECC735C3E73819.title: "Contract: Something Following"
	quest.0A7BBCEB78D48C97.quest_desc: [
		"The first bridge over the Broken Meridian exists only in memory. Follow the live channel of light to its remote seal, arm it, then wake the glowing socket to move the relay."
		""
		"Return to &7Ruin&r. What's left of the relay is your second crossing."
	]
	quest.0A7BBCEB78D48C97.quest_subtitle: "A bridge in two tenses."
	quest.0A7BBCEB78D48C97.title: "Causality Has Weight"
	quest.0AE0B33F0F37E88C.quest_desc: [
		"Sellswords level as they fight, up to 20, and never past your own RPG level. Along the way they earn titles: &aVeteran&r, &9Champion&r, &5Hero&r, &6Legend&r."
		""
		"Keep one alive long enough to earn the first. Harder than it sounds. Easier than the last."
	]
	quest.0AE0B33F0F37E88C.quest_subtitle: "Veteran, Champion, Hero, Legend."
	quest.0AE0B33F0F37E88C.title: "Blooded"
	quest.0B070AB1FFD55E20.quest_desc: [
		"Out in the broken End lie the &6bones of a dragon&r far bigger than the one you killed."
		""
		"The Ender Dragon wasn't the first. Stand in the ribcage and wonder who broke the sun, and whether it was the first thing they broke."
	]
	quest.0B070AB1FFD55E20.quest_subtitle: "Nullscape. Something died here first."
	quest.0B070AB1FFD55E20.title: "Bones of an Older Dragon"
	quest.0B3D47A11A359E87.quest_desc: [
		"The Hollow Sovereign's army still drills under the black sun. &6Sentinels&r hold the line, &6Arbalists&r shoot from behind it, a &6Standard Bearer&r keeps them in order and &6Soulbound Knights&r break whatever's left."
		""
		"Kill the banner first. Armies without one are just crowds. Their &6Tarnished Regalia&r is worth keeping: a Sovereign's Seal needs four."
	]
	quest.0B3D47A11A359E87.quest_subtitle: "The Eclipsed Realm. Soldiers of a hollow king."
	quest.0B3D47A11A359E87.title: "The Hollow Legion"
	quest.0BE5288086362BBD.quest_desc: [
		"Past level 30, a very few monsters rise as &cRemnants&r: named echoes with a title, a boss bar and a horn you can hear from nearly fifty blocks off. They never despawn. They remember."
		""
		"When one falls, the whole world hears about it. Make sure it's your name in the message."
	]
	quest.0BE5288086362BBD.quest_subtitle: "It has a name. It has a horn."
	quest.0BE5288086362BBD.title: "&cA Remnant's End"
	quest.0BF2293E74CE6419.quest_desc: [
		"&o\"Zombies. I know. Somebody has to, and the somebody is you.\"&r"
		""
		"Kill &c20 zombies&r. Ranked ones count the same and pay their own shards on top. A &eVampiric&r one heals when it bites; don't trade blows with it."
	]
	quest.0BF2293E74CE6419.quest_subtitle: "Minor bounty · 20 zombies"
	quest.0BF2293E74CE6419.title: "Contract: The Shambling Dead"
	quest.0C411F150C9A925E.quest_desc: [
		"Every week the Archive offers one recollection to everyone. Claim the &6Weekly Memory Key&r from the Weekly page of your &6Archive Codex&r (&eY&r). Its Distortions are sealed; the only choice left is how deep."
		""
		"Remember it. The board shows who went deepest."
	]
	quest.0C411F150C9A925E.quest_subtitle: "Same recollection, everyone."
	quest.0C411F150C9A925E.title: "This Week's Memory"
	quest.0C94C038DC564A5E.quest_desc: [
		"Lay &6Burning Ashes&r on the &6Altar of Fire&r in the Burning Arena and a knight made of flame stands up."
		""
		"Sword, shield and three moods. Don't attack into the shield; punish after the charge. When its flames turn blue, it has stopped holding back."
	]
	quest.0C94C038DC564A5E.quest_subtitle: "The Burning Arena. Level 60."
	quest.0C94C038DC564A5E.title: "Ignis"
	quest.0C9C07E1DB69D5DA.quest_desc: [
		"&o\"The fishers won't go out past the reeds anymore. Fix that.\"&r"
		""
		"Kill &c10 drowned&r in the rivers and the shallows. Some carry tridents, and they throw them."
	]
	quest.0C9C07E1DB69D5DA.quest_subtitle: "Minor bounty · 10 drowned"
	quest.0C9C07E1DB69D5DA.title: "Contract: The Drowned Watch"
	quest.0CA8540794DAC251.quest_desc: [
		"Climb the &6dragon's tower&r past its burning guard. The top floor is a nest, and the nest is occupied."
		""
		"Fire Resistance first, questions later. It breathes in long sweeps: roll toward its flank, never back toward the edge."
	]
	quest.0CA8540794DAC251.quest_subtitle: "A dragon's tower. Level 40."
	quest.0CA8540794DAC251.title: "Ashlord, the Infernal Dragon"
	quest.0CC770C15897C5B5.quest_desc: [
		"Every armament carries a &6weapon art&r. Press &eR&r to unleash it. Arts cost &bFP&r, the blue bar, and recharge after a short cooldown."
		""
		"Staves cast &bsorceries&r that scale with Intelligence; sacred seals cast &eincantations&r that scale with Faith. On a catalyst, &eR&r casts its bound spell."
		""
		"&bMind&r raises your FP. It trickles back on its own, slowly. The Azure Flask is faster."
	]
	quest.0CC770C15897C5B5.quest_subtitle: "FP is spent, not owed."
	quest.0CC770C15897C5B5.title: "Arts and the Blue Bar"
	quest.0D90FE9683ACA82F.quest_desc: [
		"Last Light isn't the only village that kept a fire. Out in the meadows, badlands, groves and swamps, people built in their own fashion and rang their own bells."
		""
		"Visit one built the way its land wanted. Sellswords loiter by every bell, by the way."
	]
	quest.0D90FE9683ACA82F.quest_subtitle: "Towns and Towers. A village not like yours."
	quest.0D90FE9683ACA82F.title: "Other People's Fires"
	quest.0D9E578083218E57.quest_desc: [
		"Everything you kill pays &6runes&r: more for higher levels, far more for champions and Sovereigns. They're held, not banked. When you die, they stay where you fell."
		""
		"Sometimes the dead drop runes as an item: a &6Faded Rune&r is 200, a Lustrous 1,000, a Radiant 4,000. An item in your pack goes into your corpse when you die, not into the ash. Crush it when you're standing at a shrine, not before."
	]
	quest.0D9E578083218E57.quest_subtitle: "Runes you hold are runes you can lose."
	quest.0D9E578083218E57.title: "Light in Your Pocket"
	quest.0DAAF69B89766698.quest_desc: [
		"Six Sovereigns leave &6Crown Shards&r: Varghast's (+5 to every attribute), Sylvara's (health, and no frostbite), Kaelthar's (lightning and stamina), Ysolde's (life from every kill), Morgrath's (physical damage, and no fire), Vaelorn's (cheaper spells). The seventh is the Dragon's, at the world's end."
		""
		"Use each to claim it, then wear one at a time from a shrine. Claim all seven and the crown that broke the sun is whole again, for whatever that's worth."
	]
	quest.0DAAF69B89766698.quest_subtitle: "Seven shards. One hollow crown."
	quest.0DAAF69B89766698.title: "&6The Crown Remade"
	quest.0DF8C2E1B1B039B5.quest_desc: [
		"Morgrath had prisons too. When he burned his kingdom, he forgot to burn them. The prisoners noticed."
		""
		"&7Clear the Infernal Bastille and kill its guardian."
	]
	quest.0DF8C2E1B1B039B5.quest_subtitle: "The last Labyrinth burns."
	quest.0DF8C2E1B1B039B5.title: "The Infernal Bastille"
	quest.0EEE9DC26AF062BF.quest_desc: [
		"&bWarded&r: a shield of absorption that regrows if you leave it alone. Keep the pressure on."
		"&aRegenerating&r: steadily heals, and fast once out of combat. Retreating to heal helps it more than you."
		"&2Thornskin&r: melee hits hurt you back. Use a bow, a spell or a sellsword."
		"&7Juggernaut&r: can't be knocked back, more health and armour, but slower. Walk circles around it."
		"&fDeflecting&r: projectiles barely scratch it. Draw steel."
	]
	quest.0EEE9DC26AF062BF.quest_subtitle: "Traits that keep it standing."
	quest.0EEE9DC26AF062BF.title: "Hard to Kill"
	quest.10216BCC92CE4DFA.quest_desc: [
		"The Ashlands' fortresses sprawl now: halls, bridges, a forge or two. Wither skeletons walk them with their heads still on."
		""
		"Three of those heads build the Wither. Take them."
	]
	quest.10216BCC92CE4DFA.quest_subtitle: "A Nether fortress, and what it guards."
	quest.10216BCC92CE4DFA.title: "Skulls for the Withering"
	quest.10A48EAE33052B15.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Five embers. More than half the sun. Look up tonight, Ashborn. The sky is not black any more. It's dark blue. Tell me you can't see it.\"&r"
		""
		"Her garden dies with her. Something in you will be sorry about that, and you should let it."
		""
		"&7She bleeds you: &cHemorrhage&7 builds with every cut and bursts for a share of your health. Don't let her chain combos; one clean roll beats three panicked ones."
	]
	quest.10A48EAE33052B15.quest_subtitle: "Sovereign of the Scarlet Garden. Level 35."
	quest.10A48EAE33052B15.title: "&6Sovereign: Ysolde, the Crimson Bloom"
	quest.10E01E0949060610.quest_desc: [
		"Three skulls and soul sand make a thing that hates everything that lives. It keeps a relic of the world before."
		""
		"Build it underground so it can't fly away from you. Below half health it wears armour against arrows: put the bow away and go in with steel and milk."
	]
	quest.10E01E0949060610.quest_subtitle: "Old Power. Level 60."
	quest.10E01E0949060610.title: "&5The Wither"
	quest.114B02670B918297.quest_desc: [
		"The third map leads to the hot, wet edges of the world: deserts, badlands, jungles, swamps. The &6Cursed Keep&r is held by the &6Keep Warlord&r, and he hasn't been relieved in an age."
		""
		"&7Cartographers disagree on whether it's the second or third dungeon. The map says III. Trust the map."
	]
	quest.114B02670B918297.quest_subtitle: "Tier III: the Cursed Keep."
	quest.114B02670B918297.title: "Cursed Ground"
	quest.117A2520497C8CF2.quest_desc: [
		"In the depths of the Ashlands a burning knight waits in a ring of fire. It was Morgrath's champion, the one who lit the first torch. It is still loyal, and it is still holding the torch."
		""
		"&7Kill Ignis."
	]
	quest.117A2520497C8CF2.quest_subtitle: "The burning arena."
	quest.117A2520497C8CF2.title: "Ignis"
	quest.125F0DA757CBDD14.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Four embers. Listen. No thunder. For the first time in an age, the sea is just the sea. Halfway, Ashborn. Halfway home.\"&r"
		""
		"He calls lightning down where you stand. The storm loves him back, which is the saddest thing about him."
		""
		"&7Keep moving, never stand still for a whole breath, and never fight him in the rain if you can help it."
	]
	quest.125F0DA757CBDD14.quest_subtitle: "Sovereign of the Drowned Sky. Level 30."
	quest.125F0DA757CBDD14.title: "&6Sovereign: Kaelthar the Stormcaller"
	quest.12F851598BB7E340.quest_desc: [
		"A war machine from before the Crown, switched off and waiting in a buried &6factory&r. It wakes for a &6Nether Star&r. Think about that before you offer one."
		""
		"Its missiles follow you: break line of sight behind pillars. Its lasers sweep: roll through, never along."
	]
	quest.12F851598BB7E340.quest_subtitle: "The Ancient Factory, underground. Level 45."
	quest.12F851598BB7E340.title: "The Harbinger"
	quest.134DD4A4C8D25F41.quest_desc: [
		"The masked &6Umvuthana&r guard a grove in the savanna, and their chief wears the sun for a face."
		""
		"Thin the masks before you go up to him. When he calls the sun down, keep moving: it lands where you stood. When the air around him starts to burn, get out of reach."
		""
		"&7Wear one of their masks and they may take you for family. Briefly."
	]
	quest.134DD4A4C8D25F41.quest_subtitle: "An Umvuthana grove in the savanna. Level 25."
	quest.134DD4A4C8D25F41.title: "Umvuthi, the Sunbird"
	quest.13710AE6CE4464A8.quest_desc: [
		"A &6Memory Key&r (amethyst, gold and an ender pearl, or a trade with Oren) opens an expedition. Use it on a &6Waystone&r, on the Curator Gateway, or inside any structure."
		""
		"The Attunement screen offers &cDistortions&r: Fortified, Tyrannical, Bolstering, Volatile, Haunted, Frailty, Hourglass, Amnesia. Each adds &cHeat&r; &6Fracture&r is tier plus Heat, and Fracture pays. Friends within 24 blocks come along."
	]
	quest.13710AE6CE4464A8.quest_subtitle: "Amethyst, gold, and a pearl for the lock."
	quest.13710AE6CE4464A8.title: "A Key Cut from Memory"
	quest.1378690974492D71.quest_desc: [
		"Plated meals grant &6Nourishment&r: your hunger stops draining while it lasts. Soups and stews grant &6Comfort&r: you heal naturally however empty your stomach is."
		""
		"Eat one before a long dungeon and you won't be chewing bread in the middle of a boss's second phase."
	]
	quest.1378690974492D71.quest_subtitle: "A full belly outlasts a long fight."
	quest.1378690974492D71.title: "Nourishing!"
	quest.137F886E8D60FFF5.quest_desc: [
		"A kindled shrine stays kindled, and every one is a door. Open &6Travel&r at any shrine to step out at another."
		""
		"Kindle them where you'll need to come back: the mouth of a dungeon, the edge of the Ashlands, the road home."
	]
	quest.137F886E8D60FFF5.quest_subtitle: "The road is shorter if you've lit both ends."
	quest.137F886E8D60FFF5.title: "Between Two Fires"
	quest.1392419458694CF8.quest_desc: [
		"A forge that learned to walk. It sleeps in the &6Soul Forge&r until something warm comes close."
		""
		"It's slow and it telegraphs everything. Roll the slam's shockwave, stay out of the lava it throws, and never trade blows with it."
	]
	quest.1392419458694CF8.quest_subtitle: "The Soul Forge. Level 55."
	quest.1392419458694CF8.title: "The Netherite Monstrosity"
	quest.1396239BCA1C36D0.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Look at that. Go on, look. I'd almost forgotten the colour.&r"
		""
		"&f&oEvery ember you rekindled is still burning, and every Ashborn on this world carries a heart for each one. The dead are lying down, Ashborn. Not all of them. Most. The ones still walking out there are just stubborn, like the rest of us.&r"
		""
		"&f&oRest now. The sun remembers you. It remembers all of us, I think. Even the ones who don't deserve it.\"&r"
		""
		"The &6Long Eclipse&r is over. Mostly."
	]
	quest.1396239BCA1C36D0.quest_subtitle: "Eight embers. One sun."
	quest.1396239BCA1C36D0.title: "&6&lFirst Light"
	quest.13C1BD37F51047C4.quest_desc: [
		"A &6Nature's Compass&r: a compass framed in logs and saplings. Name a kind of land and it turns toward the nearest."
		""
		"The world grew strange in the dark: savannas gone grey, groves that only bloom by moonlight, mountains that never stop climbing."
	]
	quest.13C1BD37F51047C4.quest_subtitle: "Every land has a name too."
	quest.13C1BD37F51047C4.title: "&6The Compass That Listens"
	quest.1410C8CE7B678479.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The sea kept a secret for the world. Three old things guard it, and they curse anyone who swims too close. Swim close.\"&r"
		""
		"Deep in the &3ocean monuments&r, three Elder Guardians keep the sea's oldest memory: the first sunrise, sunk in a vault of prismarine so it could never be stolen."
		""
		"&7Find a monument and kill an Elder Guardian."
	]
	quest.1410C8CE7B678479.quest_subtitle: "Old Power: the Elder Guardian."
	quest.1410C8CE7B678479.title: "&5The Drowned Keeper"
	quest.14F7C59D230494DE.quest_desc: [
		"Strongholds are proper dungeons now: prisons, crypts, libraries and traps, all built around a door to the Last Shore."
		""
		"Eyes of Ender lead you there. Bring more than you think. Bring torches for the way back."
	]
	quest.14F7C59D230494DE.quest_subtitle: "A stronghold, a library, a door."
	quest.14F7C59D230494DE.title: "The Eye's Road"
	quest.15567CA6EC3B8885.quest_desc: [
		"A knight in void-black armour keeps the &6Ruined Citadel&r on the outer End islands."
		""
		"Void runes burst from the floor in rows: keep moving. It pulls you in with its gauntlet, so roll when the fist opens. When the helmet breaks, it gets faster."
	]
	quest.15567CA6EC3B8885.quest_subtitle: "The Ruined Citadel. Level 70."
	quest.15567CA6EC3B8885.title: "The Ender Guardian"
	quest.155ECFEC2013184C.quest_desc: [
		"Press &eU&r for the &6roster&r. Every sellsword has a portrait, a level, a title and a &6Chronicle&r written from what it actually did: the oath it swore, the kill that blooded it, the time it saved you."
		""
		"&o\"The Company keeps two ledgers. One for gold, one for names. The second one's longer.\"&r"
	]
	quest.155ECFEC2013184C.quest_subtitle: "Two ledgers. One for gold, one for names."
	quest.155ECFEC2013184C.title: "The Chronicle"
	quest.157BCBD1438177C5.quest_desc: [
		"A &6Deployer&r uses whatever item it holds on the block in front of it: places, clicks, plants, shears. Point one at a field with seeds in its hand."
		""
		"&7It can also attack. It will not dodge."
	]
	quest.157BCBD1438177C5.quest_subtitle: "It uses what it holds. It never gets tired."
	quest.157BCBD1438177C5.title: "A Hand That Isn't Yours"
	quest.15F5C86082963CDF.quest_desc: [
		"Give a sword to a villager with no profession and they become a &6Guard&r: armoured, patrolling, loyal to the bell."
		""
		"Guards are not sellswords. They won't follow you out. That's rather the point."
	]
	quest.15F5C86082963CDF.quest_subtitle: "Villages that fight back live longer."
	quest.15F5C86082963CDF.title: "Last Light Takes Up Arms"
	quest.178657B676B4FF56.quest_desc: [
		"Six scenes survive: &7The Evacuation&r, &7The Instant the Archive Fell&r, &7The Orrery at Work&r, &7A Family Beneath the Conjunction&r, &7The Curator Repaired&r and &7The Final Command&r. Carry all six plates at once."
		""
		"&o\"Bring me all six and I'll tell you which one is a lie. Archives are polite like that.\"&r &7— Oren&r"
	]
	quest.178657B676B4FF56.quest_subtitle: "The whole of the last day."
	quest.178657B676B4FF56.title: "Six Ways to Remember"
	quest.17F741649E804F38.quest_desc: [
		"The &6dungeon trail&r starts with thieves. A &6Smuggler's Villa&r stands in the open plains, meadows, flower forests and savannas."
		""
		"Every dungeon on the trail has a named guardian and a vault, and every vault holds a &6Dungeon Map&r to the next, harder one. Follow the maps."
		""
		"&7An Explorer's Compass finds them too, if you'd rather not read."
	]
	quest.17F741649E804F38.quest_subtitle: "Tier I: the Smuggler's Villa."
	quest.17F741649E804F38.title: "Contraband"
	quest.17FE1BB1FA957E89.quest_desc: [
		"The fishers of the coast never stopped fishing. The dark doesn't care about the tide, and neither do they."
		""
		"Find &6Saylor's&r cottage on a sandy or snowy beach. The residents trade things you won't find inland."
	]
	quest.17FE1BB1FA957E89.quest_subtitle: "Fisherman's Coast. A cottage on the beach."
	quest.17FE1BB1FA957E89.title: "Home of Saylor"
	quest.18B87BE4E12BE468.quest_desc: [
		"Some skeletons rise with a &6Quiver&r on their backs. Kill them and it's yours. Dungeon chests and pillager camps hide a few more."
		""
		"A quiver holds several kinds of arrow and lets you choose which one to loose. Carry it in your offhand or an accessory slot."
	]
	quest.18B87BE4E12BE468.quest_subtitle: "The skeletons won't need it."
	quest.18B87BE4E12BE468.title: "A Quiver Taken Back"
	quest.190A1E4452E9C0BB.quest_desc: [
		"The ship still has a crew, and the crew still has a captain, and the captain is mostly tentacles."
		""
		"Clear the deck before you wake it. Fight on the planks, cut each tentacle as it rises, and stay out of the cannons' line."
	]
	quest.190A1E4452E9C0BB.quest_subtitle: "A pirate wreck on the deep ocean. Level 35."
	quest.190A1E4452E9C0BB.title: "Nerakyss, the Kraken"
	quest.190E84DFB94144CA.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Two embers. When he fell, I heard them. All those soldiers, finally let go. Some of them were saying thank you, Ashborn. I think one of them was saying it to you.\"&r"
		""
		"Craft his &6Sigil&r and call him somewhere wide. He swings like a man with a hundred arms and nothing left to lose, because he has and he hasn't."
		""
		"&7His grafted arm has the reach of a spear. Don't trade blows; roll &oforward&7 into his swing and punish the recovery."
	]
	quest.190E84DFB94144CA.quest_subtitle: "Sovereign of the Hollow Vale. Level 20."
	quest.190E84DFB94144CA.title: "&6Sovereign: Varghast the Grafted"
	quest.1932FE6F415B39CD.quest_desc: [
		"&o\"Cave spiders don't count. I'm not paying you to crawl into a mineshaft after something the size of a dinner plate.\"&r"
		""
		"Kill &c10 spiders&r. &eVenomous&r ones poison you: rest at a shrine or let a flask do its work."
	]
	quest.1932FE6F415B39CD.quest_subtitle: "Minor bounty · 10 spiders"
	quest.1932FE6F415B39CD.title: "Contract: Eight Legs"
	quest.194DBF5B86695C7E.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"A hundred levels. You could carry a Sovereign's share of light now, and not go mad from it. Probably.\"&r"
		""
		"The Sovereigns each held a hundredth of the sun and it broke them. You hold more than that, and you're still you. Mostly."
		""
		"&7Reach rune level 100."
	]
	quest.194DBF5B86695C7E.quest_subtitle: "Rune level 100."
	quest.194DBF5B86695C7E.title: "Ascendant"
	quest.19610B4F5D841A48.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Armour doesn't make you brave. It makes you stupid for a little longer, which is nearly the same thing.\"&r"
		""
		"Every Remnant out there was once someone who thought leather was enough."
		""
		"&7Forge an iron chestplate and helmet."
	]
	quest.19610B4F5D841A48.quest_subtitle: "Plate, for the parts that bleed."
	quest.19610B4F5D841A48.title: "Something Between You and Them"
	quest.19666D84A72F033D.quest_desc: [
		"The &6Mauler&r lies in wait in dry country, all jaws and patience. The &6Iceologer&r keeps a cabin in the snow and drops chunks of ice on anyone who visits."
		""
		"Kill both. Look down for the first, up for the second."
	]
	quest.19666D84A72F033D.quest_subtitle: "Friends & Foes. The ones that aren't friends."
	quest.19666D84A72F033D.title: "Teeth and Ice"
	quest.19DAFF2C11C635D4.quest_desc: [
		"A walled keep sinking into a swamp, still garrisoned, still loyal to someone who died a long time ago."
		""
		"Storm the walls or find the side door. Both are traditional."
	]
	quest.19DAFF2C11C635D4.quest_subtitle: "When Dungeons Arise. A fortress in the swamp."
	quest.19DAFF2C11C635D4.title: "Keep Kayra"
	quest.1A2FC801E1E229F5.quest_desc: [
		"The Eighth's sworn blade, who followed his master behind the sun and was the first to rise again under it. He's proud of that. He shouldn't be: the desert remembers someone older."
		""
		"&7An Ancient Altar, four skeleton skulls on the pedestals and a &5Nether Star&7. Ossukage answers anywhere, not just in the Realm. He is invulnerable while he rises; then a sword chain, kunai at range, and a second form that raises soldiers and dashes through you."
	]
	quest.1A2FC801E1E229F5.quest_subtitle: "He calls himself the original Remnant."
	quest.1A2FC801E1E229F5.title: "&cRemnant: Ossukage"
	quest.1ABCE2303C3DC417.quest_desc: [
		"Not every boss wants you dead. This one wants you to climb."
		""
		"Find the monastery on a mountain peak and take the &6Sculptor's test&r: reach the top of the moving pillar before time runs out, then speak to the Sculptor again. No placing blocks, no pearls, no flying."
		""
		"&7Falling is permitted. Once."
	]
	quest.1ABCE2303C3DC417.quest_subtitle: "A monastery on the peaks. Any level."
	quest.1ABCE2303C3DC417.title: "Tongbi, the Sculptor"
	quest.1ABD147F1054853C.quest_desc: [
		"The forests outlived the sun. Trees grow toward a light that isn't there any more, out of habit, the way old soldiers salute an empty throne."
		""
		"&7Gather logs. Everything starts with wood."
	]
	quest.1ABD147F1054853C.quest_subtitle: "Every Ashborn starts the same way."
	quest.1ABD147F1054853C.title: "Wood Before Iron"
	quest.1B71C09161A6DDFB.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Toll's ringing. Bar the doors, sharpen something, and don't stand near the windows. Or go out there. You were always going to go out there.\"&r"
		""
		"Some full moons rise &cred&r. A toll sounds across the world, and until dawn the Eclipse leans close."
		""
		"&7On a Hunter's Moon every monster gains &c+5 levels&7, ranks come twice as often and Remnant Shards drop twice as thick. Survive one. Better: hunt through one. Type &e/remnants moon&7 to check tonight's moon."
	]
	quest.1B71C09161A6DDFB.quest_subtitle: "Monsters grow stronger until dawn."
	quest.1B71C09161A6DDFB.title: "&cUnder the Hunter's Moon"
	quest.1B9493EA2CDB6435.quest_desc: [
		"&o\"Close the distance or don't bother. They never run out of arrows. You'll run out of patience.\"&r"
		""
		"Kill &c15 skeletons&r. Watch for &eBlinking&r ones: they won't stay where you left them."
	]
	quest.1B9493EA2CDB6435.quest_subtitle: "Minor bounty · 15 skeletons"
	quest.1B9493EA2CDB6435.title: "Contract: Bone Archers"
	quest.1BA27B12A75053E1.quest_desc: [
		"Knot &6Fishing Nets&r from string, then a &6Crab Pot&r from nets and sticks, or buy one from a coast fisherman. Set it in open water with &6bait&r inside."
		""
		"&6Fish Bait&r is seeds and rotten flesh. &6Chum&r and &6Glow Bait&r are the others; the swamp folk swear by chum. Rain doubles the catch, and a hopper underneath empties the pot for you."
	]
	quest.1BA27B12A75053E1.quest_subtitle: "Bait it, sink it, walk away."
	quest.1BA27B12A75053E1.title: "Pot Luck"
	quest.1BB0482EBD1CCB9B.quest_desc: [
		"Wear &6Engineer's Goggles&r and hold a &6Wrench&r. The goggles show speed and stress on anything you look at; the wrench turns blocks and picks machines up whole."
	]
	quest.1BB0482EBD1CCB9B.quest_subtitle: "See the strain before it breaks."
	quest.1BB0482EBD1CCB9B.title: "Kitted Out"
	quest.1BD8E51A73CB9F07.quest_desc: [
		"Somewhere in this world, a day never ended. An &6Archivist's Journal&r turned up in your pack the day you woke. Read it."
		""
		"Three &6Fracture Shrines&r stand at fixed places, a long walk from spawn. They mark where the catalogue tore. Find one."
		""
		"&o\"The day did not end. We filed it anyway.\"&r &7— the Archivist's Journal&r"
	]
	quest.1BD8E51A73CB9F07.quest_subtitle: "Somewhere, a day never ended."
	quest.1BD8E51A73CB9F07.title: "&eEvery Ruin Has a Before"
	quest.1C4F62CC967526A2.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Ysolde loved her garden more than her court. When the sun went out, the flowers started dying, so she fed them. First the servants. Then the court. Then herself, a little, every day.\"&r"
		""
		"&6Ysolde, the Crimson Bloom&r, Sovereign of the Scarlet Garden, kept her roses alive in the dark at any price. Her token is a &cblock of redstone&r, the colour of everything she ever loved."
		""
		"&7Gather six Fragments and a block of redstone."
	]
	quest.1C4F62CC967526A2.quest_subtitle: "Ysolde grew flowers in blood."
	quest.1C4F62CC967526A2.title: "The Scarlet Garden"
	quest.1C55780131B14BC9.quest_desc: [
		"Kaelthar talked to storms. &6Scylla&r owns one, and holds court at the &6Acropolis&r over the warm sea."
		""
		"Her lightning spears telegraph a line before they land: sidestep, don't backpedal. When she throws the anchor, it comes back."
	]
	quest.1C55780131B14BC9.quest_subtitle: "The Acropolis, over the warm sea. Level 50."
	quest.1C55780131B14BC9.title: "Scylla, the Storm Empress"
	quest.1C9D50B3DE7EAF63.quest_desc: [
		"&o\"Two kinds of dead that never rot right. One's dried out, one's frozen solid. I want both.\"&r"
		""
		"Kill &c8 husks&r in the deserts and &c8 strays&r in the frozen lands. Husks bring hunger and strays bring slowness: eat well before you go, and bring the dodge."
	]
	quest.1C9D50B3DE7EAF63.quest_subtitle: "Major bounty · 8 husks and 8 strays"
	quest.1C9D50B3DE7EAF63.title: "Contract: Sand and Frost"
	quest.1D21C51451BE6A00.quest_desc: [
		"&bFrost Lance&r, &bTidebinder&r, &bGlacial Prison&r, &bTidal Surge&r, and the ultimate, &bMaelstrom&r."
		""
		"Keystones: &bEternal Tide&r (Essence returns twice as fast from a smaller pool) and &bGlacial Bulwark&r (less damage while above half health, and whatever hits you is chilled). A &bWater Seed&r, eaten, awakens this origin for free."
	]
	quest.1D21C51451BE6A00.quest_subtitle: "Clear as meltwater."
	quest.1D21C51451BE6A00.title: "&bTidecalling"
	quest.1E6B2E42498D1A9F.quest_desc: [
		"The Archive exists in two tenses: &7Ruin&r, what's left, and &bRemembered&r, the page still open. Use the Lens at a &6Memory Anchor&r to move a room between them."
		""
		"Reconstruct the &6Parallax Atrium&r."
		""
		"&o\"Every ruin has a before. I collect befores.\"&r &7— Oren, the Archivist&r"
	]
	quest.1E6B2E42498D1A9F.quest_subtitle: "Ruin, and Remembered."
	quest.1E6B2E42498D1A9F.title: "Recall the First Room"
	quest.1EB0C168D8B7EF05.quest_desc: [
		"Not every campfire on the horizon is a friend's. Illagers pitch &6camps&r along the rivers, beaches and forest edges: tents, a cookfire and a lot of crossbows."
		""
		"Walk in loud or walk in quiet. Either way, the loot is in the tents."
	]
	quest.1EB0C168D8B7EF05.quest_subtitle: "Dungeons and Taverns. An illager camp."
	quest.1EB0C168D8B7EF05.title: "Smoke That Isn't Yours"
	quest.1FF5AC3A0B7D829A.quest_desc: [
		"&6Reinforce&r at a shrine spends runes and stones to raise an armament's plus. Standard steel climbs on &6Tempering Stones&r; unique armaments on &6Lustrous Stones&r."
		""
		"The first stones are cheap: iron, flint and cobbled deepslate make two. The rest of the trade lives in &eThe Armory&r."
	]
	quest.1FF5AC3A0B7D829A.quest_subtitle: "Stones the dead leave behind."
	quest.1FF5AC3A0B7D829A.title: "The Smith's Service"
	quest.20671916ECA3ECDB.quest_desc: [
		"The Old Powers never served the Sovereigns, but each kept a relic of the world before. The &6Warden&r's becomes &6Shadowfang&r or the &6Eclipse Twinblade&r; the &6Elder Guardian&r's, &6Stormfang&r or the &6Bloomwarden's Mace&r; the &6Wither&r's, the &6Gravewarden's Scythe&r or the &6Starfall Slab&r."
		""
		"&7The Dragon at the world's end keeps one too. It can wait.&r"
	]
	quest.20671916ECA3ECDB.quest_subtitle: "Older than the Crown."
	quest.20671916ECA3ECDB.title: "Relics of the Old Powers"
	quest.20A88504DC6B5A17.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"There. Smoke. People, and people who stayed small and stayed lit. Take me there, Ashborn. Fire wants company, and so, I'm told, do I.\"&r"
		""
		"Villages survived the Eclipse by being too small to bother with and too stubborn to die. Their bells still ring at dusk, out of habit, to tell the dark that someone is counting."
		""
		"&7Find a village with a bell."
	]
	quest.20A88504DC6B5A17.quest_subtitle: "Somewhere, someone kept a fire lit."
	quest.20A88504DC6B5A17.title: "Smoke on the Horizon"
	quest.21DCE1D40E334C97.quest_desc: [
		"&5&k|||&r &5A voice from nowhere &k|||&r &e♪"
		""
		"&d&o\"Seven crowns. One hollow. A herald who kept a little flame for later. You were all so busy with the pieces. Not one of you asked who cracked the sun first.\"&r"
		""
		"The Sovereigns broke the sun to share it. The Hollow Sovereign drank what was left. But the Archive is certain of one more thing: the sun was already cracked when the Crown was forged."
		""
		"Something at the edge of the End is still dark. The Dragon remembers the Eighth, and it remembers someone before him."
		""
		"&7Season 2 begins where this one ends. Until then: the Boss Compendium, the Fractured Archive and the Ashen Contracts are endless."
	]
	quest.21DCE1D40E334C97.quest_subtitle: "Seven crowns, one hollow."
	quest.21DCE1D40E334C97.title: "&5Who Broke the Sun?"
	quest.22201CEDCE4457E8.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"You never asked my name. Nobody does. I'll tell you anyway, since you've earned it: I don't have one. Heralds didn't. We had a title, a flame and a road.&r"
		""
		"&f&oI carried the first flame to the forge where the Crown was made. I watched them break the sun into pieces, and I said nothing. That's my share of all this.&r"
		""
		"&f&oAfter, I kept a little of the old flame. Just in case. I gave it to you.\"&r"
		""
		"The Fractured Archive records a herald who carried the first flame to the Crown's forge, and stood by while the Sovereigns broke the sun. The herald's name was never written. Only the title: &6Keeper&r."
	]
	quest.22201CEDCE4457E8.quest_subtitle: "You never asked."
	quest.22201CEDCE4457E8.title: "&e♪ &6The Keeper's Name"
	quest.22CFCF60A22D43F2.quest_desc: [
		"Under jungles, swamps and lush caves, the &6Verdant Warrens&r breed spiders the way other places grow moss. At the heart sits the &6Broodmother&r."
		""
		"Shears for the webs, a sword for the rest, and don't look up."
	]
	quest.22CFCF60A22D43F2.quest_subtitle: "A Labyrinth: the Verdant Warrens."
	quest.22CFCF60A22D43F2.title: "Exterminator"
	quest.23295F8651BB32DA.quest_desc: [
		"Below the ancient cities, the &6Otherside&r has its own animals, and none of them have eyes."
		""
		"The &6Shattered&r stalk the echoing forests, &6Sculk Snappers&r bite at anything that makes a sound, and &6Sculk Centipedes&r crawl the deeplands. They all listen. Sneak, and pick your moment."
	]
	quest.23295F8651BB32DA.quest_subtitle: "Deeper and Darker. The Otherside."
	quest.23295F8651BB32DA.title: "Things That Hear You"
	quest.239F8EB31B6167E6.quest_desc: [
		"Open the shrine's &6Fracture Coffer&r. Inside: a &6Cracked Yesterglass Lens&r and an &6Archive Survey Map&r."
		""
		"The Lens catches moments that have already passed. The crack is why it only catches pieces."
	]
	quest.239F8EB31B6167E6.quest_subtitle: "We sealed a Lens in each shrine before we fled."
	quest.239F8EB31B6167E6.title: "A Fractured Memory"
	quest.23C14B15781EAB1B.quest_desc: [
		"An echo shard ringed with eight Remnant Shards makes a &6Brand of Challenge&r. Use it on a monster and it climbs one rank, gains five levels and one more trait."
		""
		"Its rewards double. So does everything else about it."
	]
	quest.23C14B15781EAB1B.quest_subtitle: "Make it worse. On purpose."
	quest.23C14B15781EAB1B.title: "Accept the Challenge"
	quest.23DCECA4ED0C21FE.quest_desc: [
		"When the sun broke, not all of its light went into the Fragments. Some scattered into a sky only the Ashborn can read."
		""
		"Press &eP&r for the &6Remnant Constellation&r: 522 stars, among them 30 abilities and 12 keystones. Every &6RPG level&r you gain is a &6skill point&r to spend here, and every point must connect back to an &6origin&r."
		""
		"Plan freely; nothing is spent until you confirm. Refunding a node later costs experience levels."
	]
	quest.23DCECA4ED0C21FE.quest_subtitle: "A sky only the Ashborn can see."
	quest.23DCECA4ED0C21FE.title: "&eThe Remnant Constellation"
	quest.244492C516FAF63B.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Company has a saying: pick on someone your own size, and you'll stay that size forever.\"&r"
		""
		"Valor comes faster from fights you shouldn't win. Every Ashborn who ever mattered got there by being reckless at least once and surviving it."
		""
		"&7A monster whose level burns &cred&7 against yours pays half again as much Valor. Kill one."
	]
	quest.244492C516FAF63B.quest_subtitle: "Kill something above your level."
	quest.244492C516FAF63B.title: "Punching Up"
	quest.245A28BBE7AF789F.quest_desc: [
		"The Eighth built an observatory to watch the sun he'd lost, and set a Watcher to stare at it so he wouldn't have to. It has been staring at the black for an age. It has started seeing things."
		""
		"&7Rings of memory bolts, a sweeping beam and a teleport between four lens platforms. In its second phase it makes illusions of itself and hides behind a turning crystal aegis."
		""
		"&o\"Every ruin has a before.\"&r"
	]
	quest.245A28BBE7AF789F.quest_subtitle: "The Forgotten Observatory."
	quest.245A28BBE7AF789F.title: "&6The Forgotten Watcher"
	quest.24B421000D19B905.quest_desc: [
		"A &6Sophisticated Chest&r is planks around a lever, or a chest and a lever. Surround it with iron for an &6Iron Chest&r, or use a &6Tier Upgrade&r on a placed chest to grow it where it stands."
		""
		"More room, room for upgrades, and nothing spilled. Barrels work the same way."
	]
	quest.24B421000D19B905.quest_subtitle: "The larder outgrew the larder."
	quest.24B421000D19B905.title: "Chests That Grow"
	quest.24F3E0341FB78846.quest_desc: [
		"When the sun went out, one city tried to hide from the dark by digging into it. It dug too deep."
		""
		"The &6Lost Soul City&r lies under the forests, hills and plains. Bring light, and a way back up."
	]
	quest.24F3E0341FB78846.quest_subtitle: "Philip's Ruins. A city that went underground."
	quest.24F3E0341FB78846.title: "The Lost Soul City"
	quest.25DE78C170374A07.quest_desc: [
		"Netherite was Morgrath's metal, and it remembers being his. It won't let just anyone carry it."
		""
		"&7Netherite weapons and armour refuse anyone below &6level 30&7 in the matching attribute (Attack Power for weapons, Protection for armour). Make a netherite ingot."
	]
	quest.25DE78C170374A07.quest_subtitle: "Attribute 30. The metal knows."
	quest.25DE78C170374A07.title: "Worthy of Netherite"
	quest.262E107A9CDDD1B5.quest_desc: [
		"Every piece of &6Reinforced Golden Armor&r you wear makes the sellswords near you hit &a3%&r harder. A full set is twelve."
		""
		"It also gives you the unmistakable look of someone who pays on time, which does more for morale than any speech."
	]
	quest.262E107A9CDDD1B5.quest_subtitle: "The look of someone who pays on time."
	quest.262E107A9CDDD1B5.title: "Dressed in Gold"
	quest.267A34C74D5C4387.quest_desc: [
		"Cook a &6feast&r (a Roast Chicken, a Stuffed Pumpkin, a Honey Glazed Ham or a Shepherd's Pie) and set it down. Anyone with a bowl can take a serving."
		""
		"The sellswords of the Ashen Company will fight for gold. They'll stay for this."
	]
	quest.267A34C74D5C4387.quest_subtitle: "Some meals are meant for the whole village."
	quest.267A34C74D5C4387.title: "&aA Glorious Feast"
	quest.26BA4E1B73379C8E.quest_desc: [
		"The Archive Core is now the &6Curator Gateway&r. Carry the &6Curator Core&r and your repaired Lens and step through into the &6Fractured Archive&r: floor after floor rebuilt from what the archivists never finished."
		""
		"It keeps its own death rules. Your party shares its revives, a &6Recalled Hour&r buys one back, and no Echo rises there."
	]
	quest.26BA4E1B73379C8E.quest_subtitle: "Every recollection they failed to finish."
	quest.26BA4E1B73379C8E.title: "&eBeyond the Curator's Gate"
	quest.26F13D2CFD0BD33F.quest_desc: [
		"Brew plain &6beer&r first: water, wheat, seeds and a brown mushroom. Then ferment that beer again with beetroot, potato, another mushroom and a strip of &6jerky&r."
		""
		"&6Strongroot Ale&r is a miner's drink. It makes a long day underground feel shorter, and the walk home feel longer."
	]
	quest.26F13D2CFD0BD33F.quest_subtitle: "Beer, improved by things that grow underground."
	quest.26F13D2CFD0BD33F.title: "Strongroot Ale"
	quest.27437F0D8FF32DCD.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Dusk Rider kept the hours for the Crown. When the sun went out, he stopped his clock at that minute, and he has been riding at that minute ever since.\"&r"
		""
		"The first Sovereign is the &6Dusk Rider&r, Who Rides When Light Fails: herald of evening, keeper of the Crown's hours. His token is a &6clock&r. He never forgot what time it was when the sun went out."
		""
		"&7Gather six &6Sovereign Fragments&7 and a clock."
	]
	quest.27437F0D8FF32DCD.quest_subtitle: "A Sovereign answers six Fragments and a token."
	quest.27437F0D8FF32DCD.title: "Six Pieces of the Sun"
	quest.2753FFA19D2803D5.quest_desc: [
		"It remembers everything except why. A &6Lens of Memory&r wakes it in the dome of its observatory."
		""
		"It fires rings of memory bolts and a beam, then blinks between four lens platforms. In its second phase come the illusions and a crystal aegis: find the real one and break the shield."
	]
	quest.2753FFA19D2803D5.quest_subtitle: "The Forgotten Observatory. Level 85."
	quest.2753FFA19D2803D5.title: "The Forgotten Watcher"
	quest.27B8119DAEAD1FB1.quest_desc: [
		"Visit all seven: the Cottage, the Harbour Pier, the Lighthouse, the Stilt Shack, the Ice Fishing Camp, the River Boathouse and, under twelve blocks of water, the &6Sunken Trawler&r."
		""
		"&7The captain's chest on the trawler sometimes holds a Heart of the Sea. The drowned deckhands would rather it didn't."
	]
	quest.27B8119DAEAD1FB1.quest_subtitle: "Seven places on the water."
	quest.27B8119DAEAD1FB1.title: "&aCoastal Wanderer"
	quest.282CFDC633090E33.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Strange, killing yourself. It gets easier. That should worry you more than it does.\"&r"
		""
		"An Echo fights the way you fought when you died: same weapon, same habits, same mistakes. Learn from them before it does."
		""
		"&7Kill your Echo and reclaim your runes."
	]
	quest.282CFDC633090E33.quest_subtitle: "Take back what's yours."
	quest.282CFDC633090E33.title: "Not This Time"
	quest.282F5F9817BEE567.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Company? Survivors. They stayed together and they stayed paid, which is more than the Sovereigns managed.\"&r"
		""
		"The &6Ashen Company&r has no flag, no country and no god. Their captain keeps a ledger of every sellsword who ever drew Company pay, and reads the names aloud on Hunter's Moons."
		""
		"&7Sellswords loiter near village bells. Use &6gold ingots&7 on one to hire it. Each has a class (Bulwark, Skirmisher, Ranger, Mender, Arcanist), a trait and an epithet it earned somewhere you weren't. Hold &eG&7 for the command wheel; &eU&7 opens your roster and every ally's &6Chronicle&7."
		""
		"&o\"Don't get attached. Or do. They'll be remembered either way.\"&r"
	]
	quest.282F5F9817BEE567.quest_subtitle: "They fight for gold, not causes."
	quest.282F5F9817BEE567.title: "The Ashen Company"
	quest.28475B28C255FDD9.quest_desc: [
		"A hulking frost beast sleeps in the snow, curled around a crystal of the Matron's ice like a dog around a bone. It breathes winter and leaps like a falling glacier."
		""
		"&7Kill the Frostmaw. Its &bIce Crystal&7 freezes everything around its bearer."
	]
	quest.28475B28C255FDD9.quest_subtitle: "Snowy peaks. Something big sleeps there."
	quest.28475B28C255FDD9.title: "The Frostmaw"
	quest.285823D079E22842.quest_desc: [
		"Four amethyst shards, two diamonds, a book, a &6Fire Rune&r and a &bWater Rune&r make a &6Remnant Tome&r. Read it for one more &6skill point&r."
		""
		"Each Ashborn can only read so many, twenty in a lifetime, which in your case is a technical term."
	]
	quest.285823D079E22842.quest_subtitle: "One more star, bought and paid for."
	quest.285823D079E22842.title: "The Remnant Tome"
	quest.289D0416C0109482.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Crown was made to hold the sun. Every piece still remembers how. Wear it, and it will try to hold you.\"&r"
		""
		"Every Sovereign but the Dusk Rider leaves a &6Crown Shard&r: a fragment of the Sun-Crown, each with a lasting boon. Six Sovereigns, six shards. The seventh piece was never a Sovereign's to keep."
		""
		"&7Equip the shard at a shrine."
	]
	quest.289D0416C0109482.quest_subtitle: "Wear a piece of the broken sun."
	quest.289D0416C0109482.title: "A Shard of the Crown"
	quest.28C2D4799B0F9121.quest_desc: [
		"&o\"Bring me what the dead leave behind. I'll make it sing.\"&r &7— the Smith Under Ash&r"
		""
		"An armament deals up to five kinds of damage (&7physical&r, &bmagic&r, &6fire&r, &elightning&r, &fholy&r), scales with your attributes on grades from &6S&r down to &7E&r, and lists what it requires. Wield one you don't qualify for and it hits like an apology."
		""
		"Hold &eShift&r over an armament to read it. The dead drop them; the shrine &6Merchant&r stocks more as Sovereigns fall."
	]
	quest.28C2D4799B0F9121.quest_subtitle: "Bring me what the dead leave behind."
	quest.28C2D4799B0F9121.title: "&eThe Armory"
	quest.28DE5885F44FB7AB.quest_desc: [
		"Your map is parchment and ink, fogged over every land you haven't walked. &eN&r hides the minimap, &eM&r opens the world map, &eB&r places a marker."
		""
		"Shrines don't mark themselves. Stand at yours, press &eB&r and pick the &6Site of Grace&r emblem. On the world map, &eG&r lists every grace you've marked."
		""
		"Where you die, the map leaves a &cBloodstain&r (it keeps the last three). Your last bed is your &aResting Place&r."
	]
	quest.28DE5885F44FB7AB.quest_subtitle: "Mark the fires. The map remembers the rest."
	quest.28DE5885F44FB7AB.title: "Ink and Grace"
	quest.295933238D4366D9.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Odric kept this gate for the heralds. Kept it well. When the heralds died, nobody told him to stop.\"&r"
		""
		"The &6Threshold&r was the heralds' crypt, where the Crown laid its light-bearers to rest. &6Ser Odric&r was their gatekeeper, sworn to keep the dead from leaving. The Eclipse made that oath very busy."
		""
		"&7Beyond the fog in the Hall of Messages, Odric waits. Fall to him once and the &6Ember Door&7 in the crypt opens anyway, but felling him is worth it. Watch for his &cAsh Slam&7: a roar, a ring of smoke, then a blast. Roll out of it, or roll through."
	]
	quest.295933238D4366D9.quest_subtitle: "Ser Odric was told not to let anyone leave."
	quest.295933238D4366D9.title: "&6Gatekeeper of the Threshold"
	quest.299D979D228918F3.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Nights are longer than they used to be. Or we are smaller. Light a fire and don't argue with the dark.\"&r"
		""
		"Torches keep the small things away. Beds skip the worst of it. Neither will save you from what comes on a &cred moon&r."
		""
		"&7Make a bed and carry torches."
	]
	quest.299D979D228918F3.quest_subtitle: "Light holds the dark back. For now."
	quest.299D979D228918F3.title: "The First Night"
	quest.29E73181EF9F52B4.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Light hoarded is light wasted. The Sovereigns learned that too late. Spend yours.\"&r"
		""
		"At a shrine, runes become flesh. The old heralds called it &oattunement&r: letting a scrap of sun decide what kind of person you'll be."
		""
		"&7Choose &6Level Up&7. Each rune level raises one of eight attributes (Vigor, Mind, Endurance, Strength, Dexterity, Intelligence, Faith, Arcane) and grants &6RPG levels&7 for your &eK&7 screen. Your armament shows a scaling grade per attribute (&6S&7 to &7E). Feed the ones your weapon loves."
	]
	quest.29E73181EF9F52B4.quest_subtitle: "Runes become strength at the shrine."
	quest.29E73181EF9F52B4.title: "Spend Your Light"
	quest.29FDDC247E8E25AD.quest_desc: [
		"A &6Mechanical Mixer&r over a &6Basin&r combines whatever you drop in."
		""
		"Some recipes want heat beneath the basin, and only a &6Blaze Burner&r gives enough of it."
	]
	quest.29FDDC247E8E25AD.quest_subtitle: "A basin, and a whisk the size of a man."
	quest.29FDDC247E8E25AD.title: "Mixing It Up"
	quest.2A6B94BDD99CE7BC.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"You're not strong yet. So don't be there when it lands.\"&r"
		""
		"The dead don't tire. You do. Every swing and every dodge spends &astamina&r, the green bar, and a blow struck while exhausted lands at a fraction of its strength."
		""
		"&7Tap &eLeft Alt&7 to &6roll&7: for a heartbeat nothing can touch you. Learn the timing on zombies; you'll need it on things that aren't zombies. Weapon arts (&eR&7) cost &bFP&7, the blue bar. Both refill at an Ember Shrine."
	]
	quest.2A6B94BDD99CE7BC.quest_subtitle: "Stamina, and the roll that saves you."
	quest.2A6B94BDD99CE7BC.title: "The Breath Between Blows"
	quest.2A7E4FBEE8E2A089.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"One ember. Look at it, Ashborn. The first light in an age that came back on its own. Every Ashborn on this world just felt their heart beat a little stronger. That was you. The dark felt it too. It will send something worse.\"&r"
		""
		"The Dusk Rider still makes his rounds: the same road, the same minute, forever. Break his clock and the evening will finally end."
		""
		"&7Use the Sigil at night, in the open, with full flasks. He rides; you don't. Roll &othrough&7 the charge, not away from it, and punish him when he turns. If he dismounts, he's angry, not beaten. Felling a Sovereign rekindles one of the eight embers of the &6Long Eclipse&7 and gives every player a permanent heart."
	]
	quest.2A7E4FBEE8E2A089.quest_subtitle: "Who Rides When Light Fails. Level 15."
	quest.2A7E4FBEE8E2A089.title: "&6Sovereign: The Dusk Rider"
	quest.2AE288B066F21681.quest_desc: [
		"Use an &6Empty Blaze Burner&r on a living blaze to trap it inside. Feed it fuel and it heats whatever sits above it."
		""
		"Blazes live in the &cAshlands&r. Bring a shield, or several."
	]
	quest.2AE288B066F21681.quest_subtitle: "Bottle a blaze. Be polite about it."
	quest.2AE288B066F21681.title: "A Fire That Watches Back"
	quest.2BACE57C368EB864.quest_desc: [
		"A &6Windmill Bearing&r with &6sails&r attached turns in any weather, far from any river. More sails, more stress capacity."
	]
	quest.2BACE57C368EB864.quest_subtitle: "The wind doesn't care about the sun either."
	quest.2BACE57C368EB864.title: "A Mild Breeze"
	quest.2BC2703123E27B5A.quest_desc: [
		"The oldest thing in the sea keeps a relic in its monument, and it would like you to stop mining, thank you."
		""
		"Bring Water Breathing and milk for the fatigue. Break line of sight when its eye starts to glow; doors hold air."
	]
	quest.2BC2703123E27B5A.quest_subtitle: "Old Power. An ocean monument. Level 30."
	quest.2BC2703123E27B5A.title: "&5The Elder Guardian"
	quest.2C20532DADD2D13F.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"One fire is a home. Two fires is a road. Ten fires, and the dark starts to feel crowded.\"&r"
		""
		"Kindled shrines remember each other. Step into one and you can step out of another, as if the light were a single room with many doors."
		""
		"&7Kindle a second shrine far from the first, then travel between them from the shrine menu. The Remnants Minimap marks every shrine you kindle as a Site of Grace."
	]
	quest.2C20532DADD2D13F.quest_subtitle: "Two fires, one road."
	quest.2C20532DADD2D13F.title: "Paths of Ember"
	quest.2C9C1A4E43C75D9E.quest_desc: [
		"A &6reaper&r is a scythe made for people. &6Spinning Reap&r: a wide circle that doubles status build-up."
		""
		"The &6Grave Scythe&r bleeds them; &6Winter's Reaping Hook&r freezes them. The harvest is always ready."
	]
	quest.2C9C1A4E43C75D9E.quest_subtitle: "Reapers"
	quest.2C9C1A4E43C75D9E.title: "The Harvest"
	quest.2CB0F847FFAEAE21.quest_desc: [
		"Build a &6Stove&r from bricks, iron and a campfire, and set a &6Cooking Pot&r on it. Any heat beneath will do; the stove just does it with dignity."
		""
		"The pot takes up to six ingredients and a bowl, and gives back meals that keep you going far longer than raw meat ever did."
		""
		"&o\"A shrine warms the dead. A stove warms the living. Keep both lit.\"&r"
	]
	quest.2CB0F847FFAEAE21.quest_subtitle: "A stove, a pot, a reason to come home."
	quest.2CB0F847FFAEAE21.title: "&aDinner's Served"
	quest.2CD95D9E03D2D57F.quest_desc: [
		"Mend the Lens. The recipe viewer knows what the glass wants: Yesterglass, a Lenswork Crystal and a Chronicle Shard around the cracked one."
		""
		"&o\"A repaired Lens does not invent a past. It only agrees to see one.\"&r &7— the Archivist's Journal&r"
	]
	quest.2CD95D9E03D2D57F.quest_subtitle: "The glass remembers what stone forgets."
	quest.2CD95D9E03D2D57F.title: "Through Yesterglass"
	quest.2D0B1E132CA6FE68.quest_desc: [
		"The ash from the Long Eclipse fell everywhere. In one stretch of savanna, it never blew away."
		""
		"Stand in the &6Ashen Savanna&r. You'll feel right at home, Ashborn."
	]
	quest.2D0B1E132CA6FE68.quest_subtitle: "Terralith. The Ashen Savanna."
	quest.2D0B1E132CA6FE68.title: "Where the Ash Settled"
	quest.2D462FB5D6B13E35.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"There. Do you see it? First fire in an age that wasn't stolen. Last Light, we'll call this place. The dark can count, Ashborn. Let's give it a number it doesn't like.\"&r"
		""
		"A kindled shrine takes its name from the land around it, the way a candle takes the shape of the room. This one becomes &6Last Light&r: your home, and in time a home to others."
		""
		"&7Craft the &6Ember Shrine&7, set it down in the village and kindle it. Rest there to heal, refill your &6Ember&7 and &bAzure&7 flasks and bind your respawn. Spend runes there to grow."
	]
	quest.2D462FB5D6B13E35.quest_subtitle: "The first shrine in an age."
	quest.2D462FB5D6B13E35.title: "&6Ember in the Dark"
	quest.2DA0C51A5F99227F.quest_desc: [
		"Some ancient cities hide a frame of reinforced sculk. Beyond it lies the &5Otherside&r: an echo of the world the Wardens remember, preserved the way a shell keeps the sound of the sea. The &5Stalker&r hunts there."
		""
		"&7Enter the Otherside."
	]
	quest.2DA0C51A5F99227F.quest_subtitle: "Below the deep dark, something deeper."
	quest.2DA0C51A5F99227F.title: "The Otherside"
	quest.2DC4BEB2E6A7F2FE.quest_desc: [
		"Craft an &6Architect Core&r (glass panes, amethyst and a compass) and combine it with your wand in a crafting grid. Click two corners for a line, wall, floor, box or cube; click a centre, then an edge, for a circle or a ring."
		""
		"&7Angel, Exchange and Destruction cores fit the same way."
		""
		"A ring of stone around Last Light won't stop a Sovereign. It will stop most of what comes before one."
	]
	quest.2DC4BEB2E6A7F2FE.quest_subtitle: "Lines, walls, rings. Geometry against the dark."
	quest.2DC4BEB2E6A7F2FE.title: "The Architect's Core"
	quest.2DF3735F3E3A787F.quest_desc: [
		"&6Hammers&r don't care where the armour is. &6Earthshaker&r drives the head into the ground and throws foes skyward. The &6Iron Warhammer&r: simple, solid, final."
		""
		"&6Great hammers&r do it bigger and slower. The &6Titan's Gavel&r asks for 30 Strength and delivers judgement by weight."
	]
	quest.2DF3735F3E3A787F.quest_subtitle: "Hammers and great hammers"
	quest.2DF3735F3E3A787F.title: "Blunt Instruments"
	quest.2EB4D681607450E6.quest_desc: [
		"Villa, Spire, Keep and Crypt. Four doors the Sovereigns' servants locked, and you walked through every one."
		""
		"&o\"Most people follow a treasure map once. You followed four. That's not luck, that's a habit.\"&r"
	]
	quest.2EB4D681607450E6.quest_subtitle: "All four dungeons."
	quest.2EB4D681607450E6.title: "&6Dungeon Delver"
	quest.2F015422EDB1358D.quest_desc: [
		"&o\"Gold up front. Graves are extra.\"&r &7— Maren, Captain of the Ashen Company&r"
		""
		"A sellsword's price is paid in &6gold ingots&r, used on the sellsword itself: a handful at level 1, and a few more for every level of experience it brings with it. They loiter near village bells, waiting for someone solvent."
		""
		"Hire a second."
	]
	quest.2F015422EDB1358D.quest_subtitle: "One is a bodyguard. Two is a warband."
	quest.2F015422EDB1358D.title: "&eMuster"
	quest.2F549134AFB15975.quest_desc: [
		"Below the ancient cities lies the &6Otherside&r, littered with &6Ancient Vases&r. Most hold loot. Break the wrong one and a &6Stalker&r climbs out."
		""
		"It hunts by sound, like the Warden, and dims your sight. It's slow to start: hit it while it's still emerging, then get clear before the shockwave ring."
	]
	quest.2F549134AFB15975.quest_subtitle: "Deeper and Darker. The Otherside. Level 50."
	quest.2F549134AFB15975.title: "The Stalker"
	quest.2FA2ABAB39D5D95B.quest_desc: [
		"Six prisons. The &6Catacombs&r, the &6Tomb&r and the &6Warrens&r you know. The &6Rimefrost Vaults&r lie under the snow, the &6Abyssal Halls&r deep under everything, and the &6Infernal Bastille&r burns in the Ashlands."
		""
		"Enter them all. Whether you leave each one is, technically, a separate matter."
	]
	quest.2FA2ABAB39D5D95B.quest_subtitle: "All six Labyrinths."
	quest.2FA2ABAB39D5D95B.title: "&6Into Every Maze"
	quest.2FA9F80D569FB325.quest_desc: [
		"Every swing and every roll spends &astamina&r. It comes back fast the moment you stop. Fight it down to nothing and your blows land at &c60%&r."
		""
		"Tap &eLeft Alt&r to &6roll&r. A roll costs nearly two straight-sword swings, and for a third of a second nothing can touch you. Roll &ointo&r the blow, not away from it."
		""
		"Spiders leap. Roll under the leap and cut as it lands."
	]
	quest.2FA9F80D569FB325.quest_subtitle: "Stamina, and the roll that saves you."
	quest.2FA9F80D569FB325.title: "The Green Bar"
	quest.2FBD8F55F6E3206B.quest_desc: [
		"Loot chests in dungeons, ruins and towers are &6per-player&r: everyone who opens one gets their own roll, and nobody takes a companion's share."
		""
		"Open ten of them. A loot chest looks different once you've opened it, so you always know which ones are left."
	]
	quest.2FBD8F55F6E3206B.quest_subtitle: "The dead hoard. Fairly, now."
	quest.2FBD8F55F6E3206B.title: "Everyone's Share"
	quest.2FC050ACF53FEE8A.quest_desc: [
		"A &6Crafting Terminal&r (crafting table, chest, redstone torch and a diamond) set against a chest, or against your Storage Controller, shows everything inside in one scrolling view, with a crafting grid beside it."
		""
		"&o\"I've seen Sovereigns' treasuries kept worse.\"&r"
	]
	quest.2FC050ACF53FEE8A.quest_subtitle: "Every chest at once, and a table to work at."
	quest.2FC050ACF53FEE8A.title: "&aThe Crafting Terminal"
	quest.2FF7CCB355D5CBF4.quest_desc: [
		"A &6Feeding Upgrade&r eats for you from the backpack whenever you're hungry. Stock it from the Hearth & Harvest kitchen and stop opening your inventory in the middle of a fight."
	]
	quest.2FF7CCB355D5CBF4.quest_subtitle: "Eat without stopping."
	quest.2FF7CCB355D5CBF4.title: "The Pack That Feeds You"
	quest.30007ED76BC15B2D.quest_desc: [
		"&o\"The Ashlands burn without fuel. That's the blazes. Fewer blazes, less burning. Simple sums.\"&r"
		""
		"Kill &c10 blazes&r. A shield catches fireballs; a bow catches blazes."
	]
	quest.30007ED76BC15B2D.quest_subtitle: "Major bounty · 10 blazes · the Ashlands"
	quest.30007ED76BC15B2D.title: "Contract: Ash and Embers"
	quest.304ECA06BDAE1D37.quest_desc: [
		"The Company's old smiths still work gold. An &6Upgrade Template&r (gold ingots around obsidian and an amethyst shard), a golden piece and an &6amethyst block&r make &6Reinforced Golden&r gear at a smithing table."
		""
		"&o\"Everyone in the Company was paid in gold once. The clever ones wore it.\"&r"
	]
	quest.304ECA06BDAE1D37.quest_subtitle: "Gold is soft. Reinforced gold only looks it."
	quest.304ECA06BDAE1D37.title: "Gilded Regalia"
	quest.3064A853B6E7131C.quest_desc: [
		"The first Remnant of all sleeps under a pyramid in the desert. Brush the suspicious sand inside for the &6Necklace of the Desert&r, and it wakes."
		""
		"It charges in straight lines and calls up sandstorms. Roll its charge sideways, and keep your distance while the storms are up."
	]
	quest.3064A853B6E7131C.quest_subtitle: "The Cursed Pyramid. Level 40."
	quest.3064A853B6E7131C.title: "&cThe Ancient Remnant"
	quest.30868611AB85833E.quest_desc: [
		"Ranks climb &7Common&r, &fVeteran&r, &9Elite&r, &5Champion&r, and finally &cRemnant&r. Every rank adds traits and pays more Valor."
		""
		"About one monster in seventy is an &9Elite&r. Slay one, and look at what dropped."
	]
	quest.30868611AB85833E.quest_subtitle: "Blue crest. Two traits."
	quest.30868611AB85833E.title: "Elite"
	quest.30A32CEC43EA5DB9.quest_desc: [
		"Standard armaments climb to &6+25&r on &6Tempering Stones&r. Each grade carries three steps (I takes +0 to +3, II to +6, on to VIII at +24), and a &6Sovereign Tempering Stone&r makes the last."
		""
		"The dead drop stones now and then, champions by the handful, and the Merchant sells I to V. Reinforce at a shrine: runes and stones."
		""
		"Take an armament to &6+10&r."
	]
	quest.30A32CEC43EA5DB9.quest_subtitle: "Three steps to a stone."
	quest.30A32CEC43EA5DB9.title: "Tempered Steel"
	quest.30F39C23D463CB31.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Every guardian carries a map to someone worse. Nobody knows who started the chain. Nobody's reached the end and come back to say.\"&r"
		""
		"Four strongholds, four Guardians, one trail of maps. The Company swears the trail was laid by a Sovereign's quartermaster to hide something. The Archivist swears it was a joke. Both have lost people to it."
		""
		"&7Start with the &6Smuggler's Villa&7 and kill its chief."
	]
	quest.30F39C23D463CB31.quest_subtitle: "Smugglers, mages, warlords."
	quest.30F39C23D463CB31.title: "The Dungeon Trail"
	quest.311060BEC208E673.quest_desc: [
		"A floating fist of black iron in a buried arena. It punches, it fires lasers, and most of the time you might as well be hitting a wall."
		""
		"Wait for the eye in its palm to open. That's the fight. Everything else is not getting hit while you wait."
	]
	quest.311060BEC208E673.quest_subtitle: "An arena under the Ashlands. Level 55."
	quest.311060BEC208E673.title: "The Nether Gauntlet"
	quest.316111022AD294F3.quest_desc: [
		"One monster in three hundred is a &5Champion&r. Not the gold-titled kind that carries Sovereign Fragments; that's a different curse. This one is just bigger, meaner and better paid."
		""
		"Get close enough to read its three traits, then decide whether you're staying."
	]
	quest.316111022AD294F3.quest_subtitle: "Purple crest. Three traits. Bad news."
	quest.316111022AD294F3.title: "Champion"
	quest.321336B72E8417EC.quest_desc: [
		"Take the &6Relic of the Dusk Rider&r to a shrine and open &6Relics&r. It becomes one of two: the &6Duskrider Glaive&r, a halberd for Strength and Dexterity, or the &6Sunlit Sword&r, holy steel for &eFaith&r."
		""
		"Choose the one your attributes can carry. The relic is spent either way."
	]
	quest.321336B72E8417EC.quest_subtitle: "A relic remembers what its owner carried."
	quest.321336B72E8417EC.title: "Relic of the Dusk Rider"
	quest.322940C8C88BF0BD.quest_desc: [
		"A &6Keg&r (iron, planks and a honeycomb) ferments drinks and cheese from a base liquid and up to four ingredients. Pour from it into &6tankards&r."
		""
		"Some brews want warmth, some want cold. A &6Heating Cask&r or an &6Ice Crate&r next to the keg shifts its temperature."
		""
		"&o\"The Company says it can't fight sober. I've seen it fight drunk. Brew anyway.\"&r"
	]
	quest.322940C8C88BF0BD.quest_subtitle: "Patience, in a barrel."
	quest.322940C8C88BF0BD.title: "Here Starts the Process"
	quest.3231A33EEC9969F2.quest_desc: [
		"The villagers of Last Light talk. Stand close and say something in chat; they answer in speech bubbles. Ask one for work."
		""
		"Accept the request (&e/villagerai request accept&r) and see it through: fetch what they need, or kill what's bothering them. They pay in emeralds, and they remember."
	]
	quest.3231A33EEC9969F2.quest_subtitle: "The villagers have problems too. Smaller ones."
	quest.3231A33EEC9969F2.title: "A Favour for a Friend"
	quest.3247E2B74E352B87.quest_desc: [
		"Finish &6ten&r villager requests. Word spreads: your standing climbs from stranger to friend to &6hero&r, and heroes get better prices."
		""
		"&7Gossip carries about 48 blocks. So does a bad reputation."
	]
	quest.3247E2B74E352B87.quest_subtitle: "Ten favours. They'll name a well after you."
	quest.3247E2B74E352B87.title: "Hero of the Village Square"
	quest.33073B9049935075.quest_desc: [
		"On about one full moon in three, a toll sounds and the &cHunter's Moon&r rises. Until dawn, monsters spawn five levels stronger, ranks come twice as often and shards drop double."
		""
		"An icon on your HUD tells you it's up. Survive one first. Then learn to farm it."
	]
	quest.33073B9049935075.quest_subtitle: "Some full moons come up red."
	quest.33073B9049935075.title: "The Hunter's Moon"
	quest.3317D34188380A48.quest_desc: [
		"&o\"The Realm's dead are organised. I respect that. Kill them anyway.\"&r"
		""
		"Kill &c8 Gravebound Soldiers&r and &c4 Crypt Lurkers&r. The &6Grave Iron&r they carry forges the Crypt Key."
	]
	quest.3317D34188380A48.quest_subtitle: "Grave bounty · the Eclipsed Realm"
	quest.3317D34188380A48.title: "Contract: The Cryptborn"
	quest.337E61B442FEAD4C.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Fifty levels of light. You glow, you know. Not so anyone else could see. But I can.\"&r"
		""
		"You are no longer the weakest thing in the ash. Remnants that once hunted you now hesitate at the edge of your torchlight."
		""
		"&7Reach rune level 50."
	]
	quest.337E61B442FEAD4C.quest_subtitle: "Rune level 50."
	quest.337E61B442FEAD4C.title: "Runebearer"
	quest.3463E48C851C4E39.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Sovereigns couldn't kill everything they feared. So they dug.\"&r"
		""
		"Under the plains lie the &6Forgotten Catacombs&r, the first of the &6Labyrinths&r: prisons the Sovereigns dug for things they couldn't kill. A Bone Warden still keeps its heart, though nobody remembers who it was told to keep in."
		""
		"&7Find the Catacombs and break their warden."
	]
	quest.3463E48C851C4E39.quest_subtitle: "The Sovereigns built prisons under the world."
	quest.3463E48C851C4E39.title: "Into Every Maze"
	quest.34B0A6FBE6926ED4.quest_desc: [
		"A flower the size of a chapel, rooted in a cavern far below the surface. It can't move, so it makes sure you can't either."
		""
		"Thorns erupt under your feet, petals fly and spores linger. Keep your feet moving between volleys and cut it down while it reloads."
	]
	quest.34B0A6FBE6926ED4.quest_subtitle: "A cavern deep underground. Level 35."
	quest.34B0A6FBE6926ED4.title: "The Void Blossom"
	quest.354182D19FF9BB17.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"It can't see you. It doesn't need to. Every heart is a drum to it, and yours is louder than most.\"&r"
		""
		"The Warden was set to guard the deep cities when their builders left, and told to listen. It has been listening ever since, and it has grown very, very tired of what it hears."
		""
		"&7It's blind, it hears your heartbeat and it hits harder than anything you've met. You don't have to fight fair. Its Relic becomes &6Shadowfang&7, the dagger that strikes from where you are not."
	]
	quest.354182D19FF9BB17.quest_subtitle: "Old Power: the Warden."
	quest.354182D19FF9BB17.title: "&5The Listener"
	quest.358480A0A0312181.quest_desc: [
		"&o\"A shrine makes a place you come back to. A table makes it a place you'd want to.\"&r"
		""
		"Craft a &6table&r and a &6chair&r from any wood. Handcrafted furniture can be sat on, set with plates and cups, and dressed with cushions and sheets."
		""
		"The village has a name now. Give it a hall."
	]
	quest.358480A0A0312181.quest_subtitle: "Last Light needs more than a fire."
	quest.358480A0A0312181.title: "&aA Home Worth Defending"
	quest.358A39F760C2C389.quest_desc: [
		"Hold &eG&r for the &6command wheel&r: &aFollow&r, &cCharge&r, &6Focus&r your target, &eHold&r here, &7Fall back&r, &6Guard banner&r, &6Formation&r and &6Recall&r."
		""
		"They follow you through doors, dimensions and the odd logout. If one gets lost anyway, &6Recall&r brings it back."
	]
	quest.358A39F760C2C389.quest_subtitle: "They listen. Mostly."
	quest.358A39F760C2C389.title: "The Command Wheel"
	quest.3598EAD366B19674.quest_desc: [
		"The Eighth. A crown with nothing inside, on a throne under the black sun."
		""
		"An axe breaks his guard. At two thirds he sends his pauldrons and his spectral guard; at one third, crescents and a lunge. At the very end he gives &c\"The Last Command\"&r. Keep a flask for it."
	]
	quest.3598EAD366B19674.quest_subtitle: "The Hollow Citadel. Level 100."
	quest.3598EAD366B19674.title: "&6&lThe Hollow Sovereign"
	quest.3675ACCA0A03C6D3.quest_desc: [
		"Every upgrade starts as an &6Upgrade Base&r (iron, leather, string). A &6Pickup Upgrade&r scoops loot into the pack as you walk; set its filter so it leaves the rotten flesh where it fell."
		""
		"Magnet, crafting, smelting, compacting, void: there are dozens more, and JEI has every recipe."
	]
	quest.3675ACCA0A03C6D3.quest_subtitle: "A bag that bends over so you don't have to."
	quest.3675ACCA0A03C6D3.title: "Upgrades"
	quest.36E2AF0A1C071B2E.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Quiet down there. Not the polite kind. The kind that is listening back.\"&r"
		""
		"The &8ancient cities&r were built by people who chose the dark before the dark was forced on anyone. Nobody knows why. Their streets are still lit by soul fire, and something still walks them."
		""
		"&7Find an ancient city in the deep dark."
	]
	quest.36E2AF0A1C071B2E.quest_subtitle: "The dark was here before the Eclipse."
	quest.36E2AF0A1C071B2E.title: "&6The Deep"
	quest.372FD165139361F2.quest_desc: [
		"Villages have &6guards&r now: villagers who picked up a sword when the dark came and never put it down."
		""
		"Give a sword to a villager with no trade, and you've got another one. Last Light could use the help."
	]
	quest.372FD165139361F2.quest_subtitle: "Guard Villagers. A village that fights back."
	quest.372FD165139361F2.title: "We Want You"
	quest.3785FC1657322281.quest_desc: [
		"Banked Renown raises your &6Archive Codex&r (&eY&r) from level 1 to 30, and each level is an &6Insight&r to spend: Last Stand, Keymaker, Hoarder, Second Draft and a dozen more. The &6Bestiary&r records every creature you've slain; the &6Hall of Records&r remembers who did it best."
		""
		"Reach Codex level 10."
		""
		"&o\"You collect ruins. I collect befores. Between us we might have one whole world.\"&r &7— Oren&r"
	]
	quest.3785FC1657322281.quest_subtitle: "What the Archive remembers of you."
	quest.3785FC1657322281.title: "Storied"
	quest.37BCA8A9E629FACA.quest_desc: [
		"The &6Ember Flask&r restores health; the &bAzure Flask&r restores FP. Use one to drink. Every charge comes back when you rest, and the shrine's &6Flasks&r service splits your charges between the two."
		""
		"A &6Sunseed&r adds a charge, up to fourteen. A &6Hallowed Tear&r makes every sip stronger. Champions and Sovereigns carry them, and the Keeper will part with a Sunseed for enough shards and gold."
	]
	quest.37BCA8A9E629FACA.quest_subtitle: "Tears of the shrine flame."
	quest.37BCA8A9E629FACA.title: "Ember and Azure"
	quest.38273B3664CCA777.quest_desc: [
		"A &6Fisherman's Cottage&r sits on a sandy or snowy beach. Saylor lives there, and trades things no village fisherman will."
		""
		"The coast has six more places like it, each with its own resident: Harbourmaster Wren, Keeper Morrow, Old Bayou Tam, Frost-Beard Ole, Ferryman Hale… and two deckhands who don't say much anymore."
	]
	quest.38273B3664CCA777.quest_subtitle: "Someone on the shore kept fishing through the end of the world."
	quest.38273B3664CCA777.title: "Home of Saylor"
	quest.3892E9A287EF8059.quest_desc: [
		"The mountains grew in the dark. Ridges climb past the clouds now, and the &6jagged peaks&r are higher than anyone alive has stood."
		""
		"Climb one. From the top you can see three shrines' worth of country, and none of it lit."
	]
	quest.3892E9A287EF8059.quest_subtitle: "Tectonic. The jagged peaks."
	quest.3892E9A287EF8059.title: "The Roof of the World"
	quest.38F1C601D4A43F84.quest_desc: [
		"In &bRemembered&r, watch the Choir of Hours: four steps, each with a light, a silhouette, a pitch and a subtitle. Return to &7Ruin&r and repeat them in order."
		""
		"A wrong cadence costs nothing but pride. Fail often enough and the old mechanism etches the answer for you, which is somehow worse."
	]
	quest.38F1C601D4A43F84.quest_subtitle: "Still keeping time for someone who isn't there."
	quest.38F1C601D4A43F84.title: "The Hours Answer"
	quest.39436CEE9A923B24.quest_desc: [
		"&6Ember Bolt&r, &6Explosive Orb&r, &6Ember Shield&r, &6Inferno Wave&r, and the ultimate, &6Meteor&r."
		""
		"Keystones: &6Pyre Heart&r (burning can't hurt you, and your ignites last twice as long) and &6Glass Cannon&r (40% more ability damage for a quarter of your health). A &6Fire Seed&r, eaten, awakens this origin for free."
	]
	quest.39436CEE9A923B24.quest_subtitle: "Breathe in. Burn out. Again."
	quest.39436CEE9A923B24.title: "&6Pyromancy"
	quest.3990E7B1699C5CBE.quest_desc: [
		"The desert temples go deeper than they used to. Traps, puzzles, a curse that slows your hands, and at the bottom a &6Pharaoh&r who never agreed to leave."
		""
		"Watch the floor, read the walls, and end him. The curse lifts when he does."
	]
	quest.3990E7B1699C5CBE.quest_subtitle: "A temple, a curse, a Pharaoh."
	quest.3990E7B1699C5CBE.title: "Eternal Slumber"
	quest.39A176F019D32804.quest_desc: [
		"&5Blinking&r: when hit, may appear behind you. Turn around before you swing again."
		"&eSwift&r: much faster. Don't run; you'll lose."
		"&cBerserk&r: below half health it hits harder and moves faster. Finish it, or step back and let it come."
		"&7Crushing&r: knocks you far and breaks shields. Stay away from ledges."
		"&6Packleader&r: once wounded, calls lesser copies of itself. Kill it fast or fight the pack in a doorway."
		"&cVolatile&r: explodes shortly after it dies. Step away from the body."
	]
	quest.39A176F019D32804.quest_subtitle: "Traits that change the fight."
	quest.39A176F019D32804.title: "Hard to Pin Down"
	quest.39DE42D02949D134.quest_desc: [
		"Handcrafted &6trophies&r are made from what you take off the dead: a spider's eye, a skeleton's skull, a creeper's head, a phantom's membrane."
		""
		"Hang one above the shrine. The Keeper won't say anything. The Keeper will look at it."
	]
	quest.39DE42D02949D134.quest_subtitle: "Proof, mounted."
	quest.39DE42D02949D134.title: "Trophy Wall"
	quest.3A8B8901F094E14E.quest_desc: [
		"From the tenth night on, the world gets visitors. The chat warns you: &c\"Something powerful is invading this world...\"&r"
		""
		"The &6Supreme Bonescaller&r raises skeletons, then gets up again in a second form. Kill the summons only when they stand between you and him."
		""
		"The &6Nightmare Stalker&r hunts you, not the other way round. Fight it in the light with a wall at your back, and never chase it into the dark."
	]
	quest.3A8B8901F094E14E.quest_subtitle: "Born in Chaos. Level 15–20."
	quest.3A8B8901F094E14E.title: "Invaders of the Tenth Night"
	quest.3B27876F2A33641B.quest_desc: [
		"Every tavern has a &6cartographer&r in the corner, and every cartographer has a map they'd rather sell to someone else."
		""
		"Trade for a quest map and follow it. Taverns know which roads end somewhere interesting."
	]
	quest.3B27876F2A33641B.quest_subtitle: "The cartographer sells more than maps."
	quest.3B27876F2A33641B.title: "Call for Adventure"
	quest.3B2BC7E46FADA8F0.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Don't look at their faces. Some of them used to be someone's.\"&r"
		""
		"The shambling dead are the oldest Remnants: villagers, farmers and soldiers who died in the first dark years and rose before anyone understood what rising meant."
		""
		"&7Every monster carries a &elevel&7 over its head. Levels climb the further you go from where you woke, the deeper you dig and the longer the world lives under the Eclipse. &aGreen&7 is safe. &cRed&7 will kill you. Start with green."
	]
	quest.3B2BC7E46FADA8F0.quest_subtitle: "They were people, once. Mostly."
	quest.3B2BC7E46FADA8F0.title: "First Blood"
	quest.3B605936F1371214.quest_desc: [
		"Someone built a prison in the snowy plains for a cursed warrior and forgot to finish the job."
		""
		"It leaps across the room and rains phantom halberds and arrows. Watch where it jumps, stay mobile, and hit hard every time it lands."
	]
	quest.3B605936F1371214.quest_subtitle: "The Frosted Prison. Level 45."
	quest.3B605936F1371214.title: "Maledictus"
	quest.3B6E842709B2EE5E.quest_desc: [
		"A &6Blank Whetstone&r (smooth stone slabs and flint) plus a reagent makes an &6affinity whetstone&r: iron block for &7Heavy&r, flint and feather for &aKeen&r, lapis block for &bMagic&r, blaze powder and magma cream for &6Fire&r, a lightning rod for &eLightning&r, a golden apple for &fSacred&r, blue ice for &bCold&r. Twelve in all."
		""
		"&6Infuse&r at a shrine to give a standard armament that affinity. The whetstone isn't consumed; the runes are. Unique armaments refuse the stone."
	]
	quest.3B6E842709B2EE5E.quest_subtitle: "Whetstones and affinities."
	quest.3B6E842709B2EE5E.title: "A Keener Edge"
	quest.3BAC2454C42FA6CB.quest_desc: [
		"Use a placed &6Ember Shrine&r to kindle it. &aRest&r restores health and FP, refills your flasks and binds your return there when you fall. You can't rest with enemies close; neither could anyone else, which is why the shrines survived."
		""
		"The menu holds the rest: &6Level Up&r, &6Reinforce&r, &6Infuse&r, &6Flasks&r, &6Travel&r, the &6Merchant&r, &6Relics&r, &6Crown Shards&r and &6Rebirth&r."
	]
	quest.3BAC2454C42FA6CB.quest_subtitle: "Heal, refill, and choose where you wake."
	quest.3BAC2454C42FA6CB.title: "Rest by the Flame"
	quest.3C10E6447520A102.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Down there, the ash is still falling. Do you know what it is?&r"
		""
		"&f&oMorgrath was the proudest of the seven. When he saw the others going mad, he swore no one would rule his kingdom after him. So he burned it. Every field, every hall, every soul who called him king. When it was done, he sat on the ashes and called himself their Sovereign.&r"
		""
		"&f&oThe ash you'll breathe down there was his people, Ashborn. Breathe gently.&r"
		""
		"&f&oPast him, beyond the eye of the world, there is a shore where a drop of the sun fell when the Eighth drank it. The Dragon guards it, and Vaelorn, the last of the seven, guards the Dragon. Two more embers. Then the black sun.\"&r"
		""
		"The &6Ashlands&r were once the Burning Crown, the richest kingdom of the seven. Now they are a furnace that never cools, and their Sovereign still sits on its throne of cinders."
	]
	quest.3C10E6447520A102.quest_subtitle: "The proudest of the seven."
	quest.3C10E6447520A102.title: "&e♪ &6The Tale of the Burning Crown"
	quest.3C86D771B876323D.quest_desc: [
		"Somewhere out there, someone still pours ale for strangers. Find a &6tavern&r."
		""
		"Sit down. Eat something hot. The road will still be dark when you leave."
	]
	quest.3C86D771B876323D.quest_subtitle: "Dungeons and Taverns. A roof, a fire, a drink."
	quest.3C86D771B876323D.title: "Safe Haven"
	quest.3CB7A01DC9399058.quest_desc: [
		"A &6Jar&r stores what bowls, bottles and buckets carry (honey, soup, potions, water), a stack of cookies, or a small living thing."
		""
		"Some Ashborn keep a jar of honey by the shrine. Some keep a jar of something that glows."
	]
	quest.3CB7A01DC9399058.quest_subtitle: "Keep what's precious where you can see it."
	quest.3CB7A01DC9399058.title: "Glass and Patience"
	quest.3D4D4F654A7AA731.quest_desc: [
		"&aMending Light&r, &aThorn Burst&r, &aSanctuary&r, &aRadiant Nova&r, and the ultimate, &aVerdant Rebirth&r."
		""
		"Keystones: &aUndying Grove&r (once every five minutes, a killing blow leaves you standing and roots everything near) and &aVerdant Bloom&r (stronger healing and steady regeneration, for less damage)."
	]
	quest.3D4D4F654A7AA731.quest_subtitle: "Life, stubbornly."
	quest.3D4D4F654A7AA731.title: "&aVerdance"
	quest.3D62A6C30068A419.quest_desc: [
		"Inside the Archive you build yourself from drafts. Clear encounters to discover &6Living Memories&r: abilities like &6Echo Lance&r, &6Parallax Step&r and &6Recall&r on &eH&r, &eO&r and &e`&r, and artifacts that bend them (&6Split Prism&r, &6Storm Filament&r, &6Returning Thread&r…)."
		""
		"&e;&r opens the loadout. They last one expedition. Choose as if it's the only one."
	]
	quest.3D62A6C30068A419.quest_subtitle: "You, rewritten for one expedition."
	quest.3D62A6C30068A419.title: "Living Memories"
	quest.3EB68B3A1BA90389.quest_desc: [
		"Turn a key inside a structure (a dungeon, a temple, a village) and the Archive opens a &6Recollection&r of what it was before. Each place answers once per Ashborn."
		""
		"&o\"A ruin is a story with the middle torn out. Go and read me the middle.\"&r &7— Oren&r"
	]
	quest.3EB68B3A1BA90389.quest_subtitle: "This is what he means by befores."
	quest.3EB68B3A1BA90389.title: "Echo of a Place"
	quest.3F8695952D198BDA.quest_desc: [
		"Press &eI&r for your &6Status&r. The &6Codex&r inside it holds the rules of this world: runes, shrines, flasks, armaments, Sovereigns."
		""
		"This chapter is the margin notes. Each page teaches one system and checks that you've actually used it."
		""
		"&o\"Read it twice. The dead have.\"&r"
	]
	quest.3F8695952D198BDA.quest_subtitle: "All a Runeborn must know."
	quest.3F8695952D198BDA.title: "&eThe Ashen Codex"
	quest.3FD00E03D41C5E6B.quest_desc: [
		"A &6greatsword&r costs eighteen stamina a swing and is worth it. &6Leaping Cleave&r brings the full weight down from the air. The &6Highland Claymore&r is the honest start."
		""
		"A &6colossal sword&r is less a sword than a falling wall: twenty-six stamina a swing and &6Ruinous Charge&r. The &6Ruinbreaker&r wants 26 Strength before it will move at all."
	]
	quest.3FD00E03D41C5E6B.quest_subtitle: "Greatswords and colossal swords"
	quest.3FD00E03D41C5E6B.title: "The Weight of the Blade"
	quest.41A39FBD20739BC5.quest_desc: [
		"The sea gives back what it takes, one bottle at a time. &6Messages in a Bottle&r turn up on rod lines, in crab pots, in coastal chests."
		""
		"Open one. Some hold treasure, some hold a &6map to a wreck&r, and all of them hold a note from someone who never got home."
	]
	quest.41A39FBD20739BC5.quest_subtitle: "Twelve notes from the sea."
	quest.41A39FBD20739BC5.title: "Message Received"
	quest.41A688DC65EE8C37.quest_desc: [
		"Abilities cost &bEssence&r, a bar of their own, and recharge on a cooldown. Slot up to four from the Constellation screen and cast them with &eZ&r, &eX&r, &eC&r and &eV&r."
		""
		"They never break blocks, and they never hit your allies or your pets. Your sellswords will thank you, in their way."
	]
	quest.41A688DC65EE8C37.quest_subtitle: "The third bar. Yes, really."
	quest.41A688DC65EE8C37.title: "Essence"
	quest.41EDE0DA5C7509EA.quest_desc: [
		"The ocean monuments are halls now, wings and galleries and a throne for an Old Power. Its lesser guardians patrol every corridor."
		""
		"Water Breathing, Night Vision, a door or two for air pockets. Clear the patrols and the monument is yours to search."
	]
	quest.41EDE0DA5C7509EA.quest_subtitle: "An ocean monument, inside and out."
	quest.41EDE0DA5C7509EA.title: "The Drowned Halls"
	quest.41F25821C7A9B085.quest_desc: [
		"&6Morgrath's&r relic becomes the &6Voidstar Hammer&r, which called stars down, or his &6Ashen Greatsword&r, which remembers the burning of the old crown."
		""
		"&6Vaelorn's&r becomes the &6Wyrmfang Halberd&r, cut from his own fang, or the &6Dragonsoul Seal&r: a wyrm's heart, still beating, bound in gold."
	]
	quest.41F25821C7A9B085.quest_subtitle: "Morgrath and Vaelorn"
	quest.41F25821C7A9B085.title: "Ash and Wyrm"
	quest.41F84D93CCC8D01C.quest_desc: [
		"The villa's map points to a tower in the forests and taigas. The &6Arcane Spire&r belongs to a &6Spire Illusionist&r, who prefers you confused."
		""
		"Climb it. Count the copies. Hit the one that bleeds."
	]
	quest.41F84D93CCC8D01C.quest_subtitle: "Tier II: the Arcane Spire."
	quest.41F84D93CCC8D01C.title: "Spellbound Heights"
	quest.42910F1AA9CF2EC8.quest_desc: [
		"&o\"Every one of them carries the Wither on its blade. Don't let it cut you twice.\"&r"
		""
		"Kill &c10 wither skeletons&r in the fortresses of the Ashlands. Withering stops your health coming back; milk stops the withering."
	]
	quest.42910F1AA9CF2EC8.quest_subtitle: "Major bounty · 10 wither skeletons · the Ashlands"
	quest.42910F1AA9CF2EC8.title: "Contract: Black Bones"
	quest.42C35A7C13BD60B5.quest_desc: [
		"Under the ocean lies a &3sunken city&r, drowned when Kaelthar called the sea in. Something vast lives there now, and it drags whatever it catches down into the abyss to keep."
		""
		"&7Bring water breathing. Bring friends. Kill the Leviathan."
	]
	quest.42C35A7C13BD60B5.quest_subtitle: "The sunken city is not empty."
	quest.42C35A7C13BD60B5.title: "The Leviathan"
	quest.42D405F229C89E43.quest_desc: [
		"Six schools ring the Constellation, each with its own &6origin&r: &6Pyromancy&r (fire), &eStormcalling&r (storm), &5Umbral Arts&r (void), &bTidecalling&r (frost), &2Earthshaping&r (earth) and &aVerdance&r (life)."
		""
		"Spend your first point on an origin. The stars beyond it raise that school's damage, your &bEssence&r and your health. Where two schools meet, hybrid notables like &6Plasma Arc&r and &bBlack Ice&r are where builds get strange."
	]
	quest.42D405F229C89E43.quest_subtitle: "Six schools. Pick one to start."
	quest.42D405F229C89E43.title: "Choose a School"
	quest.42FE195A97F774D8.quest_desc: [
		"Land a &6Tuna&r from the open ocean and a &6Catfish&r from a river or lake inland."
		""
		"Fillet the big ones with a &6Fillet Knife&r. A tuna feeds a table. A catfish feeds the village cats, mostly."
	]
	quest.42FE195A97F774D8.quest_subtitle: "Every fisher has a story. Bring proof."
	quest.42FE195A97F774D8.title: "The Ones That Didn't Get Away"
	quest.440BE6E04BADB9D5.quest_desc: [
		"In the Gravefield Barrows the &6Cryptborn&r keep house: rats, lurkers and soldiers that never stopped guarding the dead. Elsewhere drift the &6Forgotten Souls&r, pilgrims and wraiths who lost the thread of who they were."
		""
		"The Cryptborn drop &6Grave Iron&r for a Crypt Key. The souls drop &6Memory Shards&r for a Lens of Memory."
	]
	quest.440BE6E04BADB9D5.quest_subtitle: "The Eclipsed Realm. Cryptborn and Forgotten Souls."
	quest.440BE6E04BADB9D5.title: "The Buried and the Forgotten"
	quest.4433CD98ABE1C906.quest_desc: [
		"&6Level Up&r at a shrine spends runes on one of eight attributes: &6Vigor&r (health), &bMind&r (FP), &aEndurance&r (stamina and poise), &6Strength&r, &6Dexterity&r, &bIntelligence&r, &eFaith&r and &dArcane&r (status and discovery). Your rune level is their sum."
		""
		"Every rune level also grants an &6RPG level&r, with points for your &eK&r screen."
		""
		"Reach rune level 50."
	]
	quest.4433CD98ABE1C906.quest_subtitle: "Two ladders, one climb."
	quest.4433CD98ABE1C906.title: "Runebearer"
	quest.44B9D941A36D68C0.quest_desc: [
		"The jungle temples are bigger, older and meaner than the stories. Tripwires, darts and puzzles that kill you for guessing."
		""
		"Go slowly. Step where the last one didn't."
	]
	quest.44B9D941A36D68C0.quest_subtitle: "The jungle remembers who built it."
	quest.44B9D941A36D68C0.title: "Under the Vines"
	quest.450A6C1D94F44BC6.quest_desc: [
		"&6Fists&r are the fastest thing you can hold: five stamina a swing and no reach to speak of. &6Beast Claws&r bleed; &6Ironbound Knuckles&r shout (&6War Cry&r)."
		""
		"A &6whip&r is the opposite: the longest reach of any armament. The &6Thornlash&r is a vine that learned to bite."
	]
	quest.450A6C1D94F44BC6.quest_subtitle: "Fists and whips"
	quest.450A6C1D94F44BC6.title: "Fist and Lash"
	quest.456BE32594E10424.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"You heard the bell last night. You'll hear it again.&r"
		""
		"&f&oWhen the sun went out, the moon kept its light for a while. The old priests called it the Hunter's Moon: the night the Crown's huntsmen rode out to clear the roads. The huntsmen are Remnants now. On certain nights the moon remembers them, and turns the colour of what they hunted.&r"
		""
		"&f&oOn those nights everything that has died before wakes hungrier. They'll find you, Ashborn. Your light is a beacon, and a red moon lets the dead see further.&r"
		""
		"&f&oSo hunt back. Varghast waits beyond the hunt, and the Frost Matron beyond him. Two more embers. Go and take them.\"&r"
		""
		"The &cHunter's Moon&r is the Eclipse's tide: on its nights the dead rise in greater numbers and higher ranks, and the &cRemnants&r, the named ones, begin to walk."
	]
	quest.456BE32594E10424.quest_subtitle: "Why the dead hunt on certain nights."
	quest.456BE32594E10424.title: "&e♪ &6The Tale of the Red Moon"
	quest.45A8C358612B49ED.quest_desc: [
		"The illagers stopped raiding villages long enough to build themselves a &6fort&r in the taiga. Then they went back to raiding."
		""
		"&6Inquisitors&r hold the gates, &6Provokers&r stir up the garrison, and vindicators do what vindicators do. Take the walls first."
	]
	quest.45A8C358612B49ED.quest_subtitle: "Illager Invasion. Taiga and snow."
	quest.45A8C358612B49ED.title: "The Illagers' Fort"
	quest.463F4A4D56B7E057.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Varghast was a good king, once. Too good. He couldn't bear to lose a single soldier, so he kept them. Every arm of every man who fell for him, sewn onto his own.\"&r"
		""
		"&6Varghast the Grafted&r, Sovereign of the Hollow Vale, kept his army's strength the only way he could: by wearing it. By the end there was nothing left of him but grip. His token is a block of &firon&r, the metal of the stitches."
		""
		"&7Gather six Fragments and an iron block."
	]
	quest.463F4A4D56B7E057.quest_subtitle: "Six Fragments and an iron block."
	quest.463F4A4D56B7E057.title: "The Grafted King"
	quest.46646A7C9FE93DA1.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Sit. The fire is listening, so I'll keep it short.&r"
		""
		"&f&oThe seven who broke the sun were not monsters, at first. A rider who kept the hours. A king with too many arms. A queen of frost, a lord of storms, a gardener, a burning king, and a wyrm-rider at the edge of the world.&r"
		""
		"&f&oEach took a piece of the light home and swore to bring it back when the Crown called. The Crown never called. The Eighth drank what was left, and the seven went mad in the dark, clutching their scraps of sun like misers.&r"
		""
		"&f&oGather their Fragments. Make a sigil. Wake them. And take back the light they never returned.\"&r"
		""
		"The &6Sovereigns&r still live, after a fashion. Their light is split into &6Fragments&r and scattered among their &6champions&r. Six Fragments and a token make a &6Sigil&r, and a Sigil calls its Sovereign to wherever you stand."
		""
		"Each Sovereign you fell rekindles one of the eight embers of the &6Long Eclipse&r."
	]
	quest.46646A7C9FE93DA1.quest_subtitle: "Who broke the sun, and why."
	quest.46646A7C9FE93DA1.title: "&e♪ &6The Tale of the Seven"
	quest.469917A864125217.quest_desc: [
		"The deep frozen ocean is a &6maze of ice&r, wrecks frozen into it like flies in amber. Pirates still haunt the hulls, and worse things haunt the channels."
		""
		"Enter the &6Ice Maze&r. Wrap up warm, bring a boat, and don't fall in."
	]
	quest.469917A864125217.quest_subtitle: "Aquamirae. The frozen sea."
	quest.469917A864125217.title: "The Ship Graveyard"
	quest.46BDA82E37018B35.quest_desc: [
		"Ranked monsters carry &etraits&r, listed under their name. Read them before you swing."
		""
		"&eVolatile&r explodes after it dies: step away. &eThornskin&r returns melee damage. &eDeflecting&r shrugs off arrows. &eWarded&r regrows its shield if you let it rest. &ePackleader&r calls copies once wounded. &eBlinking&r ends up behind you."
		""
		"Kill a monster with four traits."
	]
	quest.46BDA82E37018B35.quest_subtitle: "Sixteen ways to die, four at a time."
	quest.46BDA82E37018B35.title: "Nothing Left to Hide"
	quest.4733C14701DD23BA.quest_desc: [
		"Place a &6Water Wheel&r where flowing water strikes its blades and it turns everything connected to it."
		""
		"Each source gives a little &6stress capacity&r and each machine draws some. Ask too much and the whole line stops: add wheels, or slow things down."
	]
	quest.4733C14701DD23BA.quest_subtitle: "The rivers still run. Put them to work."
	quest.4733C14701DD23BA.title: "Harnessed Hydraulics"
	quest.47698F7A014C082E.quest_desc: [
		"Kills also pay &6Valor&r. Valor fills your &6RPG level&r, and every level gives points for Vitality, Attack Power, Attack Speed, Protection, Toughness, Agility, Fortitude and Exploration."
		""
		"Press &eK&r. Stage points with the arrow keys (&eShift&r for five), read the &7current → after&r preview, and press &eEnter&r to confirm."
		""
		"A &6Remnant Shard&r is 15 Valor waiting to be crushed. Sneak to crush the stack."
	]
	quest.47698F7A014C082E.quest_subtitle: "Kills pay twice."
	quest.47698F7A014C082E.title: "Valor and the K Screen"
	quest.47CB725721EA1EEA.quest_desc: [
		"A &6Copper Golem&r presses buttons for you and asks for nothing. A &6Glare&r is a grumpy little moss cloud that hates the dark as much as you do: tame it, and it'll show you the shadows where monsters would spawn."
		""
		"Build one. Tame the other. Light every place the Glare grumbles at."
	]
	quest.47CB725721EA1EEA.quest_subtitle: "Friends & Foes. Not everything is hostile."
	quest.47CB725721EA1EEA.title: "Small Kindnesses"
	quest.48066C21C40D4177.quest_desc: [
		"&6Zinc Ore&r hides underground in pale veins. Smelt the raw zinc into ingots."
		""
		"Copper and zinc together make brass. Brass makes the clever machines."
	]
	quest.48066C21C40D4177.quest_subtitle: "Zinc, deep and patient."
	quest.48066C21C40D4177.title: "A Grey Metal"
	quest.4923F67E00A81431.quest_desc: [
		"&5Shadow Bolt&r, &5Soul Harvest&r, &5Void Rift&r, &5Shadow Step&r, and the ultimate, &5Eclipse&r."
		""
		"Keystones: &5Blood Pact&r (abilities cost health instead of Essence, for 25% more damage) and &5Soul Eater&r (every kill restores Essence and a little health). An Ashborn studying the dark under an eclipse. Nobody is surprised."
	]
	quest.4923F67E00A81431.quest_subtitle: "The dark answers. It always has."
	quest.4923F67E00A81431.title: "&5Umbral Arts"
	quest.4948168D26CE48A0.quest_desc: [
		"The &6Wandering Trader&r still carries &6Globes&r, painted back when the world had a sun to turn under. Buy one and set it somewhere in Last Light."
		""
		"Spin it. Nobody's stopping you."
	]
	quest.4948168D26CE48A0.quest_subtitle: "Round, and lit. Imagine that."
	quest.4948168D26CE48A0.title: "The World as It Was"
	quest.49D921BB43B33F9E.quest_desc: [
		"In the Hall of Alignment, turn each dial until its conduit of light reaches the engraved mark. The broken dials only turn in the &bRemembered&r Hall."
		""
		"Made a mess of it? Crouch-use the Memory Anchor and the dials return to north."
	]
	quest.49D921BB43B33F9E.quest_subtitle: "The observatory still wants its lines drawn."
	quest.49D921BB43B33F9E.title: "Lines Across Time"
	quest.49F90ED7C1B4D80E.quest_desc: [
		"The deep frozen ocean is a maze of ice and wrecks, and two things rule it."
		""
		"The &6Maze Mother&r hunts the channels. Fight her from solid ice, never from the water."
		""
		"The &6Ghost of Captain Cornelia&r answers a &6Shell Horn&r from the frozen pirate ships, blown at the water's edge. She keeps the &6Frozen Key&r. Bring Water Breathing and something to stand on."
	]
	quest.49F90ED7C1B4D80E.quest_subtitle: "Aquamirae. Level 25–30."
	quest.49F90ED7C1B4D80E.title: "Ghosts of the Ice Maze"
	quest.4A77FF56062A9728.quest_desc: [
		"An &6Iron Wand&r (iron, redstone and a stick) extends the face you click: one course of wall becomes two, two become ten. It draws blocks from your inventory, shulker boxes and bundles."
		""
		"It can undo its last placements, too (see &eControls&r). Everyone builds a wall in the wrong place once."
	]
	quest.4A77FF56062A9728.quest_subtitle: "The dark can count. Make it count bricks."
	quest.4A77FF56062A9728.title: "Walls in an Afternoon"
	quest.4B6D3CFFC418A385.quest_desc: [
		"A &6twinblade&r is an edge at both ends of a pole. Twelve stamina a swing, and &6Whirlwind&r: three spins, a storm of steel around you."
		""
		"Crowds are its business. Bosses, rather less so."
	]
	quest.4B6D3CFFC418A385.quest_subtitle: "Twinblades"
	quest.4B6D3CFFC418A385.title: "Two Edges, No Rest"
	quest.4C67E689E70A462B.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Stone. Good. Stone doesn't care what you were, either.\"&r"
		""
		"Under the soil, the world's bones. The first Ashborn fought with whatever the earth gave them, and most of them are Remnants now. Do better than they did."
		""
		"&7Mine cobblestone and make a stone pickaxe."
	]
	quest.4C67E689E70A462B.quest_subtitle: "Something sharper than your hands."
	quest.4C67E689E70A462B.title: "Stone Teeth"
	quest.4CC4B7C1F9472779.quest_desc: [
		"&o\"Kill them before they reach the walls. I've rebuilt the tannery twice.\"&r"
		""
		"Kill &c10 creepers&r. When one starts to hiss, roll out, not back. A &eVolatile&r one is worse news than usual."
	]
	quest.4CC4B7C1F9472779.quest_subtitle: "Minor bounty · 10 creepers"
	quest.4CC4B7C1F9472779.title: "Contract: Quiet Fuses"
	quest.4CF532D459AE3D38.quest_desc: [
		"&6Dread Hounds&r run in packs out of the dark, and every pack answers to a &6Dire Hound Leader&r twice their size."
		""
		"Fight with your back to a wall so they can't circle you. Mind the hound traps around their mounds."
	]
	quest.4CF532D459AE3D38.quest_subtitle: "Born in Chaos. They hunt in packs."
	quest.4CF532D459AE3D38.title: "The Mound of Hounds"
	quest.4D0587808D220640.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Catch its breath before it dies. That breath was sunlight, once. Vaelorn will smell it on you.\"&r"
		""
		"The Dragon was there before the Crown and it will be there after it. It remembers the Eighth. It remembers someone before him, too, but it won't say who."
		""
		"&7Break the crystals. Bring a bow. Bring bottles: before it dies, catch its &dbreath&7. The last Sovereign answers to nothing else."
	]
	quest.4D0587808D220640.quest_subtitle: "Old Power: the Ender Dragon."
	quest.4D0587808D220640.title: "&5The Dragon at the World's Edge"
	quest.4D6D7046C590360F.quest_desc: [
		"Cottage, pier, lighthouse, stilt shack, ice camp, boathouse, and the &6Sunken Trawler&r twelve blocks under the waves."
		""
		"Visit them all. Frost-Beard Ole, Old Bayou Tam and Ferryman Hale all have opinions about the weather, and they'll share them."
	]
	quest.4D6D7046C590360F.quest_subtitle: "All seven places of the coast."
	quest.4D6D7046C590360F.title: "&6Coastal Wanderer"
	quest.4D80153791FC3844.quest_desc: [
		"A knight who swore to guard the Ashlands' gate until relieved. Nobody came to relieve him. He'd like to duel you about it."
		""
		"&7Kill the Underworld Knight."
	]
	quest.4D80153791FC3844.quest_subtitle: "A duel in the deep arena."
	quest.4D80153791FC3844.title: "The Underworld Knight"
	quest.4D8CC4FACA003D12.quest_desc: [
		"Use the &6Survey Map&r for a bearing, and again for a fresh one. No compass will find the &6Meridian Archive&r; only the map remembers where it stands."
		""
		"Cross its threshold."
		""
		"&7Word of an open Archive travels fast. Someone at Last Light has been waiting a long time to hear it.&r"
	]
	quest.4D8CC4FACA003D12.quest_subtitle: "The Overworld forgot it. The map didn't."
	quest.4D8CC4FACA003D12.title: "&eThe Meridian Archive"
	quest.4DB697F2135216F6.quest_desc: [
		"Eight great lairs, each built around something that should have stayed asleep: a pyramid, a prison, a factory and a sunken city in the Overworld; an arena and a forge in the Ashlands; a citadel at the Last Shore; an acropolis over the warm sea."
		""
		"Cataclysm's &6Eyes&r fly toward their lairs like Eyes of Ender. Find all eight. Fighting what's inside is the Compendium's business."
	]
	quest.4DB697F2135216F6.quest_subtitle: "Eight arenas across three worlds."
	quest.4DB697F2135216F6.title: "&6Lairs of the Cataclysm"
	quest.4E10B19140F80394.quest_desc: [
		"On about one full moon in three, a toll sounds and the &cHunter's Moon&r rises. Until dawn, monsters spawn five levels stronger, ranks come twice as often and shards drop double."
		""
		"An icon on your screen means it's up. Hunt under it, or bar the door. Both are reasonable."
	]
	quest.4E10B19140F80394.quest_subtitle: "Some full moons are not for sleeping."
	quest.4E10B19140F80394.title: "Under the Red Moon"
	quest.4E3972478AB115D3.quest_desc: [
		"The old monster rooms aren't small anymore. Some became &6Fortresses of the Undead&r, skeletons stacked to the ceiling. Others became &6Spider Caves&r, and you can guess."
		""
		"Break the spawners, or light them out. Loot the chests either way."
	]
	quest.4E3972478AB115D3.quest_subtitle: "Spawner rooms that grew up."
	quest.4E3972478AB115D3.title: "Bones and Webs"
	quest.4E4B23BBB691EBC8.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Seven Sovereigns, seven embers. The eighth light is where he took it: behind the black sun. You'll need a door.\"&r"
		""
		"A shard of the eclipse itself: a sliver of the dark the Hollow Sovereign hides behind, caught in crystal."
		""
		"&7Craft an &5Eclipse Shard&7 from an amethyst shard, an ender pearl and a gold ingot."
	]
	quest.4E4B23BBB691EBC8.quest_subtitle: "Amethyst, an ender pearl, a gold ingot."
	quest.4E4B23BBB691EBC8.title: "&5Splinter of the Black Sun"
	quest.4E93F1A57F31020C.quest_desc: [
		"Monsters that rose more than once wear a crest: &7Common&r → &aVeteran&r → &9Elite&r → &5Champion&r → &cRemnant&r. Each rank pays more experience (up to ten times), extra loot, a &6Remnant Shard&r and bonus Valor."
		""
		"Don't mistake a &5Champion&r crest for a &6gold title&r. The gold title is the Sovereigns' mark, with affixes like Blazing or Warded, and it carries their Fragments."
		""
		"&o\"Every rank has a weakness. Every Remnant has a name. Learn both.\"&r &7— Ilse, the Huntmaster&r"
	]
	quest.4E93F1A57F31020C.quest_subtitle: "Some of them have died before."
	quest.4E93F1A57F31020C.title: "Crest and Rank"
	quest.4E9D7ED6C63801AD.quest_desc: [
		"A monster's level shows in colour against your own. The redder it is, the worse your odds and the better the pay: kills above your level give half again the Valor."
		""
		"Kill a ranked monster at least ten levels above you."
	]
	quest.4E9D7ED6C63801AD.quest_subtitle: "Ten levels above you, and still standing. Briefly."
	quest.4E9D7ED6C63801AD.title: "Punching Up"
	quest.4F1CC87DF85FA7DC.quest_desc: [
		"Use Andesite Alloy on a &6stripped log&r to make &6Andesite Casing&r. Most of the early machines are built around it."
	]
	quest.4F1CC87DF85FA7DC.quest_subtitle: "Every machine needs a coat."
	quest.4F1CC87DF85FA7DC.title: "The Andesite Age"
	quest.4FE09E1915F28730.quest_desc: [
		"An &6axe&r is a Strength weapon that doesn't apologise: &6War Cry&r on &eR&r, and the &6Warlord's Battleaxe&r is notched once for every war it survived."
		""
		"A &6greataxe&r swings slower and harder, with &6Frenzied Strikes&r: five savage blows. The &6Executioner's Greataxe&r has only ever had one job."
	]
	quest.4FE09E1915F28730.quest_subtitle: "Axes and greataxes"
	quest.4FE09E1915F28730.title: "Axes, Small and Great"
	quest.5005FD9E609A763F.quest_desc: [
		"&bWater Runes&r come from the drowned and from guardians, so you'll be fighting underwater or on a beach at night. Pick your misery."
		""
		"A Fire Rune and a Water Rune together are the heart of a &6Remnant Tome&r."
	]
	quest.5005FD9E609A763F.quest_subtitle: "The sea kept its share."
	quest.5005FD9E609A763F.title: "Water Runes"
	quest.5045D3883BE1B335.quest_desc: [
		"&6Flax&r grows wild here and there and plants like any crop. Weave it with string into a &6Sack&r: a bag you can set down, pick up and carry with everything still inside."
		""
		"Sacks are heavy. So is dying with everything you own in your pockets."
	]
	quest.5045D3883BE1B335.quest_subtitle: "Supplies need somewhere to live."
	quest.5045D3883BE1B335.title: "Flax and String"
	quest.50C7CAC5DFA54CD2.quest_desc: [
		"The seven who broke the sun. Each one answers a &6Sigil&r: six Sovereign Fragments and a token. This page only keeps the tally."
		""
		"&6Dusk Rider&r 15 · &6Varghast&r 20 · &6Sylvara&r 25 · &6Kaelthar&r 30 · &6Ysolde&r 35 · &6Morgrath&r 50 · &6Vaelorn&r 70."
		""
		"Summon them in the open, with room to roll and full flasks. A Sovereign has a boss bar and no patience."
		""
		"&7They wear borrowed bodies, so the world counts them by the feat, not the corpse."
	]
	quest.50C7CAC5DFA54CD2.quest_subtitle: "The Sovereigns. Levels 15 to 70."
	quest.50C7CAC5DFA54CD2.title: "&6Seven Crowns"
	quest.50CDEE7C92E6A561.quest_desc: [
		"Every sellsword has a trade. &6Bulwarks&r hold the line and &6Challenge&r foes onto themselves. &6Skirmishers&r &6Whirl&r through crowds. &6Rangers&r loose &6Volleys&r. &6Arcanists&r call an &6Arc Storm&r. &6Menders&r heal, and haul the fallen back to their feet."
		""
		"Each also has a trait (Steadfast, Brutal, Keen-eyed, Greedy…) and the epithet that came with it. Hire a Mender."
	]
	quest.50CDEE7C92E6A561.quest_subtitle: "Somebody has to carry you home."
	quest.50CDEE7C92E6A561.title: "Five Trades"
	quest.510150BC74B32079.quest_desc: [
		"An executioner in a chain chapel, behind a fog gate. The altar is already set; the &6Crypt Key&r wakes him."
		""
		"Wide sweeps, chain grabs, graves bursting under you. At half health he raises chain walls: break the four &6anchors&r to stagger him, then make it count."
	]
	quest.510150BC74B32079.quest_subtitle: "The Gravebound Catacombs. Level 80."
	quest.510150BC74B32079.title: "The Gravebound Warden"
	quest.5308A52218AFD4B1.quest_desc: [
		"In the hot, wet places stands the &6Cursed Keep&r. Its Warlord died defending it in the first year of the dark. He didn't notice. He's still defending it."
		""
		"&7Kill the Keep's Warlord."
	]
	quest.5308A52218AFD4B1.quest_subtitle: "Tier III of the dungeon trail."
	quest.5308A52218AFD4B1.title: "The Cursed Keep"
	quest.5316B4764FFB7FDC.quest_desc: [
		"The wild keeps its own larder: &6venison&r from deer, &6drumsticks&r from turkeys, &6duck&r from the ponds, &6crab meat&r on the beaches."
		""
		"Deer bolt at the first footstep. Come at them slowly, or bring a bow."
	]
	quest.5316B4764FFB7FDC.quest_subtitle: "The deer survived the Eclipse. Mostly by running."
	quest.5316B4764FFB7FDC.title: "Game in the Ash"
	quest.53317B8CCC27689B.quest_desc: [
		"Some monsters wear every trick they've got at once. &6Four traits&r on a single body: the rarest ranks carry that many, and a Brand of Challenge can add the last one."
		""
		"Kill one. Then sit down for a bit."
	]
	quest.53317B8CCC27689B.quest_subtitle: "Four traits on one monster."
	quest.53317B8CCC27689B.title: "Nothing Left to Hide"
	quest.5373FCB143487DB0.quest_desc: [
		"The blazes answer to something bigger, and it keeps a &6citadel&r in the Ashlands."
		""
		"Shields orbit it; break them before you bother with the rest. It calls more blazes and slams the ground. Fire Resistance, and fight with your back to nothing."
	]
	quest.5373FCB143487DB0.quest_subtitle: "A Nether citadel. Level 50."
	quest.5373FCB143487DB0.title: "The Wildfire"
	quest.538C290E26032521.quest_desc: [
		"Morgrath's ash didn't fall evenly. The &6Ashlands&r have their own countries: blue soul valleys, black basalt deltas, red and teal forests of fungus."
		""
		"Walk all four. Fire Resistance is cheaper than funerals."
	]
	quest.538C290E26032521.quest_subtitle: "Every country of the Nether."
	quest.538C290E26032521.title: "An Atlas of the Ashlands"
	quest.5393850EC277437A.quest_desc: [
		"Gold-titled champions carry &6Sovereign Fragments&r. Six Fragments and the right token make a &6Sigil&r. Use it, and a Sovereign answers."
		""
		"A felled Sovereign leaves a &6Relic&r, exchanged at a shrine for one of two legendary armaments, and most leave a &6Crown Shard&r: use it to claim its blessing, then wear one at a time from a shrine. The Old Powers keep relics too."
		""
		"Each Sovereign's first fall rekindles an ember of &6The Long Eclipse&r for everyone. &e/lastlight eclipse&r shows the count."
	]
	quest.5393850EC277437A.quest_subtitle: "How a Sovereign is called, and what it leaves."
	quest.5393850EC277437A.title: "Fragments, Sigils, Relics, Crowns"
	quest.53F1F7B9F1CC8A15.quest_desc: [
		"Some gear refuses a weak hand. &bDiamond&r tools and weapons need &612 Attack Power&r; diamond armour needs &612 Protection&r. &5Netherite&r asks for 30."
		""
		"The tooltip tells you what's missing. Find the diamonds whenever you like. Spend the points before you swing."
	]
	quest.53F1F7B9F1CC8A15.quest_subtitle: "Diamond is a promise you have to keep."
	quest.53F1F7B9F1CC8A15.title: "Earned, Not Found"
	quest.53F967EF1BEA3D24.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Three embers. Feel that wind? It's warm. For the first time in an age, something in the north is thawing. Three Sovereigns, Ashborn. You're making the dark nervous.\"&r"
		""
		"Call her in the snow, where she feels at home. She fights from range and freezes what she can't reach."
		""
		"&7&cFrostbite&7 builds with every hit; let it fill and it bursts for a chunk of your health. Close the distance, use cover against her blizzards and keep a flask for the burst."
	]
	quest.53F967EF1BEA3D24.quest_subtitle: "Sovereign of the Rime Veil. Level 25."
	quest.53F967EF1BEA3D24.title: "&6Sovereign: Sylvara, Frost Matron"
	quest.54BEC32A2A59D661.quest_desc: [
		"Hold a &6Skillet&r in one hand and raw food in the other, stand near a fire, and cook as you go. Sneak to set it down as a block over a fire or a stove, and it cooks there too."
		""
		"It also makes a perfectly respectable club. Nobody has to know."
	]
	quest.54BEC32A2A59D661.quest_subtitle: "Supper on the road."
	quest.54BEC32A2A59D661.title: "Portable Cooking"
	quest.560C7BFC391C8635.quest_desc: [
		"A duel, nothing more. The arena keeps its keys in its own vaults; find them and the knight will see you."
		""
		"Read the sword waves, roll &othrough&r them and punish the recovery. When his weak point shows, that's your window. Take it."
	]
	quest.560C7BFC391C8635.quest_subtitle: "The Underworld Arena. Level 55."
	quest.560C7BFC391C8635.title: "Helvar, the Underworld Knight"
	quest.5651DDA19B1EF5FB.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Campfire for the heart. Gold for the oath. Deepslate for the bones. And old flame, the kind nothing in this world makes any more. Here. I kept some.\"&r"
		""
		"An &6Ember Shrine&r is a promise made in stone: that light will be kept here, whatever comes. The first shrines were built by the Sun-Crown's heralds. Almost all of them went cold."
		""
		"&7An Ember Shrine is a campfire under a crown of gold, set on polished deepslate, lit with &6blaze powder&7. The Keeper gives you the flame. Find the rest."
	]
	quest.5651DDA19B1EF5FB.quest_subtitle: "A shrine needs old flame."
	quest.5651DDA19B1EF5FB.title: "&6Kindling"
	quest.568BFF2F4516A32D.quest_desc: [
		"Somebody tried to cure the dead. Somebody failed. The &6Plague Asylum&r stands in the forests, floor upon floor of wards nobody walked out of."
		""
		"Bring friends. It's a co-op dungeon on purpose."
	]
	quest.568BFF2F4516A32D.quest_subtitle: "When Dungeons Arise. A forest set piece."
	quest.568BFF2F4516A32D.title: "The Plague Asylum"
	quest.57415FB9EFDCAEA5.quest_desc: [
		"&o\"The Hollow Sovereign still keeps an army. It doesn't know the war ended. Neither do I, some days.\"&r"
		""
		"Kill &c8 Hollow Sentinels&r and &c4 Hollow Arbalists&r. Keep the &6Tarnished Regalia&r they drop: the Sovereign's Seal is made from it."
	]
	quest.57415FB9EFDCAEA5.quest_subtitle: "Grave bounty · the Eclipsed Realm"
	quest.57415FB9EFDCAEA5.title: "Contract: The Hollow Legion"
	quest.576B4D96CAC7D4D4.quest_desc: [
		"The Graveyard's lich (no relation to the gold-titled kind) is chained on an island in the frozen ocean."
		""
		"Wake it at its altar, at night, with a full &6Vial of Blood&r and all three &6bone staff&r pieces. It has three forms, heals itself and lifts you off your feet: bring Slow Falling and punish every stagger."
	]
	quest.576B4D96CAC7D4D4.quest_subtitle: "A cursed island in the frozen sea. Level 35."
	quest.576B4D96CAC7D4D4.title: "The Corrupted Champion"
	quest.57B6EC7D178747AD.quest_desc: [
		"Fireflies are the only lights that still come out at night by choice. Butterflies kept flying through the whole Long Eclipse, out of stubbornness."
		""
		"Make a &6Capture Net&r and catch one of each. Let them go at Last Light, if you like."
	]
	quest.57B6EC7D178747AD.quest_subtitle: "Naturalist. Small things worth keeping."
	quest.57B6EC7D178747AD.title: "Lights in the Grass"
	quest.582A0D136C5119A7.quest_desc: [
		"Someone was here before you and kept notes. The handwriting gets worse toward the end."
		""
		"&7The &6Boss Hunts Journal&7 tracks every boss of the Realm as you find and fell them. Three arenas wait behind &7fog gates: the Gravebound Catacombs, the Forgotten Observatory and the Hollow Citadel. Each has an Ancient Altar already laid with its offerings; you bring the summoning item."
	]
	quest.582A0D136C5119A7.quest_subtitle: "Undiscovered. Encountered. Defeated."
	quest.582A0D136C5119A7.title: "Boss Hunts"
	quest.582A451645F1551B.quest_desc: [
		"You can't die for good. You can still go hungry, and a hungry Ashborn can't sprint, can't heal and can't outrun much of anything."
		""
		"Craft a &6knife&r from flint or iron. It takes more from the world than a sword does: straw from grass, ham from pigs, slices from a fish."
		""
		"&o\"The villages that lived through the Eclipse learned one thing before swordplay. Supper.\"&r"
	]
	quest.582A451645F1551B.quest_subtitle: "Undying isn't the same as fed."
	quest.582A451645F1551B.title: "&aHunt and Gather"
	quest.5867200A6552CB88.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Seven embers. All seven. Do you know how long I waited to say that? One light left, and it isn't in this world. Rest first, Ashborn. Then we find the black sun.\"&r"
		""
		"The last of the seven. He rode the dragons before there was only one, and he hits like the thing he rode. He chose the edge of the world as his kingdom so that nobody could ever come up behind him."
		""
		"&7Fight him on open ground, and never directly in front of him."
	]
	quest.5867200A6552CB88.quest_subtitle: "Sovereign of the Last Shore. Level 70."
	quest.5867200A6552CB88.title: "&6Sovereign: Vaelorn, the Wyrm-Ravager"
	quest.59408FECF06D8CF0.quest_desc: [
		"The &6Labyrinths&r are prisons the Sovereigns dug for things they could not kill. Six of them wind under the world."
		""
		"The nearest lies under the plains, meadows and forests: the &6Forgotten Catacombs&r. Walk in. Remember the way out."
	]
	quest.59408FECF06D8CF0.quest_subtitle: "A Labyrinth: the Forgotten Catacombs."
	quest.59408FECF06D8CF0.title: "Rest in Pieces"
	quest.5A3C796647331707.quest_desc: [
		"&cVampiric&r: heals for part of what it deals. Don't trade blows; every hit you take feeds it."
		"&2Venomous&r: poisons. Champions and Remnants poison harder. Carry milk or honey."
		"&8Withering&r: withers you. Back off before it stacks up."
		"&bFrostbite&r: slows and freezes you, and can't be frozen itself. Fight it on open ground."
		"&6Infernal&r: immune to fire, and sets you ablaze. Leave the fire weapons at home."
	]
	quest.5A3C796647331707.quest_subtitle: "Traits that follow you home."
	quest.5A3C796647331707.title: "Blood, Venom and Frost"
	quest.5A752C24FAE57D9C.quest_desc: [
		"A &6Storage Controller&r joins every Sophisticated chest and barrel touching it, or touching each other, into one network. Put an item into the controller and it goes to the right chest."
		""
		"&7Storage Links stretch the network to chests further away."
	]
	quest.5A752C24FAE57D9C.quest_subtitle: "Put it in once. It finds its own shelf."
	quest.5A752C24FAE57D9C.title: "One Room, Many Chests"
	quest.5AE07438B5B547E1.quest_desc: [
		"The executioner of the Hollow Legion. He chained the Eighth's deserters to their own graves, and when the deserters ran out he chained himself."
		""
		"&7Sweeps, chain grabs and graves that erupt beneath you. At half health he raises chain walls: break the four &7Chain Anchors&7 to stagger him."
	]
	quest.5AE07438B5B547E1.quest_subtitle: "The Gravebound Catacombs."
	quest.5AE07438B5B547E1.title: "&6The Gravebound Warden"
	quest.5B17BE44F64CBE69.quest_desc: [
		"A &6Millstone&r grinds wheat into &6flour&r, bones into bone meal and raw ore into crushed ore."
		""
		"Flour and water make dough. The Hearth & Harvest kitchen will thank you."
	]
	quest.5B17BE44F64CBE69.quest_subtitle: "Flour for the kitchen."
	quest.5B17BE44F64CBE69.title: "Embrace the Grind"
	quest.5C4120A5CBCF549B.quest_desc: [
		"Now and then a rod or a crab pot brings up a &6Message in a Bottle&r. Open it. Some hold a little treasure; some hold a &6Bottled Map to a Wreck&r."
		""
		"The sea had a lot to say before the Eclipse. It hasn't stopped."
	]
	quest.5C4120A5CBCF549B.quest_subtitle: "Twelve notes from the sea. Most of them are complaints."
	quest.5C4120A5CBCF549B.title: "Message Received"
	quest.5C77FA2F283917EA.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"You're branding them now? On purpose? I've buried braver people than you. Well. Not buried. You know what I mean.\"&r"
		""
		"The &6Brand of Challenge&r was the huntsmen's mark: a sign burned into a beast to say &oI chose you&r. The dead still answer it."
		""
		"&7A Brand gives a monster one more rank and five more levels, and doubles everything it pays. Brand something and kill it."
	]
	quest.5C77FA2F283917EA.quest_subtitle: "Make it worse on purpose."
	quest.5C77FA2F283917EA.title: "Accept the Challenge"
	quest.5C890DFD03E0E5BA.quest_desc: [
		"The Dragon remembers the sun, and it remembers the Eighth. It keeps its relic, and a Crown Shard, on the island at the world's edge."
		""
		"Break the crystals before the dragon. Bring empty bottles: its &6breath&r is Vaelorn's token."
	]
	quest.5C890DFD03E0E5BA.quest_subtitle: "Old Power. The Last Shore. Level 65."
	quest.5C890DFD03E0E5BA.title: "&5The Ender Dragon"
	quest.5CFD01DF56BD242D.quest_desc: [
		"&o\"Big. Slow. Hits like a falling house. I'll pay double what it's worth, which is to say, the usual.\"&r"
		""
		"Kill a &cBurial Guardian&r, the hulking keeper of the Cryptborn. It carries Grave Iron, and sometimes a Crypt Key."
	]
	quest.5CFD01DF56BD242D.quest_subtitle: "Grave bounty · 1 Burial Guardian · the Eclipsed Realm"
	quest.5CFD01DF56BD242D.title: "Contract: The Burial Guardian"
	quest.5D342ECF383FA3F5.quest_desc: [
		"Floor bosses seal &6Relics&r into your Recollection: weapons and armour with affixes like Keen, Thirsting, Echoing or Storied, graded Common up to Legendary, and rarest of all, &cRemnant&r."
		""
		"A Remnant relic carries a signature: &6Last Hour&r, &6Fracture Step&r, &6Choir's Echo&r or &6Yesterglass&r. Recover one."
	]
	quest.5D342ECF383FA3F5.quest_subtitle: "The rarest thing the Archive gives back."
	quest.5D342ECF383FA3F5.title: "Remnant"
	quest.5E38C6BB4D9030A0.quest_desc: [
		"Iron remembers the old forges. In the age of the sun, smiths sang over it; now it just goes quiet in the furnace and waits to be useful."
		""
		"&7Smelt iron. A shield comes with it, and you will want one."
	]
	quest.5E38C6BB4D9030A0.quest_subtitle: "The world's best argument."
	quest.5E38C6BB4D9030A0.title: "Iron Will"
	quest.5E82C40296E650F1.quest_desc: [
		"It was told to preserve this day forever, and it's still obeying. Open the Archive Core and it begins the &6Catalogue&r."
		""
		"Read the floor: in &6Catalogue&r, leave the marked row; in &6Revision&r, leave the marked radius; in &cErasure&r, its afterimages detonate where they were recorded. Trigger the &6Memory Anchor&r to revise the Grand Orrery around it, and strike while its core is exposed."
	]
	quest.5E82C40296E650F1.quest_subtitle: "It was told to preserve this day forever."
	quest.5E82C40296E650F1.title: "&cThe Last Curator"
	quest.5EFE0C39CCCCE0DF.quest_desc: [
		"The heralds built &6Waygates&r to carry the flame between kingdoms. One road was sealed when the Eighth walked down it. Open it again."
		""
		"&7A Waygate: six polished deepslate around a shard on top and a gold ingot at the bottom. Place it and it raises a stone arch. Use a second &5Eclipse Shard&7 on the arch; it burns for six seconds. Walk through."
	]
	quest.5EFE0C39CCCCE0DF.quest_subtitle: "Build the arch. Kindle it with a second shard."
	quest.5EFE0C39CCCCE0DF.title: "The Way Remembered"
	quest.5F6A657F32780475.quest_desc: [
		"Feed a &6Golden Fish&r to a sellsword: full health and +30 &6morale&r. It's eight gold ingots around a cooked cod. Expensive. So are funerals."
		""
		"Morale rises and falls with the fight. A band that's winning fights like it."
	]
	quest.5F6A657F32780475.quest_subtitle: "Expensive. So are funerals."
	quest.5F6A657F32780475.title: "The Golden Fish"
	quest.5FE44DCC8BF3F598.quest_desc: [
		"&o\"Every monster out there has a level, a rank and a temper. Two of those you can read.\"&r &7— the Huntmaster"
		""
		"Ring a spyglass with four &6Remnant Shards&r and you have a &6Hunter's Lens&r. Held, it tells you how dangerous the area is. Look through it at a monster to read its level, rank, traits and stats."
	]
	quest.5FE44DCC8BF3F598.quest_subtitle: "Read it before it reads you."
	quest.5FE44DCC8BF3F598.title: "&6Know Thy Enemy"
	quest.5FFF933FACD13104.quest_desc: [
		"&o\"The Coven used to say: you catch more Ashborn with sugar than with iron. Then they built the house to prove it.\"&r &7— the Archivist"
		""
		"Somewhere in the snow, or out on the open plains, stands a house made of gingerbread and frosting, warm-windowed and smelling of the old world. It was built by the &5Hollow Wood Coven&r as a lure for the hungry and the lost in the first starving winters of the Eclipse."
		""
		"The witches are gone. The house is still warm. Don't wonder why."
		""
		"&7Find the Gingerbread House."
	]
	quest.5FFF933FACD13104.quest_subtitle: "A candy house in the snow. Nobody lives there. Nobody lives anywhere near it, either."
	quest.5FFF933FACD13104.title: "&dThe Sweetest Lure"
	quest.604CE6C989BE7731.quest_desc: [
		"Some things in the Realm were never alive. The &6Ashbound&r are constructs of soot and gears that still keep their posts in the Ashen Wastes. The &6Corrupted Relics&r are worse: old treasures that learned to walk and want to be held again."
		""
		"They drop &6Ashen Cogs&r and &6Relic Shards&r. Keep both."
	]
	quest.604CE6C989BE7731.quest_subtitle: "The Eclipsed Realm. Ashbound and Corrupted Relics."
	quest.604CE6C989BE7731.title: "Cogs and Shards"
	quest.60736FE08ABE9C7F.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Up the stair. Through the gate. Don't look back; there's nothing behind you but graves, and one of them was yours.\"&r"
		""
		"The Waygate at the top of the Last Stair is the heralds' road out of the Threshold. It leads to the &6Lands Under Ash&r: the world, what's left of it."
		""
		"&7Pass the Ember Door and climb to the Waygate."
	]
	quest.60736FE08ABE9C7F.quest_subtitle: "Up the Last Stair, through the Waygate."
	quest.60736FE08ABE9C7F.title: "&6Beyond the Gate"
	quest.6082A67EB4C4FE83.quest_desc: [
		"Mineshafts run under every kind of land, and each one is built from what was growing above it: spruce in the taiga, acacia in the savanna, ice in the cold."
		""
		"Ore, rails and the occasional chest. Mind the cave spiders, and don't ask why the miners left."
	]
	quest.6082A67EB4C4FE83.quest_subtitle: "Someone dug for something. Then stopped."
	quest.6082A67EB4C4FE83.title: "Old Workings"
	quest.60D85B08B049B48E.quest_desc: [
		"Make enough mischief and &6Krampus&r comes for you, with henchmen and a sack."
		""
		"He hits hard and never comes alone. Clear the henchmen first, keep moving, and don't let him pin you in a corner."
		""
		"&7If he never shows up, congratulations: you're on the other list."
	]
	quest.60D85B08B049B48E.quest_subtitle: "Born in Chaos. Level 20. If you've earned it."
	quest.60D85B08B049B48E.title: "Naughty Child"
	quest.60F8EFC33FD55BED.quest_desc: [
		"Fix &6Mechanical Harvesters&r, drills or saws to a moving frame (a bearing, a piston, a cart) and set it in motion. That's a &6contraption&r: the old world's favourite trick."
		""
		"A harvester boom sweeping the wheat while you're off killing Sovereigns. Last Light, fed by clockwork."
	]
	quest.60F8EFC33FD55BED.quest_subtitle: "Harvesters on a bearing, sweeping the fields."
	quest.60F8EFC33FD55BED.title: "&aMoving with Purpose"
	quest.615B8AB77BC469EF.quest_desc: [
		"A &6Sleeping Bag&r lets you sleep through the night wherever you unroll it, and it doesn't move your respawn. Your shrine stays your shrine."
		""
		"&7You can't sleep with monsters nearby. On a Hunter's Moon, there are always monsters nearby."
	]
	quest.615B8AB77BC469EF.quest_subtitle: "Skip the night. Keep your shrine."
	quest.615B8AB77BC469EF.title: "Rest on the Road"
	quest.616E722849BB220E.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Three skulls and the sand of lost souls. That's not a summoning, Ashborn, it's a dinner bell.\"&r"
		""
		"The Wither is the oldest hunger in the world, older than the sun it would have eaten if anyone had let it. It doesn't hate you. It doesn't know you exist. It just wants."
		""
		"&7Fight it somewhere you don't mind losing. &6Keep its Nether Star&7: something in the Eclipsed Realm answers to one."
	]
	quest.616E722849BB220E.quest_subtitle: "Old Power: the Wither."
	quest.616E722849BB220E.title: "&5The Withering"
	quest.622E439071EE06FA.quest_desc: [
		"A &6Brand of Challenge&r, used on a leveled monster, lifts it one rank, five levels and one trait, and doubles what it pays. A Remnant can't rise any higher, which is the only mercy in the description."
		""
		"Craft one from Remnant Shards and an echo shard, or trade shards to the Huntmaster."
	]
	quest.622E439071EE06FA.quest_subtitle: "Make it worse. Get paid double."
	quest.622E439071EE06FA.title: "Accept the Challenge"
	quest.62751E1F10BB8066.quest_desc: [
		"A monster's level comes from where it rose: &7+1 for every 128 blocks from spawn, +1 every 4 days (up to 15), +1 for every 12 blocks below Y 32&r. Ruins set a floor: outposts 12, fortresses 20, strongholds 25, bastions 30, ancient cities 40. The Ashlands start at 15."
		""
		"Your own level drags theirs a third of the way toward you. Kills above your level pay half again; kills far below pay a quarter."
		""
		"Hold a &6Hunter's Lens&r to read the area. Look through it to read one monster whole."
	]
	quest.62751E1F10BB8066.quest_subtitle: "The dark has a number. Learn to read it."
	quest.62751E1F10BB8066.title: "Reading the Threat"
	quest.63233232B452D155.quest_desc: [
		"The desert has a mouth. Find its &6nest&r and stand where the sand trembles, briefly."
		""
		"It surfaces under you, spits poison and dives again. Keep moving so it misses, stay out of the green pools, and hit it hard every time it shows its head."
	]
	quest.63233232B452D155.quest_subtitle: "A nest in the desert. Level 25."
	quest.63233232B452D155.title: "Sirok, the Sandworm"
	quest.638690A07E4AB834.quest_desc: [
		"The Realm is fading behind you, the way a dream does when you try to remember it."
		""
		"&7Depart the Realm through a grace and walk out into the Overworld."
	]
	quest.638690A07E4AB834.quest_subtitle: "Go home. Look up."
	quest.638690A07E4AB834.title: "The Waking World"
	quest.639D8FCB83578040.quest_desc: [
		"A &6Farming Crate&r harvests, replants and stores everything in the 9×9 around it, and never voids a harvest."
		""
		"Set one in the middle of the village fields and go kill something. Supper will be waiting."
	]
	quest.639D8FCB83578040.quest_subtitle: "Let the box do the stooping."
	quest.639D8FCB83578040.title: "The Crate That Farms"
	quest.63F14370CFF061C7.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"I can't follow you in, Ashborn. Nothing living can, and I'm not sure I count as living any more. Come back with the light. I'll keep the fire going.\"&r"
		""
		"Black sun. A burning tree on the horizon. Silence. The Realm is the Eighth's memory of the world, frozen at the moment he swallowed the light. Nothing here can be built, and nothing can be broken."
		""
		"&7You arrive at an &6Arrival Shrine&7 with a return Waygate and a &6Grace Ember&7. Rest at graces to heal and set your respawn; their golden motes lead to the nearest arena."
	]
	quest.63F14370CFF061C7.quest_subtitle: "The Realm will not change."
	quest.63F14370CFF061C7.title: "&5Beneath the Eclipse"
	quest.6456CEF413461135.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"When a Sovereign went mad, its champions went with it. They still carry their master's light. Take it back.\"&r"
		""
		"About one hostile in twenty-five wears a &6gold title&r: a &6champion&r, sworn to a Sovereign an age ago and never released from the oath. Champions carry the Sovereigns' &6Fragments&r, the shards of the broken sun, and affixes like Blazing, Phasing or Warded."
		""
		"&7Kill one."
	]
	quest.6456CEF413461135.quest_subtitle: "Gold titles. Sovereign Fragments."
	quest.6456CEF413461135.title: "Champion's Bane"
	quest.645BFBE6FFB12A04.quest_desc: [
		"Refunding nodes one by one costs experience. A &6Tome of Unbinding&r (a book, an ender pearl and two lapis) refunds the whole Constellation for free, and lets you choose a new origin."
		""
		"Builds can be copied as codes from the tree screen. Steal a good one; nobody owns the stars."
	]
	quest.645BFBE6FFB12A04.quest_subtitle: "Every star returned."
	quest.645BFBE6FFB12A04.title: "Tome of Unbinding"
	quest.6492667B55216AA8.quest_desc: [
		"Twelve &6keystones&r change the rules, and every one charges for it. &6Glass Cannon&r trades a quarter of your health for damage. &5Blood Pact&r pays in blood. &2Bedrock Will&r blunts every blow and slows every cooldown."
		""
		"Take one. Read the price first."
	]
	quest.6492667B55216AA8.quest_subtitle: "Break a rule. Pay for it."
	quest.6492667B55216AA8.title: "Keystones"
	quest.6493FE1CBE6B9CD4.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"That horn means one of them has your scent. Don't run. They're faster, and they've done this before.\"&r"
		""
		"From level 30 the rarest rank rises: a &cRemnant&r, a monster that died so often it grew a name and a title out of the habit. Its horn carries for forty-eight blocks. It never despawns. When it falls, the whole world hears."
		""
		"&7Kill a Remnant."
	]
	quest.6493FE1CBE6B9CD4.quest_subtitle: "It has a name. It has a horn. It has killed people like you."
	quest.6493FE1CBE6B9CD4.title: "&cA Remnant's End"
	quest.64DA6EF3552845CF.quest_desc: [
		"A &6staff&r is a catalyst: &eR&r casts its bound &bsorcery&r, paid in FP, scaling with &bIntelligence&r. The &6Astral Staff&r throws a Starshard Bolt."
		""
		"Later staves call storms, starshard barrages and gravity itself. Swinging one at a skeleton remains, technically, an option."
	]
	quest.64DA6EF3552845CF.quest_subtitle: "Staves"
	quest.64DA6EF3552845CF.title: "Read the Stars"
	quest.64E68A9320821FE6.quest_desc: [
		"The illagers keep their worst sorcerer in the &6woodland mansions&r of the dark forests, waiting on the stairs like a host who hates guests."
		""
		"It conjures fangs under your feet and calls spirits to fight for it. Never stand still, put the summons down fast, and close in between casts."
	]
	quest.64E68A9320821FE6.quest_subtitle: "A woodland mansion. Level 30."
	quest.64E68A9320821FE6.title: "The Invoker"
	quest.653EF093B9903AC4.quest_desc: [
		"&6Curved swords&r are for those who'd rather not be standing where the blow lands. Fast, hungry for Dexterity, &6Quickstep&r on &eR&r."
		""
		"The &6Fangtooth Cleaver&r frenzies and bleeds (&6Frenzied Strikes&r). The &6Magma Falchion&r was quenched in molten rock and still cuts with fire."
	]
	quest.653EF093B9903AC4.quest_subtitle: "Curved swords"
	quest.653EF093B9903AC4.title: "The Curve of It"
	quest.65601A0EB7F957AD.quest_desc: [
		"With the sun gone, the moon is the only light that still crosses the sky. Some groves learned to live on it."
		""
		"Find a &6Moonlight Grove&r. It's the prettiest thing the Eclipse didn't kill."
	]
	quest.65601A0EB7F957AD.quest_subtitle: "Terralith. The Moonlight Grove."
	quest.65601A0EB7F957AD.title: "By the Moon's Grace"
	quest.65A7F79D6DA0D6EC.quest_desc: [
		"Every floor ends behind a boss. Then comes the choice: &aRemember&r or &cForget&r."
		""
		"&aRemember&r banks your &6Renown&r times your &6Momentum&r, brings your sealed Relics home and earns a better key. Your Codex keeps it forever, and a quarter of the Renown comes home as &6Valor&r."
	]
	quest.65A7F79D6DA0D6EC.quest_subtitle: "Bank it. Go home. Keep it forever."
	quest.65A7F79D6DA0D6EC.title: "&aRemember"
	quest.65CD1B65F3364DF4.quest_desc: [
		"Cut grass, wheat or rice with your knife and keep the &6straw&r."
		""
		"Straw twists into rope and canvas. Rope climbs, and tomatoes climb it too. Canvas keeps the rain off the larder."
	]
	quest.65CD1B65F3364DF4.quest_subtitle: "Nothing in a village goes to waste."
	quest.65CD1B65F3364DF4.title: "Grasping at Straws"
	quest.65E3C17D51F13C6D.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Hot, isn't it? He wanted it to stay warm forever. Be careful what you wish for when you wear a crown.\"&r"
		""
		"The portal hums with old heat. On the other side, the sky is the colour of a forge and the ground still remembers being a kingdom."
		""
		"&7Mob levels start high in the Ashlands. Go prepared."
	]
	quest.65E3C17D51F13C6D.quest_subtitle: "Morgrath's ash is still falling."
	quest.65E3C17D51F13C6D.title: "&6The Ashlands"
	quest.66127E66408DD797.quest_desc: [
		"A pillar of living obsidian. It doesn't walk; it doesn't need to."
		""
		"Its runes change colour before each attack. Learn the colours, and the fight becomes a dance. Ignore them, and it becomes a short one."
	]
	quest.66127E66408DD797.quest_subtitle: "An arena among the End islands. Level 75."
	quest.66127E66408DD797.title: "The Obsidilith"
	quest.663A276CBC8CEB08.quest_desc: [
		"The Cryptborn's warden-in-waiting. It carries &6Grave Iron&r, and sometimes the &6Crypt Key&r itself; if not, six Grave Iron around an iron block makes one."
		""
		"It's slow and heavy-handed. Bait the swing, roll, punish. Leave the rats for later."
	]
	quest.663A276CBC8CEB08.quest_subtitle: "The Eclipsed Realm. Level 75."
	quest.663A276CBC8CEB08.title: "The Burial Guardian"
	quest.669ACB3AAEA214D2.quest_desc: [
		"An &6Explorer's Compass&r: a plain compass ringed with cracked stone bricks and cobwebs, as if it had been somewhere already."
		""
		"Use it to pick any structure in the world by name; it points the way and tells you how far. It won't tell you what's inside."
	]
	quest.669ACB3AAEA214D2.quest_subtitle: "Every ruin has a name. This finds it."
	quest.669ACB3AAEA214D2.title: "&6The Compass That Knows"
	quest.66EEF900D3D6B3A0.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Some things are older than the Crown, Ashborn. Older than the sun, maybe.&r"
		""
		"&f&oThe Warden in the deep dark, who listens for heartbeats. The Drowned Keeper under the sea. The Wither, which is only hunger with three mouths. And the Dragon at the edge of the world. They never knelt to the Crown, and the Sovereigns were wise enough to leave them alone.&r"
		""
		"&f&oEach of them keeps a relic of the world before. Not light, exactly. Memory. What the world was like when it was young.&r"
		""
		"&f&oYou'll need that memory where you're going. The storm-lord waits beneath the waves, and the gardener behind her roses. Go down. The deep has been waiting for someone to bother it.\"&r"
		""
		"The &5Old Powers&r are the world's first guardians: the &6Warden&r, the &6Elder Guardian&r, the &6Wither&r and the &6Ender Dragon&r. Each keeps a &6Relic&r, and the Relics are the only things left that remember the sun as it was."
	]
	quest.66EEF900D3D6B3A0.quest_subtitle: "Older than the Crown. Maybe older than the sun."
	quest.66EEF900D3D6B3A0.title: "&e♪ &6The Tale of the Old Powers"
	quest.67A822FF15E3AF09.quest_desc: [
		"The &6straight sword&r does everything adequately, which is more than most things in this world can say. Ten stamina a swing, Strength and Dexterity alike, and &6War Cry&r on &eR&r to harden you for the fight."
		""
		"The &6Errant Longsword&r was carried by knights who swore to no lord. Later blades burn (&6Emberbrand&r), freeze (&6Rimeguard Sword&r) or rot (&6Ossuary Blade&r)."
	]
	quest.67A822FF15E3AF09.quest_subtitle: "Straight swords"
	quest.67A822FF15E3AF09.title: "Honest Steel"
	quest.67B64790B596F3B0.quest_desc: [
		"A white brute the size of a house, asleep on the open snow. You can steal the &6Ice Crystal&r it keeps while it sleeps. You can also try to walk away afterwards."
		""
		"Its breath freezes and its swipes sweep wide. Stay at its flank, roll the slam, and never fight it on thin ice."
	]
	quest.67B64790B596F3B0.quest_subtitle: "Asleep in the snowfields. Level 25."
	quest.67B64790B596F3B0.title: "The Frostmaw"
	quest.67C536F94BDB9C78.quest_desc: [
		"An &cOvercharged&r creeper carries twice a lightning-struck creeper's blast. The Huntmaster pays well for one that dies quietly."
		""
		"&7Kill the rest of the Wrongborn: Climb, Hunter, Adaptive and Overcharged."
	]
	quest.67C536F94BDB9C78.quest_subtitle: "The one that takes the hillside."
	quest.67C536F94BDB9C78.title: "&cOvercharged"
	quest.67ED0BC9562790E0.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Six embers. Down there, for the first time in an age, the ash has stopped falling. His people can rest now. Maybe he can too.\"&r"
		""
		"Fire doesn't hurt him. Everything else does, just less than you'd like. He doesn't fight to win. He fights so that nobody else does."
		""
		"&7His Crown Shard makes its bearer immune to fire. Earn it."
	]
	quest.67ED0BC9562790E0.quest_subtitle: "Sovereign of the Burning Crown. Level 50."
	quest.67ED0BC9562790E0.title: "&6Sovereign: Morgrath, Ash Sovereign"
	quest.67F80731A0585B0A.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Follow the eyes. They know where the edge is. They've been trying to get back there since the sky went dark.\"&r"
		""
		"The &6strongholds&r were the Crown's watchtowers, built over the one door that leads off the edge of the world. The eyes still point the way home."
		""
		"&7Find a stronghold."
	]
	quest.67F80731A0585B0A.quest_subtitle: "Somewhere below, a portal to the Last Shore."
	quest.67F80731A0585B0A.title: "The Eye of the World"
	quest.6823AEF49166175C.quest_desc: [
		"&6Varghast's&r relic becomes his &6Graft-Axe&r or &6Crownsplitter&r, the colossal sword he grafted to his own arm. Both want more Strength than is polite."
		""
		"&6Sylvara's&r becomes her &6Frostbound Staff&r, winter on command for a sorcerer, or &6Rimeveil&r, her veil folded into a katana."
	]
	quest.6823AEF49166175C.quest_subtitle: "Varghast and Sylvara"
	quest.6823AEF49166175C.title: "Graft and Frost"
	quest.685BB5F97A1C8228.quest_desc: [
		"Mix &6Organic Compost&r from dirt, straw, bone meal and rotten flesh (or tree bark), set it down and leave it be. Sunlight, water and nearby mushrooms hurry it along."
		""
		"In time it turns into &6Rich Soil&r. Crops grown in it get a free push now and then, and mushrooms planted on it spread into colonies."
		""
		"&7The dead feed the living. Even here."
	]
	quest.685BB5F97A1C8228.quest_subtitle: "Rot, patience, then something green."
	quest.685BB5F97A1C8228.title: "Plant Food"
	quest.69446A3F5A0ACE55.quest_desc: [
		"Wild &6cabbages&r, &6tomatoes&r, &6onions&r and &6rice&r still grow where farms stood before the Eclipse: on beaches, in the warm grasslands, along the rivers. Village farms sometimes keep a row of them."
		""
		"Gather any of them and bring the seed home."
	]
	quest.69446A3F5A0ACE55.quest_subtitle: "Somebody planted these, once."
	quest.69446A3F5A0ACE55.title: "Crops of the Wild"
	quest.6988026593AB272B.quest_desc: [
		"&6Shafts&r carry rotation in a straight line. &6Cogwheels&r pass it sideways, and a &6Large Cogwheel&r meshed with a small one changes the speed."
		""
		"Everything in Create turns. Learn to make it turn."
	]
	quest.6988026593AB272B.quest_subtitle: "Turn one thing; turn everything."
	quest.6988026593AB272B.title: "Shafts and Cogs"
	quest.69DA8552347527AD.quest_desc: [
		"Steel forgets. Tempering Stones remind it: crushed bone-iron from the old forges, pressed into the blade until it remembers being sharp."
		""
		"&7Tempering Stones take standard armaments up to &6+25&7. The first are cheap: iron, flint and cobbled deepslate. Reinforce your weapon at a shrine."
	]
	quest.69DA8552347527AD.quest_subtitle: "+1 is a beginning."
	quest.69DA8552347527AD.title: "Tempered Steel"
	quest.6AA9A3468FD7793E.quest_desc: [
		"An Elite has risen three times. Each death took something human from it and gave back something worse. It carries a blue crest and two traits."
		""
		"&7Elites pay triple experience, extra loot, a Remnant Shard and bonus Valor. Kill one."
	]
	quest.6AA9A3468FD7793E.quest_subtitle: "Kill something that has died before."
	quest.6AA9A3468FD7793E.title: "Proven Hunter"
	quest.6AEEA1DF18061060.quest_desc: [
		"Sometimes the dead come back &obigger&r. Mutants spawn wherever their ordinary kin do, only rarely; the enderman kind is easiest to find in the End."
		""
		"The &6Mutant Zombie&r goes down and gets back up: set it on fire while it's down. The &6Mutant Skeleton&r out-shoots you, so close in. The &6Mutant Creeper&r pounces; don't be where it lands. The &6Mutant Enderman&r throws the landscape at you."
	]
	quest.6AEEA1DF18061060.quest_subtitle: "Mutant Monsters. Level 25."
	quest.6AEEA1DF18061060.title: "Things That Rose Wrong"
	quest.6AFD03D05428FB28.quest_desc: [
		"Morgrath's war-forts still stand, manned by the things that tended his furnaces. The blazes were his smiths. The wither skeletons were his honour guard, and they still salute anything with a crown."
		""
		"&7Find a fortress and take eight blaze rods."
	]
	quest.6AFD03D05428FB28.quest_subtitle: "Blaze rods and wither skulls."
	quest.6AFD03D05428FB28.title: "A Fortress in the Ash"
	quest.6B298C443C41887C.quest_desc: [
		"The last map points to the snow: plains, slopes, groves and taigas. Under the ice burns the &6Soulfire Crypt&r, and the &6Cinder Warden&r keeps its fire blue."
		""
		"Fire Resistance won't save you from what's holding the sword. It helps with everything else."
	]
	quest.6B298C443C41887C.quest_subtitle: "Tier IV: the Soulfire Crypt."
	quest.6B298C443C41887C.title: "Cold Fire"
	quest.6B34B1BE171CDCCA.quest_desc: [
		"An empty suit of armour with an axe and a grudge, locked in a &6Wrought Chamber&r under the hills."
		""
		"From the front it shrugs off everything. Bait the big swing, roll aside, and when the axe bites the floor, get behind it and hit its back. Repeat until it stops getting up."
	]
	quest.6B34B1BE171CDCCA.quest_subtitle: "A sealed chamber underground. Level 20."
	quest.6B34B1BE171CDCCA.title: "The Ferrous Wroughtnaut"
	quest.6B4F33F8809D9497.quest_desc: [
		"Hang a &6Hammock&r between two &6Rope and Nails&r and you can sleep through the &oday&r instead."
		""
		"For Ashborn who prefer to hunt when the hunting is good."
	]
	quest.6B4F33F8809D9497.quest_subtitle: "Some hunts only happen after dark."
	quest.6B4F33F8809D9497.title: "The Night Shift"
	quest.6B937298FD1028CD.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"It's done. Eight embers. Can you feel it? The light is coming back the way it left: all at once. Come home, Ashborn. Come and see the sun.\"&r"
		""
		"He drank the sun and became a crown with nothing inside. He will tell you it was his by right. He will tell you nobody else remembered him. Both are true. Neither matters now."
		""
		"&7Three-hit combos and a throne slam; break his guard with an &6axe&7. At two thirds his pauldrons fly and spectral royal guards rise. At one third, spectral crescents and a soul lunge. At the very end, &c\"The Last Command\"&7: a rain of blades."
	]
	quest.6B937298FD1028CD.quest_subtitle: "The Last King. The eighth light."
	quest.6B937298FD1028CD.title: "&6&lThe Hollow Sovereign"
	quest.6BAD9AD42869E32B.quest_desc: [
		"Your gear doesn't scatter. It stays in your &6corpse&r, lying where you died. Open it and take everything back with &6Transfer Items&r."
		""
		"The Echo's armour is only a copy, and it drops nothing. The real thing is in the corpse it's standing on, which is exactly why it's standing there."
	]
	quest.6BAD9AD42869E32B.quest_subtitle: "Your things wait where you fell."
	quest.6BAD9AD42869E32B.title: "What the Corpse Keeps"
	quest.6C3C7785780D7DD1.quest_desc: [
		"Under the deserts and badlands, a king was buried with his court and never told to stop ruling. The &6Tomb King&r is a husk with a crown and a long memory."
		""
		"Bring food and a way to see in the dark. Leave with whatever he was holding; guardians always drop their weapons."
	]
	quest.6C3C7785780D7DD1.quest_subtitle: "A Labyrinth: the Sunscorched Tomb."
	quest.6C3C7785780D7DD1.title: "Dethroned"
	quest.6C617748F8950056.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Sylvara buried her piece of the sun under the snow to keep it from melting away. It worked. Nothing there has melted in an age, including her.\"&r"
		""
		"&6Sylvara, Frost Matron&r, rules the &bRime Veil&r: the frozen lands where the last warmth of the old sun was buried and kept, like a seed nobody was allowed to plant. Her token is &bblue ice&r."
		""
		"&7Before you call her, learn the cold. In the frozen peaks the &6Frostmaw&7 guards its ice crystal; under the ice, the &6Rimefrost Vaults&7 hold a Frost Lich."
	]
	quest.6C617748F8950056.quest_subtitle: "Where the cold went to hide."
	quest.6C617748F8950056.title: "The Rime Veil"
	quest.6C6C3832262BBC37.quest_desc: [
		"Blow an &6Encased Fan&r through fire to smoke, through lava to smelt, through water to wash. Through &6soul fire&r it &6haunts&r: things come out the other side changed."
		""
		"Run a belt of raw meat past a fire and the whole village eats tonight."
	]
	quest.6C6C3832262BBC37.quest_subtitle: "Bulk cooking, the engineer's way."
	quest.6C6C3832262BBC37.title: "Through Fire and Soul Fire"
	quest.6CA5B84D2F345074.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Smith is singing. Badly. The Company's captain is pretending not to cry. Come home, Ashborn. Somebody saved you a seat by the fire, though I suppose you don't need the fire any more.\"&r"
		""
		"Last Light was the first shrine kindled in an age. Now it is just a village with a strange old fire in the middle and a great many people who owe you a drink."
		""
		"&7Rest at the Ember Shrine in Last Light."
	]
	quest.6CA5B84D2F345074.quest_subtitle: "Last Light, in daylight."
	quest.6CA5B84D2F345074.title: "Homecoming"
	quest.6CB9503B1FD8393F.quest_desc: [
		"On a stony shore stands a &6Lighthouse&r. Keeper Morrow lives there, and trades with anyone who makes the climb."
		""
		"&o\"A keeper of a light, by the sea. We'd have a great deal to talk about, he and I.\"&r"
	]
	quest.6CB9503B1FD8393F.quest_subtitle: "Another fire someone refused to let go out."
	quest.6CB9503B1FD8393F.title: "Keeper of the Light"
	quest.6CE2F849B3006488.quest_desc: [
		"&6Kaelthar's&r relic becomes his &6Storm Totem&r, a seal that hurls spears of storm, or the &6Stormcaller's Pike&r: raise it and the sky obeys."
		""
		"&6Ysolde's&r becomes &6Crimsonfall&r, a katana that drinks before you do, or the &6Bloodbloom Sigil&r, a seal of Faith and Arcane that ruptures every vein nearby."
	]
	quest.6CE2F849B3006488.quest_subtitle: "Kaelthar and Ysolde"
	quest.6CE2F849B3006488.title: "Storm and Bloom"
	quest.6CFEAF41F7D1C50A.quest_desc: [
		"He calls himself the original Remnant. Four skeleton skulls on the pedestals, a &6Nether Star&r on the altar, and he rises: in any world you like."
		""
		"He can't be hurt while he rises; use the time to breathe. Sword chains and kunai first, then he changes, raises soldiers and dashes. Roll the dash late."
	]
	quest.6CFEAF41F7D1C50A.quest_subtitle: "Anywhere you dare. Level 90."
	quest.6CFEAF41F7D1C50A.title: "&cRemnant: Ossukage"
	quest.6D7FD40BC81A0E63.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"You had a life before the ash. Most of you remember a sword, or a prayer, or a debt. Pick the one that feels true. It won't matter to the dead.\"&r"
		""
		"Your &6origin&r is the shape your last life left in you: Knight-Errant, Warlord, Duelist, Cutthroat, Astromancer, Oracle, Ronin, Penitent, Hexblade… or &7Ashborn&r, risen with nothing at all."
		""
		"&7It sets your starting attributes and armament. A &6Tear of Rebirth&7 lets you choose again later, so don't agonise. The dark won't wait."
	]
	quest.6D7FD40BC81A0E63.quest_subtitle: "Pick the life you half-remember."
	quest.6D7FD40BC81A0E63.title: "What You Were"
	quest.6D86DE336AB40AB6.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"The Smith can make something of that. He says the Rider's glaive still keeps time, if you listen.\"&r"
		""
		"A Sovereign's &6Relic&r is the part of them that refused to die: the habit they couldn't break, hardened into an object."
		""
		"&7Exchange the relic at a shrine for its legendary armament, the &6Duskrider Glaive&7."
	]
	quest.6D86DE336AB40AB6.quest_subtitle: "Every Sovereign leaves something behind."
	quest.6D86DE336AB40AB6.title: "A Relic Remembered"
	quest.6E014AE2ED557564.quest_desc: [
		"A &6Backpack&r is leather, string and a chest. Carry it, wear it or set it down; it keeps everything inside either way."
		""
		"&7When you die, your items wait in your corpse. A backpack is one item. Think about that."
	]
	quest.6E014AE2ED557564.quest_subtitle: "Pack light. Then don't."
	quest.6E014AE2ED557564.title: "Everything You Own, Carried"
	quest.6EC45FFDFEE6E919.quest_desc: [
		"A &5Champion&r has risen four times. By now it remembers nothing of who it was, only how it died, and it has learned to make sure that never happens again."
		""
		"&7It carries three traits and pays five times the experience of its kind. Read its traits before you swing: a &cVolatile&7 one explodes when it dies; a &bBlinking&7 one teleports behind you; a &6Packleader&7 calls its pack at 60% health."
	]
	quest.6EC45FFDFEE6E919.quest_subtitle: "Purple crest. Three traits. Bad news."
	quest.6EC45FFDFEE6E919.title: "Champion's Crest"
	quest.6F9D0921E45DDD1A.quest_desc: [
		"Right-click a ripe crop to harvest and replant it in one motion. With a hoe in hand the harvest sweeps: iron or gold 3×3, diamond 5×5."
		""
		"A &6Sprinkler&r (copper and a bucket) keeps a 9×9 field wet and growing about three times as fast. It needs water within four blocks, below it or beside it."
	]
	quest.6F9D0921E45DDD1A.quest_subtitle: "The sky stopped helping. Copper didn't."
	quest.6F9D0921E45DDD1A.title: "Rain on Demand"
	quest.6FBD402AF700B0A6.quest_desc: [
		"Pour a &6Transmuting Elixir&r on an &6Infernal Evil Pumpkin&r and the Lord rides out on a burning horse."
		""
		"Take the horse out from under him first: on foot he's slower and angrier, in that order. His bombs are slow, but they are still bombs."
	]
	quest.6FBD402AF700B0A6.quest_subtitle: "Born in Chaos. Level 30."
	quest.6FBD402AF700B0A6.title: "Lord Pumpkinhead"
	quest.701FB9ECA717BD0A.quest_desc: [
		"Bosses of Mass Destruction's &6Night Lich&r keeps a tower in the snow. Not to be confused with the other lich. Or the other other one."
		""
		"It fights from range: volleys of blue fire and comets out of the sky. Close the gap after each volley; up close it's all bones."
	]
	quest.701FB9ECA717BD0A.quest_subtitle: "A tower in the cold lands. Level 30."
	quest.701FB9ECA717BD0A.title: "The Night Lich"
	quest.703249CD6A2EF82D.quest_desc: [
		"Rarest of all is a &cRemnant&r: a named echo with a title, rising only past level 30. It never despawns. Its horn carries 48 blocks (&o\"A Remnant stirs nearby\"&r), it wears a boss bar, and when it falls the whole world hears who did it."
		""
		"Bring full flasks. Read its traits through the Lens first."
	]
	quest.703249CD6A2EF82D.quest_subtitle: "A name, a title and a grudge."
	quest.703249CD6A2EF82D.title: "&cA Remnant's End"
	quest.7056F332A8D9ED0D.quest_desc: [
		"&2Stone Spear&r, &2Stone Skin&r, &2Tremor&r, &2Fissure&r, and the ultimate, &2Mountain's Wrath&r."
		""
		"Keystones: &2Unyielding&r (no knockback and 30% more armour, at a slower walk) and &2Bedrock Will&r (15% less damage taken, for longer cooldowns)."
	]
	quest.7056F332A8D9ED0D.quest_subtitle: "Slow to bleed, slower to fall."
	quest.7056F332A8D9ED0D.title: "&2Earthshaping"
	quest.7074BD6B0D4A6BB7.quest_desc: [
		"The Eighth had regalia made for a coronation that never happened. It tarnished in the dark, waiting."
		""
		"&7Four &6Tarnished Regalia&7, four gold ingots and an &bEcho Shard&7 forge the &6Sovereign's Seal&7. The Hollow Citadel's altar waits for it."
	]
	quest.7074BD6B0D4A6BB7.quest_subtitle: "A seal for a king who isn't there."
	quest.7074BD6B0D4A6BB7.title: "Tarnished Regalia"
	quest.70D8B91F195CC2F6.quest_desc: [
		"Each school's fifth ability is its &6ultimate&r, and it costs two points: &6Meteor&r, &eTempest&r, &5Eclipse&r, &bMaelstrom&r, &2Mountain's Wrath&r, &aVerdant Rebirth&r."
		""
		"Slot one and cast it at something that deserves it."
	]
	quest.70D8B91F195CC2F6.quest_subtitle: "Two points. Worth both."
	quest.70D8B91F195CC2F6.title: "&6The Ultimates"
	quest.723B8D2420490EBB.quest_desc: [
		"The Regalia has weapons too. The &6Greater Golden Axe&r bites harder into the nearly dead; the &6Golden Scythe&r strikes everything in its arc; the &6Greater Golden Hammer&r is mostly an argument."
		""
		"Each takes the template, and an amethyst block, for a reinforced version."
	]
	quest.723B8D2420490EBB.quest_subtitle: "Heavy gold, swung with intent."
	quest.723B8D2420490EBB.title: "Gilded Arms"
	quest.726AEC662B5E70D9.quest_desc: [
		"Not every village kept its fire. The ruined farms, smithies, schools and castles out there are what the Long Eclipse leaves behind: walls, a well, and nobody home."
		""
		"Walk through one. Take what's useful. Don't sleep there."
	]
	quest.726AEC662B5E70D9.quest_subtitle: "Dungeons and Taverns. A ruined settlement."
	quest.726AEC662B5E70D9.title: "What the Dark Left Standing"
	quest.726D1A034A7B4C5F.quest_desc: [
		"Eat a course of every meal the cooking pot knows. It's a long menu. You have, technically, forever."
		""
		"&7A long-term goal. Your advancements list the dishes you still owe."
	]
	quest.726D1A034A7B4C5F.quest_subtitle: "Every dish, at least once."
	quest.726D1A034A7B4C5F.title: "Master of the Last Kitchen"
	quest.72B530DE7D787BE9.quest_desc: [
		"The Matron's court did not die. It froze, mid-feast, mid-sentence, and the Frost Lich who keeps the vaults has been waiting ever since for someone to finish the conversation."
		""
		"&7Clear the Rimefrost Vaults and kill their guardian."
	]
	quest.72B530DE7D787BE9.quest_subtitle: "A labyrinth under the snow."
	quest.72B530DE7D787BE9.title: "The Rimefrost Vaults"
	quest.7343AEBA9E7454A7.quest_desc: [
		"&cForget&r takes the party a floor deeper and raises &6Momentum&r by a quarter. Everyone votes."
		""
		"If the party falls, everything unbanked is lost and the key dims. Greed has a multiplier now. So does grief."
	]
	quest.7343AEBA9E7454A7.quest_subtitle: "Deeper, for more. Or for nothing."
	quest.7343AEBA9E7454A7.title: "&cForget"
	quest.736B14FDA7FC812D.quest_desc: [
		"Plant &6rice&r in water one block deep. It grows up out of the water and gives you grain and straw both."
		""
		"Half the cooking pot's recipes start with rice. The other half want an onion."
	]
	quest.736B14FDA7FC812D.quest_subtitle: "Rice wants its feet wet."
	quest.736B14FDA7FC812D.title: "Dipping Your Roots"
	quest.739A57228824E136.quest_desc: [
		"Ferment milk with a brown mushroom, pumpkin seeds and sugar in a &6warm&r keg. Draw the full keg off with a &6honeycomb&r for a rind and you get an &6Unripe Cheese Wheel&r. Set it down and leave it alone."
		""
		"When it's ripe, cut it into wedges on a board. Cheese keeps. Most things in this world don't."
	]
	quest.739A57228824E136.quest_subtitle: "The one thing here that improves with age."
	quest.739A57228824E136.title: "Taste of Time"
	quest.7412822E46239020.quest_desc: [
		"Fill a keg with honey, add wheat, seeds and sweet berries, and wait. &6Mead&r is what the Ashen Company drinks to its dead."
		""
		"Every brew leaves you a little &6Tipsy&r. Don't roll into a fight seeing double."
	]
	quest.7412822E46239020.quest_subtitle: "Honey, wheat and sweet berries. And time."
	quest.7412822E46239020.title: "Mead for the Living"
	quest.7471008BCC83F1C9.quest_desc: [
		"In the old forests stands the &6Arcane Spire&r, kept by an illusionist who split himself into reflections to outlive the dark, and has since forgotten which of him is real."
		""
		"&7Climb the Spire and kill its master."
	]
	quest.7471008BCC83F1C9.quest_subtitle: "Tier II of the dungeon trail."
	quest.7471008BCC83F1C9.title: "The Arcane Spire"
	quest.748040AE2697D524.quest_desc: [
		"In the &cAshlands&r, &6Fire Golems&r walk the wastes, the crimson forests and the basalt deltas. They're slow to die and slower to share."
		""
		"Each one drops &6Fire Runes&r and magma cream, and now and then a whole &6Remnant Tome&r. Blazes carry Fire Runes too."
	]
	quest.748040AE2697D524.quest_subtitle: "Something in the Ashlands kept its light."
	quest.748040AE2697D524.title: "Fire Golems"
	quest.74E6CDE38393A866.quest_desc: [
		"Craft a &6Mechanical Belt&r from dried kelp and connect two shafts with it. Items ride along it, and presses and fans work on them as they pass."
	]
	quest.74E6CDE38393A866.quest_subtitle: "Make the work come to you."
	quest.74E6CDE38393A866.title: "On the Belt"
	quest.74EC35070559D24A.quest_desc: [
		"A Crown warship went down in Kaelthar's storm with every hand aboard. The crew are long gone. The thing that sank it never left."
		""
		"&7Kill the Kraken."
	]
	quest.74EC35070559D24A.quest_subtitle: "A wreck that still has a captain."
	quest.74EC35070559D24A.title: "The Kraken's Ship"
	quest.74F09FE2DD3E57EA.quest_desc: [
		"&o\"They hunt in packs of three to five. So should you, if you have friends. If you don't, roll well.\"&r"
		""
		"Kill &c10 Dread Hounds&r. Where there's a pack there's sometimes a &6Dire Hound Leader&r. It isn't on the contract. It is in your way."
	]
	quest.74F09FE2DD3E57EA.quest_subtitle: "Minor bounty · 10 Dread Hounds"
	quest.74F09FE2DD3E57EA.title: "Contract: Dread Hounds"
	quest.75F5AE3C6F07254E.quest_desc: [
		"Under the deep ocean lies a city, and an &6Altar of Abyss&r that wants an &6Abyssal Sacrifice&r."
		""
		"It cannot be hurt out of the water, so you must go in after it. Water Breathing, Depth Strider, and roll away from the tentacles, not into the dark."
	]
	quest.75F5AE3C6F07254E.quest_subtitle: "The Sunken City. Level 45."
	quest.75F5AE3C6F07254E.title: "The Leviathan"
	quest.7644A14C6A63013E.quest_desc: [
		"&6Thrusting swords&r reach a little further and strike a little faster. Their art is &6Impaling Thrust&r, a lunge that pierces every foe in a line."
		""
		"The &6Noble's Rapier&r trades it for &6Quickstep&r and lives on Dexterity. The &6Thornspur Rapier&r leaves &2Blight&r in every wound."
	]
	quest.7644A14C6A63013E.quest_subtitle: "Thrusting swords"
	quest.7644A14C6A63013E.title: "The Needle"
	quest.7678572C5CDE2BAB.quest_desc: [
		"Monsters drop &6loot bags&r: Common, Uncommon, Rare, Epic, Legendary, &dMythic&r. Hold use to open one; hold &eShift&r over it to read its real odds."
		""
		"Four bags of a tier craft into the next (Mythic also wants a nether star), and any bag splits back into four. Odd ones turn up: &cCursed&r bags gamble, &6Hourglass&r bags ripen if you wait, &bLocked&r bags want a Diamond Key cut from a diamond."
		""
		"Combine four Uncommon bags and open the Rare."
	]
	quest.7678572C5CDE2BAB.quest_subtitle: "Four small sins make a bigger one."
	quest.7678572C5CDE2BAB.title: "The Dead Hoard"
	quest.7678FF900809530E.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Before the Crown, there was a king of sand who refused to die. He was the first. Everything rising out there learned it from him.\"&r"
		""
		"The Hollow Sovereign's warrior, Ossukage, likes to call himself the first Remnant. He's wrong."
		""
		"Under the desert sleeps a pharaoh-thing that rose again before there was a Crown to serve: the &cAncient Remnant&r. The Eclipse didn't make it. It made the Eclipse feel at home."
		""
		"&7Wake it. Then survive it."
	]
	quest.7678FF900809530E.quest_subtitle: "Older than Ossukage. Older than the Crown."
	quest.7678FF900809530E.title: "&cThe Ancient Remnant"
	quest.767A80D2CBCD5AAA.quest_desc: [
		"Below a Fracture Shrine, past the puzzles and a repaired &6Yesterglass Lens&r, the &6Meridian Archive&r still obeys its last order: preserve this day forever. Its keeper agrees."
		""
		"&6Catalogue&r: leave the marked row. &6Revision&r: it seals, then strikes a marked radius; be outside it. &6Erasure&r: it records afterimages of you and detonates them where you stood, so keep moving. Hit the core whenever it's exposed."
	]
	quest.767A80D2CBCD5AAA.quest_subtitle: "The Meridian Archive. Level 30."
	quest.767A80D2CBCD5AAA.title: "The Last Curator"
	quest.77326E9BE51A54C4.quest_desc: [
		"Small chapels stand alone in the plains and forests, their doors open and their candles cold. Somebody prayed for the sun here. It didn't come."
		""
		"Find one. Light a candle if you like. It can't hurt."
	]
	quest.77326E9BE51A54C4.quest_subtitle: "Structory. An abandoned chapel."
	quest.77326E9BE51A54C4.title: "Where the Prayers Stopped"
	quest.78696D547ABF637A.quest_desc: [
		"Runes are light; &6Valor&r is memory. Every kill teaches your body something, and your body keeps it."
		""
		"&7Kills give Valor. Valor gives &6RPG levels&7, and every level gives attribute points. Press &eK&7 to open the &6Level Up&7 screen: stage points, preview, confirm."
	]
	quest.78696D547ABF637A.quest_subtitle: "Your first level."
	quest.78696D547ABF637A.title: "Taste of Valor"
	quest.786FC37A4A6098F2.quest_desc: [
		"Morgrath's greatest forge was built to make a weapon that could never be broken. It worked. The weapon was the forge, and it got up."
		""
		"&7Kill the Netherite Monstrosity."
	]
	quest.786FC37A4A6098F2.quest_subtitle: "A forge that learned to walk."
	quest.786FC37A4A6098F2.title: "The Netherite Monstrosity"
	quest.78776E476DD6B987.quest_desc: [
		"Surround a backpack with iron in a crafting grid and it grows, with everything still inside. Copper, iron, gold, diamond, netherite: each tier holds more and fits more upgrades."
	]
	quest.78776E476DD6B987.quest_subtitle: "Bigger, and nothing falls out."
	quest.78776E476DD6B987.title: "Iron-Bound"
	quest.78F7124FE9EA4E98.quest_desc: [
		"A &6sacred seal&r casts &eincantations&r on &eR&r, scaling with &eFaith&r. The &6Pilgrim's Seal&r calls down Blessed Flame."
		""
		"The &6Seal of the Golden Rite&r mends you and your allies; the &6Flame Prayer Seal&r raises a pillar of fire under your foe."
	]
	quest.78F7124FE9EA4E98.quest_subtitle: "Sacred seals"
	quest.78F7124FE9EA4E98.title: "Prayers That Answer"
	quest.79248E793BD1E258.quest_desc: [
		"&6Keeper Morrow&r has kept a lamp lit on the stony shore through the whole Long Eclipse. You're not the only one who tends a fire."
		""
		"Go and say hello. He doesn't get many visitors who aren't drowned."
	]
	quest.79248E793BD1E258.quest_subtitle: "Fisherman's Coast. A lighthouse on the stones."
	quest.79248E793BD1E258.title: "Keeper of the Light"
	quest.794789CB3EBFB77B.quest_desc: [
		"A &6Warbanner&r is gold around a black banner, on a stick, or twenty gold from Maren. Use it on the ground to plant it, and your warband guards it in formation. Use it in the air to lift it, and they follow you again."
		""
		"Formations: &6Line&r, &6Wedge&r, &6Shield Wall&r and &6Circle&r, around you or around the banner."
	]
	quest.794789CB3EBFB77B.quest_subtitle: "A place to stand."
	quest.794789CB3EBFB77B.title: "Plant the Banner"
	quest.799E9723EEE4C197.quest_desc: [
		"&6Daggers&r are quick, short and cheap: six stamina a swing. Most carry &6Quickstep&r, a burst of speed through an attack."
		""
		"They're built for &cstatus&r. The &6Cutthroat's Kris&r builds &cHemorrhage&r; the &6Venomfang Stiletto&r, &2Poison&r. Every hit fills the meter, and when it bursts, it hurts."
	]
	quest.799E9723EEE4C197.quest_subtitle: "Daggers"
	quest.799E9723EEE4C197.title: "The Short Answer"
	quest.79BAD0382EFA559F.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Another one. Up you get. The ash doesn't keep its dead for long.&r"
		""
		"&f&oListen, because I'll only say it once. Once there was a sun, and a crown to hold its light. Seven rulers swore to share it, so they broke the sun into pieces and each carried one home. An eighth wanted all of it. He drank the last light himself, and the sky went black.&r"
		""
		"&f&oSince then, nothing that dies here stays dead. It comes back wrong. Remnants, we call them. And you came back too, little ember. That makes you the brightest thing left in the world. They will want it. Let's not give it to them.\"&r"
		""
		"You are one of the &6Ashborn&r: risen from ash with no name, no memory and no way to stay dead. The &cRemnants&r, everything that died under the Eclipse and rose wrong, can smell the light in you."
		""
		"&7Press &eI&7 for your &6Status&7 and the &6Ashen Codex&7. Everything this world will try to kill you with is written there."
	]
	quest.79BAD0382EFA559F.quest_subtitle: "The sun was eaten an age ago."
	quest.79BAD0382EFA559F.title: "&6Rise, Ashborn"
	quest.79C830E03DC57E0F.quest_desc: [
		"&o\"Creepers always came back. That's what they're for. But some of them came back… improved.\"&r &7— the Huntmaster"
		""
		"The &aWrongborn&r are creepers the Eclipse tinkered with: &aLeap&r and &aClimb&r creepers that come at you from above, &aSwift&r ones you hear too late, &aSilent&r ones you never hear at all, &aHunters&r that track you, &aAdaptive&r ones that learn, and the &cOvercharged&r, which take half a hillside with them."
		""
		"Kill them before they finish their sentence."
	]
	quest.79C830E03DC57E0F.quest_subtitle: "Creepers that rose wrong."
	quest.79C830E03DC57E0F.title: "&aThe Wrongborn"
	quest.7A11D1EEA3BD0D28.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Put it down, Ashborn. It doesn't fit anyone. That was always the problem.\"&r"
		""
		"Six Sovereigns' shards and the Dragon's. The &6Sun-Crown&r, whole for the first time since it was broken. It is lighter than you'd think, and colder."
		""
		"&7Remake the Crown from all seven shards."
	]
	quest.7A11D1EEA3BD0D28.quest_subtitle: "Seven shards. One Sun-Crown."
	quest.7A11D1EEA3BD0D28.title: "&6The Crown Remade"
	quest.7A21A291E4DB088D.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"I knew him, you know. Before.&r"
		""
		"&f&oHe wasn't a king. He was a herald, one of the ones who carried the flame between the seven and never kept any for himself. When they broke the sun, they forgot him. No Fragment for the herald. No crown.&r"
		""
		"&f&oSo he took what was left. All of it. He drank the last of the sun and walked behind it, into the black, and the light went out inside him the moment he swallowed it. A crown with nothing inside.&r"
		""
		"&f&oHe's still sitting there, on his throne, under the sun he ate, waiting for someone to tell him it was worth it. It wasn't. Go and tell him.\"&r"
		""
		"The &5Hollow Sovereign&r, the Eighth, the Last King, sits in the &5Eclipsed Realm&r: a land behind the black sun, made of the light he swallowed and could not keep."
	]
	quest.7A21A291E4DB088D.quest_subtitle: "The one who wanted all of it."
	quest.7A21A291E4DB088D.title: "&e♪ &6The Tale of the Eighth"
	quest.7A711F495C4A3D36.quest_desc: [
		"A sellsword that drops isn't dead yet. It's &cdowned&r, bleeding out for thirty seconds. Crouch beside it for three to pull it back up, or let your Mender do it."
		""
		"One that bleeds out limps back to camp after five minutes. On harsher worlds it doesn't come back at all, and its name goes into the &6Remembrance&r."
	]
	quest.7A711F495C4A3D36.quest_subtitle: "Thirty seconds is a long time to bleed."
	quest.7A711F495C4A3D36.title: "Downed, Not Dead"
	quest.7A936AC05E6E9BA9.quest_desc: [
		"&6The Keeper&r &e♪"
		""
		"&f&o\"Good. Now you know. Everyone dies once. The trick is not to make a habit of it. Go back to where you fell. Something is wearing your face, and it is holding your light.\"&r"
		""
		"Here, the dead don't stay quiet, and that includes you. Where you fell, an &cEcho&r of you rises: a Remnant that wears your face, your gear and your name, guarding the runes you dropped."
		""
		"&7Kill your own Echo to take them back. Die again before you do, and the Echo and your runes fade into the ash together."
	]
	quest.7A936AC05E6E9BA9.quest_subtitle: "Not the last time."
	quest.7A936AC05E6E9BA9.title: "&4YOU DIED"
	quest.7AAFFE69C8355986.quest_desc: [
		"Something with a great deal of fur keeps a hideout in the snowy plains, and it throws ice the size of a cart."
		""
		"Spikes run along the ground before they erupt: roll across the line, not along it. When it leaps, move. When it lands, punish."
	]
	quest.7AAFFE69C8355986.quest_subtitle: "A hideout in the snowy plains. Level 20."
	quest.7AAFFE69C8355986.title: "Skor, the Yeti"
	quest.7B54978A2BB19EE5.quest_desc: [
		"&o\"Piglins you can bargain with. Brutes you bury. Three of them.\"&r"
		""
		"Kill &c3 piglin brutes&r. They guard the bastions, they never stop chasing, and gold won't buy them off."
		""
		"&7Brutes don't come back once a bastion is cleared. Each contract needs a fresh one."
	]
	quest.7B54978A2BB19EE5.quest_subtitle: "Grave bounty · 3 piglin brutes · the Ashlands"
	quest.7B54978A2BB19EE5.title: "Contract: The Bastion's Wardens"
	quest.7B5BD6C5BA5AF56F.quest_desc: [
		"The first red moon brought the Remnants out, and it brought &6Ilse&r with it. She hunted them before the Eclipse had a name, and she has never once been paid in thanks."
		""
		"&o\"You're the Ashborn who lit the shrine. Good. I need someone who gets back up. I post contracts, you fill them, I pay. Nothing personal, nothing owed.\"&r"
		""
		"Every contract on this board can be taken again once it's paid. Kills count from the moment a contract is posted; collect, and it's posted again from zero."
		""
		"&7Under a Hunter's Moon the board pays the same. The shards don't."
	]
	quest.7B5BD6C5BA5AF56F.quest_subtitle: "She knows every rank and every trait. Ask nicely."
	quest.7B5BD6C5BA5AF56F.title: "&cThe Huntmaster's Board"
	quest.7BCC2DCBDC56577B.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Feel that? A little warmth, where there wasn't any. That was theirs. Now it's yours. Don't lose it.\"&r"
		""
		"When anything dies, the scrap of sunlight it carried leaves it as &6runes&r. The Ashborn are the only things left that can hold them. Runes buy levels, upgrades and wares."
		""
		"&7The cruel part: when &oyou&7 die, your runes stay where you fell."
	]
	quest.7BCC2DCBDC56577B.quest_subtitle: "The light that leaves the dead."
	quest.7BCC2DCBDC56577B.title: "Runes"
	quest.7CA0F3AF7F1D0DE4.quest_desc: [
		"The dead don't all come back the same. &6Decaying Zombies&r smell worse than they hit. &6Bonescallers&r raise the skeletons you thought you'd finished. And somewhere a caravan of &6Zombie Clowns&r is still on tour."
		""
		"Kill the caller first. Kill the clown whenever you like."
	]
	quest.7CA0F3AF7F1D0DE4.quest_subtitle: "Born in Chaos. The things that walk at night."
	quest.7CA0F3AF7F1D0DE4.title: "A Carnival of the Damned"
	quest.7CAE9FA8D44BB153.quest_desc: [
		"Before the Eclipse, the Crown's wardens sealed its worst prisoners underground with cages that bred their own guards. The wardens are gone. The cages still breed."
		""
		"&7Find and clear a dungeon."
	]
	quest.7CAE9FA8D44BB153.quest_subtitle: "Someone built these to keep things in."
	quest.7CAE9FA8D44BB153.title: "Into the Dark Places"
	quest.7CC8D5C9FD545DC8.quest_desc: [
		"Set a powered &6Mechanical Press&r over a depot or a belt and feed it ingots. Out come &6iron sheets&r, the plates half of Create's recipes ask for."
		""
		"Over a basin, the same press compacts things instead."
	]
	quest.7CC8D5C9FD545DC8.quest_subtitle: "Ingots in, sheets out."
	quest.7CC8D5C9FD545DC8.title: "Pressed Flat"
	quest.7CD33967D099FE24.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"When the Hollow Sovereign drank the sun, a drop of it spilled off the edge of the world. It landed there. The Dragon has been guarding it ever since, and it doesn't know why.\"&r"
		""
		"Pale stone under a starless sky. The &6Last Shore&r is where the world ends and the last drop of the old sun fell."
		""
		"&7Enter the End."
	]
	quest.7CD33967D099FE24.quest_subtitle: "The End is where the sun's last light fell."
	quest.7CD33967D099FE24.title: "&6The Last Shore"
	quest.7D6EF30C6076578E.quest_desc: [
		"Where you fall, an &cEcho&r rises: &c\"Echo of <you>\"&r, wearing a copy of your armour and swinging a copy of your weapon, with twice the health it deserves. Fire won't touch it. It stands over your runes."
		""
		"It rises as a zombie, a wither skeleton in the Ashlands, an enderman in the End. Put it down and walk into the glow."
		""
		"Die again first and the Echo fades, with every rune it guarded. &7The Fractured Archive keeps its own rules; no Echo rises there.&r"
	]
	quest.7D6EF30C6076578E.quest_subtitle: "Your death leaves a Remnant."
	quest.7D6EF30C6076578E.title: "&cEcho of the Fallen"
	quest.7E3D4C73C791AAAC.quest_desc: [
		"&6The Keeper&r"
		""
		"&f&o\"Kaelthar was afraid of the dark, so he kept the one thing that still flashed: lightning. He drowned his own coast to keep the storm close. Every bolt you see out there is him, still talking to it.\"&r"
		""
		"&6Kaelthar the Stormcaller&r, Sovereign of the Drowned Sky, flooded his kingdom to keep the storm for himself. His token is a &6lightning rod&r."
		""
		"&7Before him, the drowned coast has other things to fight: a sunken city with a Leviathan, a kraken's ship, a frozen pirate captain. None is required. All of them will teach you about water."
	]
	quest.7E3D4C73C791AAAC.quest_subtitle: "Kaelthar spoke to the storm."
	quest.7E3D4C73C791AAAC.title: "The Drowned Sky"
	quest.7E4AFBBD2C4C680D.quest_desc: [
		"Unique armaments, &6Epic&r and &6Legendary&r, don't take tempering. They climb to &6+10&r on &6Lustrous Stones&r, one grade per step (I for +1, on to IX for +9), and a &6Sovereign Lustrous Stone&r for the last."
		""
		"Champions carry them, Sovereigns leave two, and the Merchant sells the first three. A unique armament can't be infused, so the plus is all it will ever get. Make it count."
	]
	quest.7E4AFBBD2C4C680D.quest_subtitle: "Unique steel climbs slower."
	quest.7E4AFBBD2C4C680D.title: "Lustrous Stones"
	quest.7EBB2B0B118FE4D0.quest_desc: [
		"A &6katana&r cuts fast and bleeds. Its art is &6Unsheathe&r: gather focus, then cut everything before you in one draw."
		""
		"The &6Ronin's Uchigatana&r builds &cHemorrhage&r from the first swing. The &6Longfang Nodachi&r is too long to draw quickly and too deadly for that to matter."
	]
	quest.7EBB2B0B118FE4D0.quest_subtitle: "Katanas"
	quest.7EBB2B0B118FE4D0.title: "One Draw"
	quest.7ED324DAAC228EA8.quest_desc: [
		"Not everything in the woods wants you dead. Deer flee, boars charge, and bears couldn't care less until you're close."
		""
		"Hunt &6venison&r for the pot and &6fur&r from a bear for the cold. Then leave the rest alone; the world has enough corpses."
	]
	quest.7ED324DAAC228EA8.quest_subtitle: "Naturalist. Deer, boar and bear."
	quest.7ED324DAAC228EA8.title: "The Hunt That Feeds"
	quest.7F2214D371459953.quest_desc: [
		"Place a &6Cutting Board&r, set an item on it and use it with a tool in hand. A knife slices meat, fish and vegetables; an axe strips logs and keeps the bark."
		""
		"More food from less. That's the whole trick of surviving."
	]
	quest.7F2214D371459953.quest_subtitle: "Steel for the monsters. A board for the meat."
	quest.7F2214D371459953.title: "Watch Your Fingers"
	quest.7F30D8E42C88A805.quest_desc: [
		"The Curator leaves a &6Memory Lantern&r. Place it. Use a &6Memory Plate&r on it to load a scene, use it empty-handed to play, crouch-use to clear. The plate isn't used up."
		""
		"Watch one scene through to the end. They were visitors, mostly. The record kept them anyway."
	]
	quest.7F30D8E42C88A805.quest_subtitle: "A memory made small."
	quest.7F30D8E42C88A805.title: "The Past, Kept Kindly"
	reward.16BC1D4DAC9E0D3F.title: "The Company's captain sets up camp at Last Light"
	reward.1B5FD5AE9F90F7CC.title: "Ilse the Huntmaster comes to Last Light"
	reward.532C04A9BE8FB450.title: "Oren the Archivist comes to Last Light"
	reward.586E44229D73C446.title: "The Ashen Codex"
	reward.5D2D8BB547765500.title: "The Keeper takes up residence at your shrine"
	reward.78030302AA635B7F.title: "The Smith Under Ash comes to Last Light"
	reward_table.01F12A1B8202BD5D.title: "Wanderer's Cache"
	reward_table.111016CDBA35A1E9.title: "Wayfarer's Pack"
	reward_table.1123D46C31382E34.title: "Homestead Crate"
	reward_table.11F843B5B9B0669D.title: "Light of the Black Sun"
	reward_table.1BE164D5966AD543.title: "Grave Bounty"
	reward_table.1F54F5F182F2E084.title: "Ashen Lessons"
	reward_table.24C9AAFCDBABE6BF.title: "Last Light Pantry"
	reward_table.2A8F9BA268F4E60E.title: "Starfall Cache"
	reward_table.375950714300E36B.title: "Engineer's Crate"
	reward_table.3784F7C288C8E639.title: "Embers' Bounty"
	reward_table.40BEFDDFA7BC807B.title: "The Tavern Cellar"
	reward_table.40CE7AD0E43456F2.title: "What the Ash Kept"
	reward_table.48C49FF6FDFC3A35.title: "Fisher's Tackle"
	reward_table.4A371DC5024C8B48.title: "The Huntmaster's Ledger"
	reward_table.4DC1ECC17CE017CF.title: "Hunter's Spoils"
	reward_table.4F9688C9FFA4610A.title: "Delver's Cache"
	reward_table.51CF557B28B33366.title: "Sovereign's Tribute"
	reward_table.5B001607D42FDE8B.title: "Treasures of the Deep"
	reward_table.656B4EB5E7614323.title: "Archive Cache"
	reward_table.68BF3E5EF6F9206A.title: "Ashborn Provisions"
	reward_table.68FCF79BD55FC1C8.title: "Major Bounty"
	reward_table.7020B79AE39F7342.title: "The Company's Purse"
	reward_table.705DD7459BB8F681.title: "Minor Bounty"
	reward_table.767EFA67B186A1CB.title: "Spoils of the Red Moon"
	reward_table.7D012DF38E9015AD.title: "The Smith's Crate"
	task.000690800B16E429.title: "Walk into a mineshaft"
	task.0117CCF75F60AD7E.title: "Find an abandoned chapel"
	task.01B4C7B15B5C80F1.title: "Find a dungeon"
