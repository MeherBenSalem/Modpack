{
	chapter.3CFC5F2EB26BB279.chapter_subtitle: ["The red moon rises. The Remnants hunt you back. Levels 15–30."]
	chapter.3CFC5F2EB26BB279.title: "&6Act II: &fThe Hunt"
	quest.037DDC36DF427850.quest_desc: [
		"By now your attributes are telling you who you are:"
		"&6Strength&r and &6Dexterity&r for steel, &bIntelligence&r for staves, &eFaith&r for sacred seals, &5Arcane&r for the strange things."
		""
		"Open the &6Remnant Constellation&r (&eP&r) and take your first ability; cast it with &eZ&r. Its &bEssence&r refills on its own."
		""
		"&7The Paths of the Ashborn chapters go deeper into each one."
	]
	quest.037DDC36DF427850.quest_subtitle: "Blade, sorcery or faith. Or all three, badly."
	quest.037DDC36DF427850.title: "Choose a Path"
	quest.190E84DFB94144CA.quest_desc: [
		"Craft his &6Sigil&r and call him somewhere wide. He swings like a man with nothing to lose, because he hasn't."
		""
		"His grafted arm has the reach of a spear. Don't trade blows; roll &oforward&r into his swing and punish the recovery."
	]
	quest.190E84DFB94144CA.quest_subtitle: "Sovereign of the Hollow Vale. Level 20."
	quest.190E84DFB94144CA.title: "&6Sovereign: Varghast the Grafted"
	quest.1B71C09161A6DDFB.quest_desc: [
		"Some full moons rise &cred&r. On those nights a toll sounds, every monster gains &c+5 levels&r, ranks come twice as often and Remnant Shards drop twice as thick."
		""
		"Survive one. Better: hunt through one."
		""
		"&o\"The Dusk Rider was only the first. The dark noticed you, Ashborn. Now it sends its hunters.\"&r"
		""
		"&7Type /remnants moon to check tonight's moon."
	]
	quest.1B71C09161A6DDFB.quest_subtitle: "Monsters grow stronger until dawn."
	quest.1B71C09161A6DDFB.title: "&cUnder the Hunter's Moon"
	quest.244492C516FAF63B.quest_desc: [
		"A monster whose level burns &cred&r against yours pays half again as much Valor. Pick a fight you shouldn't win, and win it."
	]
	quest.244492C516FAF63B.quest_subtitle: "Kill something above your level."
	quest.244492C516FAF63B.title: "Punching Up"
	quest.28475B28C255FDD9.quest_desc: [
		"A hulking frost beast sleeps in the snow. It breathes ice and leaps like a falling glacier. It guards an &bIce Crystal&r that freezes everything around its bearer."
	]
	quest.28475B28C255FDD9.quest_subtitle: "Snowy peaks. Something big sleeps there."
	quest.28475B28C255FDD9.title: "The Frostmaw"
	quest.289D0416C0109482.quest_desc: [
		"Every Sovereign but the Dusk Rider leaves a &6Crown Shard&r: a fragment of the Sun-Crown with a lasting boon. Equip one at a shrine."
	]
	quest.289D0416C0109482.quest_subtitle: "Wear a piece of the broken sun."
	quest.289D0416C0109482.title: "The Crown Remade"
	quest.337E61B442FEAD4C.quest_desc: ["Fifty levels of light. You are no longer the weakest thing in the ash."]
	quest.337E61B442FEAD4C.quest_subtitle: "Rune level 50."
	quest.337E61B442FEAD4C.title: "Runebearer"
	quest.3463E48C851C4E39.quest_desc: [
		"Under the plains lie the &6Forgotten Catacombs&r, the first of the &6Labyrinths&r: prisons the Sovereigns dug for things they couldn't kill. A Bone Warden keeps its heart."
		""
		"Find the Catacombs and break their warden."
	]
	quest.3463E48C851C4E39.quest_subtitle: "The Sovereigns built prisons under the world."
	quest.3463E48C851C4E39.title: "Into Every Maze"
	quest.463F4A4D56B7E057.quest_desc: [
		"&6Varghast the Grafted&r, Sovereign of the Hollow Vale, sewed other men's arms to his own until there was nothing left of him but grip. His token is a block of &firon&r."
	]
	quest.463F4A4D56B7E057.quest_subtitle: "Six Fragments and an iron block."
	quest.463F4A4D56B7E057.title: "The Grafted King"
	quest.53F967EF1BEA3D24.quest_desc: [
		"Call her in the snow, where she feels at home. She fights from range and freezes what she can't reach."
		""
		"&cFrostbite&r builds with every hit. Let it fill and it bursts for a chunk of your health. Close the distance, use cover against her blizzards, and keep a flask for the burst."
		""
		"&o\"Two Sovereigns. Two embers. You're making the dark nervous.\"&r"
	]
	quest.53F967EF1BEA3D24.quest_subtitle: "Sovereign of the Rime Veil. Level 25."
	quest.53F967EF1BEA3D24.title: "&6Sovereign: Sylvara, Frost Matron"
	quest.5C77FA2F283917EA.quest_desc: [
		"A &6Brand of Challenge&r gives a monster one more rank and five more levels, and doubles everything it pays. Brand something and kill it."
	]
	quest.5C77FA2F283917EA.quest_subtitle: "Make it worse on purpose."
	quest.5C77FA2F283917EA.title: "Accept the Challenge"
	quest.6493FE1CBE6B9CD4.quest_desc: [
		"From level 30, the rarest rank rises: a &cRemnant&r. It has a name and a title, its horn carries for forty-eight blocks, it never despawns, and when it falls the whole world hears about it."
		""
		"&o\"That horn means one of them has your scent. Don't run. They're faster.\"&r"
	]
	quest.6493FE1CBE6B9CD4.quest_subtitle: "It has a name. It has a horn. It has killed people like you."
	quest.6493FE1CBE6B9CD4.title: "&cA Remnant's End"
	quest.6C617748F8950056.quest_desc: [
		"&6Sylvara, Frost Matron&r rules the Rime Veil: the frozen lands where the last warmth of the old sun was buried under snow. Her token is &bblue ice&r."
		""
		"Before you call her, learn the cold. In the frozen peaks a beast called the &6Frostmaw&r guards its ice crystal; under the ice, the &6Rimefrost Vaults&r hold a Frost Lich."
	]
	quest.6C617748F8950056.quest_subtitle: "Where the cold went to hide."
	quest.6C617748F8950056.title: "The Rime Veil"
	quest.6EC45FFDFEE6E919.quest_desc: [
		"A &5Champion&r has risen four times. It carries three traits and pays five times the experience of its kind."
		""
		"Read its traits before you swing. A &cVolatile&r one explodes when it dies; a &bBlinking&r one teleports behind you; a &6Packleader&r calls its pack at 60% health."
	]
	quest.6EC45FFDFEE6E919.quest_subtitle: "Purple crest. Three traits. Bad news."
	quest.6EC45FFDFEE6E919.title: "Champion's Crest"
	quest.72B530DE7D787BE9.quest_subtitle: "A labyrinth under the snow."
	quest.72B530DE7D787BE9.title: "The Rimefrost Vaults"
	quest.7471008BCC83F1C9.quest_desc: [
		"In the old forests stands the &6Arcane Spire&r, kept by an illusionist who has forgotten which of him is real. Climb it."
	]
	quest.7471008BCC83F1C9.quest_subtitle: "Tier II of the dungeon trail."
	quest.7471008BCC83F1C9.title: "The Arcane Spire"
	task.1FBC542EF4BDDEE3.title: "I took my first ability in the Constellation"
}
