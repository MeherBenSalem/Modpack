{
	chapter.50B167D1406FDCEA.chapter_subtitle: ["You rose from ash with nothing. Start there."]
	chapter.50B167D1406FDCEA.title: "&6Prologue: &fAshborn"
	quest.05EAAA5866A04A29.quest_desc: [
		"Some monsters rise more than once. Their crest shows how many times:"
		""
		"&7Common&r → &aVeteran&r → &9Elite&r → &5Champion&r → &cRemnant&r"
		""
		"Ranked monsters carry &etraits&r (Vampiric, Blinking, Packleader…) shown under their name. Every ranked kill drops a &6Remnant Shard&r; crush one in your hand to absorb its &6Valor&r."
		""
		"A &6Hunter's Lens&r reads a monster's threat before you commit. Take this one."
	]
	quest.05EAAA5866A04A29.quest_subtitle: "Veteran, Elite, Champion… Remnant."
	quest.05EAAA5866A04A29.title: "Know Thy Enemy"
	quest.19610B4F5D841A48.title: "Something Between You and Them"
	quest.1ABD147F1054853C.quest_subtitle: "Every Ashborn starts the same way."
	quest.1ABD147F1054853C.title: "Wood Before Iron"
	quest.20A88504DC6B5A17.quest_desc: [
		"Villages survived the Eclipse by staying small and staying lit. Find one with a bell."
		""
		"&o\"Bring me to a village, Ashborn. Fire wants company.\"&r"
	]
	quest.20A88504DC6B5A17.quest_subtitle: "Somewhere, someone kept a fire lit."
	quest.20A88504DC6B5A17.title: "Smoke on the Horizon"
	quest.282CFDC633090E33.quest_subtitle: "Take back what's yours."
	quest.282CFDC633090E33.title: "Not This Time"
	quest.299D979D228918F3.quest_desc: [
		"Torches keep the small things away. Beds skip the worst of it. Neither will save you from what comes on a &cred moon&r."
	]
	quest.299D979D228918F3.quest_subtitle: "Light holds the dark back. For now."
	quest.299D979D228918F3.title: "The First Night"
	quest.2A6B94BDD99CE7BC.quest_desc: [
		"Every swing and every dodge spends &astamina&r, the green bar. Swing while exhausted and your blows land at a fraction of their strength."
		""
		"Tap &eLeft Alt&r to &6roll&r: for a heartbeat nothing can touch you. Learn the timing on zombies. You'll need it on things that aren't zombies."
		""
		"&7Weapon arts (&eR&7) cost &bFP&7, the blue bar. Refill both at an Ember Shrine."
	]
	quest.2A6B94BDD99CE7BC.quest_subtitle: "Stamina, and the roll that saves you."
	quest.2A6B94BDD99CE7BC.title: "The Breath Between Blows"
	quest.3B2BC7E46FADA8F0.quest_desc: [
		"Every monster carries a &elevel&r over its head. Levels climb the further you go from where you woke, the deeper you dig and the longer the world has lived under the Eclipse."
		""
		"A &agreen&r level is safe. A &cred&r one will kill you. Start with green."
	]
	quest.3B2BC7E46FADA8F0.quest_subtitle: "They were people, once. Mostly."
	quest.3B2BC7E46FADA8F0.title: "First Blood"
	quest.4C67E689E70A462B.title: "Stone Teeth"
	quest.5E38C6BB4D9030A0.title: "Iron Will"
	quest.6D7FD40BC81A0E63.quest_desc: [
		"Your &6origin&r is the life you half-remember: Knight-Errant, Duelist, Astromancer, Penitent… or &7Ashborn&r, risen with nothing at all."
		""
		"It sets your starting attributes and armament. You can change your mind later with a &6Tear of Rebirth&r, so don't agonise. The dark won't wait."
	]
	quest.6D7FD40BC81A0E63.quest_subtitle: "Pick the life you half-remember."
	quest.6D7FD40BC81A0E63.title: "What You Were"
	quest.78696D547ABF637A.quest_desc: [
		"Kills give &6Valor&r. Valor gives &6RPG levels&r, and every level gives attribute points."
		""
		"Press &eK&r to open the &6Level Up&r screen: stage points, preview &7current → after&r, confirm."
	]
	quest.78696D547ABF637A.quest_subtitle: "Your first level."
	quest.78696D547ABF637A.title: "Taste of Valor"
	quest.79BAD0382EFA559F.quest_desc: [
		"&o\"Another one. Up you get. The ash doesn't keep its dead for long.\"&r"
		""
		"An age ago the sun was eaten. Everything that died in the dark came back wrong: &cRemnants&r, echoes that keep a name and a grudge."
		""
		"You are one of the &6Ashborn&r. You can't die for good, which is exactly why the dead are coming for you."
		""
		"Press &eI&r to open your &6Status&r and the &6Codex&r. Everything this world will try to kill you with is written there."
	]
	quest.79BAD0382EFA559F.quest_subtitle: "The sun was eaten an age ago."
	quest.79BAD0382EFA559F.title: "&6Rise, Ashborn"
	quest.7A936AC05E6E9BA9.quest_desc: [
		"&o\"Good. Now you know.\"&r"
		""
		"Here, the dead don't stay quiet. Where you fell, an &cEcho&r of you rises: a named Remnant that wears your face and guards the runes you lost."
		""
		"Kill your own Echo to take them back. Die again before you do, and both the Echo and your runes fade into the ash."
	]
	quest.7A936AC05E6E9BA9.quest_subtitle: "Not the last time."
	quest.7A936AC05E6E9BA9.title: "&4YOU DIED"
	quest.7BCC2DCBDC56577B.quest_desc: [
		"When anything dies, its light leaves as &6runes&r, and you can hold them. Runes buy levels, upgrades and wares."
		""
		"Here is the cruel part: when &oyou&r die, your runes stay where you fell."
	]
	quest.7BCC2DCBDC56577B.quest_subtitle: "The light that leaves the dead."
	quest.7BCC2DCBDC56577B.title: "Runes"
	task.05572FA508E0884E.title: "I rolled through an attack"
	task.1F33EE9902AD248C.title: "I understand what I stand to lose"
	task.60615542741752CD.title: "I chose an origin in the Status screen (I)"
	task.6E48F831AFB399AE.title: "I am awake"
}
