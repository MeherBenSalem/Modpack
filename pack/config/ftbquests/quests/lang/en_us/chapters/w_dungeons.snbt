	task.340075ED5EC05D6F.title: "The Sunken City"
	task.37CF6846E3762114.title: "The Ancient Factory"
	task.3C84671BFB2CF15C.title: "Enter a Cursed Keep"
	task.43B35B245455A762.title: "Enter all six Labyrinths"
	task.4BA6253DA0F9E1B0.title: "Find Keep Kayra"
	task.4BA76EA085869B92.title: "Enter an ocean monument"
	task.5247E840967F9A6C.title: "The Frosted Prison"
	task.5ABA04D279CEE84B.title: "Enter the Forgotten Catacombs"
	task.5B545F55ACC3AA06.title: "Enter a Nether fortress"
	task.5B7D9315BA4EBFB7.title: "Defeat the Tomb King"
	task.5C6C1A5D94A33020.title: "The Acropolis"
	task.6789946FC46526BD.title: "Slay the Pharaoh"
	task.78B656A2DA5D990B.title: "Find a Plague Asylum"
	task.7B21F28C73CF6C1C.title: "The Soul Forge"
	task.7C03B6A6DC7891D4.title: "Enter a Soulfire Crypt"
}
